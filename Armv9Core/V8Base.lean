  let walkparams ← (( do (AArch64_GetS1TTWParams regime ss (BitVec.replicateBits top_bit 64)) ) : SailM S1TTWParams )
  let bottom_PAC_bit ← do (pure (64 -i (BitVec.toNat (← (AArch64_PACEffectiveTxSZ regime walkparams)))))
  (pure bottom_PAC_bit)

