def ImpDefBool (x : String) : SailM Bool := do
  if ((x == "the PE resets into EL2 or EL3") : Bool)
  then (pure ((EL2 == (HighestEL ())) || (EL3 == (HighestEL ()))))
  else
    (do
      if ((x == "the PE resets into EL1") : Bool)
      then (pure (EL1 == (HighestEL ())))
      else
        (do
          if ((x == "the PE resets into EL2") : Bool)
          then (pure (EL2 == (HighestEL ())))
          else
            (do
              if ((x == "the PE resets into EL3") : Bool)
              then (pure (EL3 == (HighestEL ())))
              else
                (do
                  if ((x == "IMPLEMENTED_ITD") : Bool)
                  then (pure true)
                  else
                    (do
                      if ((x == "IMPLEMENTED_CP15BEN") : Bool)
                      then (pure true)
                      else
                        (do
                          if ((x == "in a system that supports only a single Security state") : Bool)
                          then (pure false)
                          else
                            (do
                              if ((x == "access is Secure, in a system that supports two Security states") : Bool)
                              then (pure false)
                              else
                                (do
                                  if ((x == "GICD_CTLR.DS==0, Secure access") : Bool)
                                  then (pure false)
                                  else
                                    (do
                                      if ((x == "Has FP16 extension") : Bool)
                                      then readReg FEAT_FP16_IMPLEMENTED
                                      else
                                        (do
                                          if ((x == "Edge-triggered SError") : Bool)
                                          then (pure false)
                                          else
                                            (do
                                              if ((x == "AMEVCNTR1[m] is fixed") : Bool)
                                              then (pure false)
                                              else
                                                (do
                                                  if ((x == "AMEVCNTR1_EL0[m] is fixed") : Bool)
                                                  then (pure false)
                                                  else
                                                    (do
                                                      if ((x == "Has LRCPC3 support") : Bool)
                                                      then (pure true)
                                                      else
