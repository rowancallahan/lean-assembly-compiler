def IsSecureBelowEL3 (_ : Unit) : SailM Bool := do
  if ((HaveEL EL3) : Bool)
  then (pure ((_get_SCRType_NS (← (SCR_GEN_read ()))) == 0#1))
  else
    (do
      if ((←((pure (HaveEL EL2)) <&&> (do
           (pure (! (← (HaveSecureEL2Ext ())))) <||> (do
             (pure (! (← (HaveAArch64 ())))))))) : Bool)
      then (pure false)
      else (__IMPDEF_boolean "Secure-only implementation"))

def ELUsingAArch32 (el : (BitVec 2)) : SailM Bool := do
  (ELStateUsingAArch32 el (← (IsSecureBelowEL3 ())))

