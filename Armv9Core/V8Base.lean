def PACInvSub (Tinput : (BitVec 64)) : SailM (BitVec 64) := do
  let Toutput ← (( do (undefined_bitvector 64) ) : SailM (BitVec 64) )
  let loop_i_lower := 0
  let loop_i_upper := 15
  let mut loop_vars := Toutput
  for i in [loop_i_lower:loop_i_upper:1]i do
    let Toutput := loop_vars
    loop_vars :=
      match ((Sail.BitVec.extractLsb Tinput ((4 *i i) +i 3) (4 *i i)) : BitVec 4) with
      | 0b0000 => (Sail.BitVec.updateSubrange Toutput ((4 *i i) +i 3) (4 *i i) 0b0101#4)
      | 0b0001 => (Sail.BitVec.updateSubrange Toutput ((4 *i i) +i 3) (4 *i i) 0b1110#4)
      | 0b0010 => (Sail.BitVec.updateSubrange Toutput ((4 *i i) +i 3) (4 *i i) 0b1101#4)
      | 0b0011 => (Sail.BitVec.updateSubrange Toutput ((4 *i i) +i 3) (4 *i i) 0b1000#4)
      | 0b0100 => (Sail.BitVec.updateSubrange Toutput ((4 *i i) +i 3) (4 *i i) 0b1010#4)
      | 0b0101 => (Sail.BitVec.updateSubrange Toutput ((4 *i i) +i 3) (4 *i i) 0b1011#4)
      | 0b0110 => (Sail.BitVec.updateSubrange Toutput ((4 *i i) +i 3) (4 *i i) 0b0001#4)
      | 0b0111 => (Sail.BitVec.updateSubrange Toutput ((4 *i i) +i 3) (4 *i i) 0b1001#4)
      | 0b1000 => (Sail.BitVec.updateSubrange Toutput ((4 *i i) +i 3) (4 *i i) 0b0010#4)
      | 0b1001 => (Sail.BitVec.updateSubrange Toutput ((4 *i i) +i 3) (4 *i i) 0b0110#4)
      | 0b1010 => (Sail.BitVec.updateSubrange Toutput ((4 *i i) +i 3) (4 *i i) 0b1111#4)
      | 0b1011 => (Sail.BitVec.updateSubrange Toutput ((4 *i i) +i 3) (4 *i i) 0b0000#4)
      | 0b1100 => (Sail.BitVec.updateSubrange Toutput ((4 *i i) +i 3) (4 *i i) 0b0100#4)
      | 0b1101 => (Sail.BitVec.updateSubrange Toutput ((4 *i i) +i 3) (4 *i i) 0b1100#4)
      | 0b1110 => (Sail.BitVec.updateSubrange Toutput ((4 *i i) +i 3) (4 *i i) 0b0111#4)
      | 0b1111 => (Sail.BitVec.updateSubrange Toutput ((4 *i i) +i 3) (4 *i i) 0b0011#4)
      | _ => Toutput
  (pure loop_vars)

/-- Type quantifiers: amount : Nat, 0 ≤ (4 - amount) ∧ (7 - amount) < 8 -/
def RotCell (incell_name : (BitVec 4)) (amount : Nat) : SailM (BitVec 4) := do
  let tmp ← (( do (undefined_bitvector 8) ) : SailM (BitVec 8) )
  let tmp : (BitVec 8) := (Sail.BitVec.updateSubrange tmp 7 0 ((Sail.BitVec.extractLsb incell_name 3 0) +++ (Sail.BitVec.extractLsb incell_name 3 0)))
  (pure (Sail.BitVec.extractLsb tmp (7 -i amount) (4 -i amount)))

def PACMult (Sinput : (BitVec 64)) : SailM (BitVec 64) := do
  let t0 ← (( do (undefined_bitvector 4) ) : SailM (BitVec 4) )
  let t1 ← (( do (undefined_bitvector 4) ) : SailM (BitVec 4) )
  let t2 ← (( do (undefined_bitvector 4) ) : SailM (BitVec 4) )
  let t3 ← (( do (undefined_bitvector 4) ) : SailM (BitVec 4) )
  let Soutput ← (( do (undefined_bitvector 64) ) : SailM (BitVec 64) )
  let (Soutput, t0, t1, t2, t3) ← (( do
    let loop_i_lower := 0
    let loop_i_upper := 3
    let mut loop_vars := (Soutput, t0, t1, t2, t3)
    for i in [loop_i_lower:loop_i_upper:1]i do
      let (Soutput, t0, t1, t2, t3) := loop_vars
      loop_vars ← do
        let t0 ← (pure (Sail.BitVec.updateSubrange t0 3 0 ((← (RotCell (Sail.BitVec.extractLsb Sinput ((4 *i (i +i 8)) +i 3) (4 *i (i +i 8))) 1)) ^^^ (← (RotCell (Sail.BitVec.extractLsb Sinput ((4 *i (i +i 4)) +i 3) (4 *i (i +i 4))) 2)))))
        let t0 ← (pure (Sail.BitVec.updateSubrange t0 3 0 ((Sail.BitVec.extractLsb t0 3 0) ^^^ (← (RotCell (Sail.BitVec.extractLsb Sinput ((4 *i i) +i 3) (4 *i i)) 1)))))
        let t1 ← (pure (Sail.BitVec.updateSubrange t1 3 0 ((← (RotCell (Sail.BitVec.extractLsb Sinput ((4 *i (i +i 12)) +i 3) (4 *i (i +i 12))) 1)) ^^^ (← (RotCell (Sail.BitVec.extractLsb Sinput ((4 *i (i +i 4)) +i 3) (4 *i (i +i 4))) 1)))))
        let t1 ← (pure (Sail.BitVec.updateSubrange t1 3 0 ((Sail.BitVec.extractLsb t1 3 0) ^^^ (← (RotCell (Sail.BitVec.extractLsb Sinput ((4 *i i) +i 3) (4 *i i)) 2)))))
        let t2 ← (pure (Sail.BitVec.updateSubrange t2 3 0 ((← (RotCell (Sail.BitVec.extractLsb Sinput ((4 *i (i +i 12)) +i 3) (4 *i (i +i 12))) 2)) ^^^ (← (RotCell (Sail.BitVec.extractLsb Sinput ((4 *i (i +i 8)) +i 3) (4 *i (i +i 8))) 1)))))
        let t2 ← (pure (Sail.BitVec.updateSubrange t2 3 0 ((Sail.BitVec.extractLsb t2 3 0) ^^^ (← (RotCell (Sail.BitVec.extractLsb Sinput ((4 *i i) +i 3) (4 *i i)) 1)))))
        let t3 ← (pure (Sail.BitVec.updateSubrange t3 3 0 ((← (RotCell (Sail.BitVec.extractLsb Sinput ((4 *i (i +i 12)) +i 3) (4 *i (i +i 12))) 1)) ^^^ (← (RotCell (Sail.BitVec.extractLsb Sinput ((4 *i (i +i 8)) +i 3) (4 *i (i +i 8))) 2)))))
        let t3 ← (pure (Sail.BitVec.updateSubrange t3 3 0 ((Sail.BitVec.extractLsb t3 3 0) ^^^ (← (RotCell (Sail.BitVec.extractLsb Sinput ((4 *i (i +i 4)) +i 3) (4 *i (i +i 4))) 1)))))
        let Soutput : (BitVec 64) := (Sail.BitVec.updateSubrange Soutput ((4 *i i) +i 3) (4 *i i) (Sail.BitVec.extractLsb t3 3 0))
        let Soutput : (BitVec 64) := (Sail.BitVec.updateSubrange Soutput ((4 *i (i +i 4)) +i 3) (4 *i (i +i 4)) (Sail.BitVec.extractLsb t2 3 0))
        let Soutput : (BitVec 64) := (Sail.BitVec.updateSubrange Soutput ((4 *i (i +i 8)) +i 3) (4 *i (i +i 8)) (Sail.BitVec.extractLsb t1 3 0))
        let Soutput : (BitVec 64) := (Sail.BitVec.updateSubrange Soutput ((4 *i (i +i 12)) +i 3) (4 *i (i +i 12)) (Sail.BitVec.extractLsb t0 3 0))
        (pure (Soutput, t0, t1, t2, t3))
    (pure loop_vars) ) : SailM ((BitVec 64) × (BitVec 4) × (BitVec 4) × (BitVec 4) × (BitVec 4)) )
  (pure Soutput)

