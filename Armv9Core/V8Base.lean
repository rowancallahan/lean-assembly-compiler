def GenMPAMatEL (acctype : AccessType) (el : (BitVec 2)) : SailM MPAMinfo := SailME.run do
  let mpamEL ← (( do (undefined_bitvector 2) ) : SailME MPAMinfo (BitVec 2) )
  let validEL_name : Bool := false
  let security ← (( do (SecurityStateAtEL el) ) : SailME MPAMinfo SecurityState )
  let InD : Bool := false
  let InSM : Bool := false
  let pspace : PARTIDspaceType := (PARTIDspaceFromSS security)
  if ((←((pure (BEq.beq pspace PIdSpace_NonSecure)) <&&> (do
       (pure (! (← (MPAMisEnabled ()))))))) : Bool)
  then (DefaultMPAMinfo pspace)
  else
    (do
      let (mpamEL, validEL_name) ← (( do
        if ((← (UsingAArch32 ())) : Bool)
        then
          (do
            let (tup__0, tup__1) ← do (ELFromM32 (← readReg PSTATE).M)
            let validEL_name : Bool := tup__0
            let mpamEL : (BitVec 2) := tup__1
            (pure (mpamEL, validEL_name)))
        else
          (let mpamEL : (BitVec 2) :=
            if ((BEq.beq acctype AccessType_NV2) : Bool)
            then EL2
            else el
          let validEL_name : Bool := true
          (pure (mpamEL, validEL_name))) ) : SailME MPAMinfo ((BitVec 2) × Bool) )
      let (InD, InSM) ← (( do
        match acctype with
        | .AccessType_IFETCH =>
          (let InD : Bool := true
          (pure (InD, InSM)))
        | .AccessType_IC =>
          (let InD : Bool := true
          (pure (InD, InSM)))
        | .AccessType_SME =>
          (do
            let InSM ← (__IMPDEF_boolean "Shared SMCU") <||> (do (__IMPDEF_boolean "MPAMSM_EL1 label precedence"))
            (pure (InD, InSM)))
        | .AccessType_ASIMD =>
          (do
            let InSM ← (HaveSME ()) <&&> (do (pure ((← readReg PSTATE).SM == 1#1))) <&&> (do (__IMPDEF_boolean "Shared SMCU") <||> (do (__IMPDEF_boolean "MPAMSM_EL1 label precedence")))
            (pure (InD, InSM)))
        | .AccessType_SVE =>
          (do
            let InSM ← (HaveSME ()) <&&> (do (pure ((← readReg PSTATE).SM == 1#1))) <&&> (do (__IMPDEF_boolean "Shared SMCU") <||> (do (__IMPDEF_boolean "MPAMSM_EL1 label precedence")))
            (pure (InD, InSM)))
        | _ =>
          (let InD : Bool := false
          (pure (InD, InSM))) ) : SailME MPAMinfo (Bool × Bool) )
      if ((! validEL_name) : Bool)
      then (DefaultMPAMinfo pspace)
      else
        (do
          let pspace ← (( do
            if ((←((HaveRME ()) <&&> (do
                 (pure ((_get_MPAMIDR_EL1_Type_HAS_ALTSP (← readReg MPAMIDR_EL1)) == 1#1))))) : Bool)
            then (do (AltPARTIDspace mpamEL security pspace))
            else (pure pspace) ) : SailME MPAMinfo PARTIDspaceType )
          let pspace ← (( do
            if ((←((HaveMPAMv0p1Ext ()) <&&> (do
                 (pure ((_get_MPAMIDR_EL1_Type_HAS_FORCE_NS (← readReg MPAMIDR_EL1)) == 1#1))))) : Bool)
            then
              (do
                if ((((_get_MPAM3_EL3_Type_FORCE_NS (← (MPAM3_EL3_read ()))) == 1#1) && (BEq.beq security SS_Secure)) : Bool)
                then (pure PIdSpace_NonSecure)
                else (pure pspace))
            else (pure pspace) ) : SailME MPAMinfo PARTIDspaceType )
          if ((←((HaveMPAMv0p1Ext ()) <||> (do
               (HaveMPAMv1p1Ext ())) <&&> (do
               (pure ((_get_MPAMIDR_EL1_Type_HAS_SDEFLT (← readReg MPAMIDR_EL1)) == 1#1))))) : Bool)
          then
            (do
              if ((((_get_MPAM3_EL3_Type_SDEFLT (← (MPAM3_EL3_read ()))) == 1#1) && (BEq.beq security SS_Secure)) : Bool)
              then SailME.throw (← (do (DefaultMPAMinfo pspace)))
              else (pure ()))
          else (pure ())
          if ((! (← (MPAMisEnabled ()))) : Bool)
          then (DefaultMPAMinfo pspace)
          else (genMPAM mpamEL InD InSM pspace)))

