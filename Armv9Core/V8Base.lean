def ELStateUsingAArch32K (el : (BitVec 2)) (secure : Bool) : SailM (Bool × Bool) := do
  if ((! (HaveAArch32EL el)) : Bool)
  then (pure (true, false))
  else
    (do
      if ((secure && (el == EL2)) : Bool)
      then (pure (true, false))
      else
        (do
          if ((! (← (HaveAArch64 ()))) : Bool)
          then (pure (true, true))
          else
            (do
              let aarch32 ← (( do (__UNKNOWN_boolean ()) ) : SailM Bool )
              let known : Bool := true
              let aarch32_below_el3 ← (( do (pure (HaveEL EL3)) <&&> (do (pure (! secure)) <||> (do (pure (! (← (HaveSecureEL2Ext ()))))) <||> (do (pure ((_get_SCR_EL3_Type_EEL2 (← readReg SCR_EL3)) == 0#1)))) <&&> (do (pure ((_get_SCR_EL3_Type_RW (← readReg SCR_EL3)) == 0#1))) ) : SailM Bool )
              let aarch32_at_el1 ← (( do (pure aarch32_below_el3) <||> (do (pure (HaveEL EL2)) <&&> (do (pure (! secure)) <||> (do (HaveSecureEL2Ext ()) <&&> (do (pure ((_get_SCR_EL3_Type_EEL2 (← readReg SCR_EL3)) == 1#1))))) <&&> (do (pure (! (←((HaveVirtHostExt ()) <&&> (do (pure (((_get_HCR_EL2_Type_E2H (← readReg HCR_EL2)) +++ (_get_HCR_EL2_Type_TGE (← readReg HCR_EL2))) == 0b11#2)))))))) <&&> (do (pure ((_get_HCR_EL2_Type_RW (← readReg HCR_EL2)) == 0#1)))) ) : SailM Bool )
              let (aarch32, known) ← (( do
                if (((el == EL0) && (! aarch32_at_el1)) : Bool)
                then
                  (do
                    let (aarch32, known) ← (( do
                      if (((← readReg PSTATE).EL == EL0) : Bool)
                      then
                        (do
                          let aarch32 ← (pure ((← readReg PSTATE).nRW == 1#1))
                          (pure (aarch32, known)))
                      else
                        (let known : Bool := false
                        (pure (aarch32, known))) ) : SailM (Bool × Bool) )
                    (pure (aarch32, known)))
                else
                  (let aarch32 : Bool := ((aarch32_below_el3 && (el != EL3)) || (aarch32_at_el1 && ((el == EL1) || (el == EL0))))
                  (pure (aarch32, known))) ) : SailM (Bool × Bool) )
              let aarch32 ← (( do
                if ((! known) : Bool)
                then (do (__UNKNOWN_boolean ()))
                else (pure aarch32) ) : SailM Bool )
              (pure (known, aarch32)))))

