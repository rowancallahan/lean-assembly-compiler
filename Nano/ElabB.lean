/-- the machine; see the file header -/
def lx (xs o : List UInt8) (m st sp d d0 w ty : UInt64) : List UInt8 :=
  match xs with
  | c :: n :: t => STEPN
  | [c] => STEPE
  | [] => if m == 0 then (if ty == 0 then [0] else ty.toUInt8 :: lx o o 1 0 0 0 0 0 ty) else []
termination_by (if m = 0 then o.length + 1 else 0) + xs.length
decreasing_by
  all_goals simp only [List.length_cons, List.length_nil]
  all_goals (repeat' split)
  all_goals first
    | omega
    | exact absurd ‹(1 : UInt64) = 0› (by decide)
    | exact absurd (beq_iff_eq.mp ‹(m == 0) = true›) ‹¬m = 0›

/-- stage 1 on the source bytes -/
def lexB (xs : List UInt8) : List UInt8 := lx xs xs 0 0 0 0 0 0 0

/-! ## The specification of stage 1 and the decoder of its bytes -/

/-- what stage 1 computes: `nanoElabT`'s lexer and type check -/
def lexT (xs : List UInt8) : Option (Bool × List Tok) :=
  match lex xs.length xs with
  | some ts => (uniTy none ts).map (·, ts)
  | none => none

/-- token bytes back to tokens (`wd`: the current word, reversed; `nm`: the current numeral) -/
def dec : List UInt8 → List UInt8 → Option UInt64 → Option (List Tok)
  | [], [], none => some []
  | [], _, _ => none
  | b :: r, _, some a =>
    if b == 6 then (dec r [] none).map (Tok.num a :: ·)
    else if 48 ≤ b && b ≤ 57 then dec r [] (some (a * 10 + (b - 48).toUInt64)) else none
  | b :: r, wd, none =>
    if isW b then dec r (b :: wd) none
    else if !wd.isEmpty then
      if b == 0 then (dec r [] none).map (Tok.id wd.reverse :: ·)
      else if b == 1 then (dec r [] none).map (Tok.kdef :: ·)
      else if b == 2 then (dec r [] none).map (Tok.klet :: ·)
      else if b == 3 then (dec r [] none).map (Tok.kty false :: ·)
      else if b == 4 then (dec r [] none).map (Tok.kty true :: ·)
      else none
    else if b == 5 then dec r [] (some 0)
    else if b == 40 then (dec r [] none).map (Tok.lp :: ·)
    else if b == 41 then (dec r [] none).map (Tok.rp :: ·)
    else if b == 42 then (dec r [] none).map (Tok.star :: ·)
    else if b == 43 then (dec r [] none).map (Tok.plus :: ·)
    else if b == 45 then (dec r [] none).map (Tok.minus :: ·)
    else if b == 58 then (dec r [] none).map (Tok.colon :: ·)
    else if b == 59 then (dec r [] none).map (Tok.semi :: ·)
    else if b == 61 then (dec r [] none).map (Tok.assign :: ·)
    else none

/-- stage 1's bytes back to `lexT`'s value -/
def decL : List UInt8 → Option (Bool × List Tok)
  | 1 :: r => (dec r [] none).map (false, ·)
  | 2 :: r => (dec r [] none).map (true, ·)
  | _ => none

/-- a canonical byte form of a token (for comparisons in tests) -/
def tokBytes : Tok → List UInt8
  | .kdef => [1] | .klet => [2] | .kty s => [3, if s then 1 else 0] | .id s => 4 :: s ++ [0]
  | .num n => [5, n.toUInt8, (n >>> 8).toUInt8, (n >>> 16).toUInt8, (n >>> 24).toUInt8, (n >>> 32).toUInt8,
      (n >>> 40).toUInt8, (n >>> 48).toUInt8, (n >>> 56).toUInt8]
  | .lp => [6] | .rp => [7] | .colon => [8] | .assign => [9] | .plus => [10] | .minus => [11] | .star => [12]
  | .semi => [13]

def lexBytes (r : Option (Bool × List Tok)) : List UInt8 :=
  match r with
  | none => [0]
  | some (s, ts) => (if s then 2 else 1) :: ts.flatMap tokBytes

end Nano.B
