import Nano.Elab
/- nanoElabB, stage 1 (`lexB`): the lexer of `nanoElab` (`adjOk`, `lex`, `uniTy`) as a byte-level state machine in the
front end's list style (one function, explicit recursion on a measure, UInt8/UInt64 scalars, every step consumes one
byte and looks at the next one).  Three passes over the input: mode `m = 5` checks `adjOk` (every adjacent pair),
`m = 0` validates and computes the program's type, `m = 1` emits; each later pass restarts on the bookmark view `o`.
Output (`decL` decodes it): `0` = rejected, else the type byte (1 UInt64, 2 Int64) and the tokens: `( ) * + - ; : :=`
as `40 41 42 43 45 59 58 61`; a word as its characters and a kind byte (0 name, 1 `def`, 2 `let`, 3 `UInt64`,
4 `Int64`); a numeral as 5, its digits, 6.
States `st`: 0 between tokens, 4 at column 0 (after a newline: only space, newline or the word `def` may follow),
1 in a word, 2 skip the `=` of `:=`.  `sp`: `lex`'s fuel exceeds the rest of the input (0 until the first token that
costs less fuel than bytes); with `sp = 0` a word that runs to the end of the input is split before its last
character, exactly as `lex xs.length xs` does.  In a word `d`/`w` include the current character, `d0` excludes it:
`d` = 2 all digits, 1 a lowercase letter then digits / `_`, 6 neither; `w` the word packed behind a sentinel byte 1
(`2^63` beyond 7 characters); `cz` = the word started at column 0.  `ty`: the type so far (0 none, 1 UInt64, 2 Int64).
The step macros are generated by `Testing/nano/gen_elabb.py` from `Testing/nano/elabb_{step,end}.tmpl`. -/
namespace Nano.B
open Nano

set_option hygiene false in
/-- the word automaton on a first character -/
macro "DSTART" ch:term : term => `(if 48 ≤ $ch && $ch ≤ 57 then (2 : UInt64) else if 97 ≤ $ch && $ch ≤ 122 then 1 else 6)
/-- the word automaton step from `dd` on `ch` -/
macro "DSTEP" dd:term "," ch:term : term => `(if $dd == 0 then (DSTART $ch)
  else if $dd == 2 then (if 48 ≤ $ch && $ch ≤ 57 then (2 : UInt64) else 6)
  else if $dd == 1 then (if (48 ≤ $ch && $ch ≤ 57) || $ch == 95 then (1 : UInt64) else 6) else 6)
set_option hygiene false in
/-- the automaton after the first two characters `c`, `n` of a word that starts with a letter or `_` -/
macro "DSTEPL" n:term : term =>
  `(if 97 ≤ c && c ≤ 122 then (if (48 ≤ $n && $n ≤ 57) || $n == 95 then (1 : UInt64) else 6) else 6)
macro "WSTEP" ww:term "," ch:term : term =>
  `(if $ww < 0x100000000000000 then ($ww <<< 8) ||| ($ch).toUInt64 else (0x8000000000000000 : UInt64))
/-- the kind of the word (`dd`, `ww`): 0 name, 1 `def`, 2 `let`, 3 `UInt64`, 4 `Int64`, 6 numeral, 9 rejected -/
macro "KIND" dd:term "," ww:term : term => `(if $ww == 0x1646566 then (1 : UInt64) else if $ww == 0x16c6574 then 2
  else if $ww == 0x155496e743634 then 3 else if $ww == 0x1496e743634 then 4
  else if $dd == 1 then 0 else if $dd == 2 then 6 else 9)
/-- the kind of a word that may start at column 0 (`cz = 1`: only `def`) -/
macro "KINDC" dd:term "," ww:term "," cz:term : term =>
  `(if $cz == 1 then (if $ww == 0x1646566 then (1 : UInt64) else 9) else (KIND $dd, $ww))
set_option hygiene false in
/-- the type after the word `ww` (9: a conflict) -/
macro "TYU" ww:term : term => `(if $ww == 0x155496e743634 then (if ty == 2 then (9 : UInt64) else 1)
  else if $ww == 0x1496e743634 then (if ty == 1 then (9 : UInt64) else 2) else ty)

def isL (c : UInt8) : Bool := (65 ≤ c && c ≤ 90) || (97 ≤ c && c ≤ 122) || c == 95
def isW (c : UInt8) : Bool := isL c || (48 ≤ c && c ≤ 57)

