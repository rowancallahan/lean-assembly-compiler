/-- the validator (see the file header) -/
def lv (xs o : List UInt8) (m : Nat) (st sp d d0 w ty cz : UInt64) : List UInt8 :=
  match xs with
  | c :: n :: t => if m == 1 then c :: lv (n :: t) o m st sp d d0 w ty cz else STEPNV
  | [c] => if m == 1 then [c] else if m == 5 || m == 0 then STEPEV else []
  | [] =>
    if m == 1 then []
    else if m == 5 then lv o o 0 0 0 0 0 0 0 0
    else if m == 0 then (if ty == 0 then [0] else ty.toUInt8 :: lv o o 1 0 0 0 0 0 ty 0) else []
termination_by (if m = 5 then 2 * o.length + 3 else if m = 0 then o.length + 1 else 0) + xs.length
decreasing_by
  all_goals simp only [List.length_cons, List.length_nil]
  all_goals (repeat' split)
  all_goals first | omega | (simp_all; omega) | simp_all

/-- the validator's run: `none` rejected, `some ty` accepted with type `ty` -/
def vres (xs o : List UInt8) (m st sp d d0 w ty cz : UInt64) : Option UInt64 :=
  match xs with
  | c :: n :: t => STEPNR
  | [c] => STEPER
  | [] => if m == 5 then vres o o 0 0 0 0 0 0 0 0 else (if ty == 0 then none else some ty)
termination_by (if m = 5 then 2 * o.length + 3 else if m = 0 then o.length + 1 else 0) + xs.length
decreasing_by
  all_goals simp only [List.length_cons, List.length_nil]
  all_goals (repeat' split)
  all_goals first
    | omega
    | exact absurd ‹(1 : UInt64) = 0› (by decide)
    | exact absurd ‹(0 : UInt64) = 5› (by decide)
    | exact absurd ‹(1 : UInt64) = 5› (by decide)
    | exact absurd (beq_iff_eq.mp ‹(m == 0) = true›) ‹¬m = 0›
    | exact absurd (beq_iff_eq.mp ‹(m == 5) = true›) ‹¬m = 5›

/-- the emitter (see the file header) -/
def le (xs o : List UInt8) (m : Nat) (st sp d d0 w ty cz : UInt64) : List UInt8 :=
  match xs with
  | c :: n :: t =>
    if m == 7 then (if c == 0 then [0] else c :: le (n :: t) (n :: t) 1 0 0 0 0 0 c.toUInt64 0) else STEPNE
  | [c] => if m == 7 then (if c == 0 then [0] else [c]) else STEPEE
  | [] => if m == 7 then [0] else []
termination_by (if m = 7 then xs.length + 1 else 0) + xs.length
decreasing_by
  all_goals simp only [List.length_cons, List.length_nil]
  all_goals (repeat' split)
  all_goals first | omega | (simp_all; omega) | simp_all

/-- stage 1a and stage 1b on bytes -/
def vB (xs : List UInt8) : List UInt8 := lv xs xs 5 0 0 0 0 0 0 0
def eB (xs : List UInt8) : List UInt8 := le xs xs 7 0 0 0 0 0 0 0

/-! ## The split is exact -/

