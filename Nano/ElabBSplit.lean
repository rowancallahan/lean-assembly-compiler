    lx xs o 0 st sp d d0 w ty cz = vo (fun ty => lx o o 1 0 0 0 0 0 ty 0) (vres xs o 0 st sp d d0 w ty cz)
  | c :: n :: t, st, sp, d, d0, w, ty, cz => by
    rw [lx_c2', vres_c2]
    simp only [show ((0 : UInt64) == 5) = false by decide, show ((0 : UInt64) == 0) = true by decide,
      Bool.false_eq_true, if_false, if_true, apply_ite (vo _), vo_none, lx_vres0 o (n :: t)]
  | [c], st, sp, d, d0, w, ty, cz => by
    rw [lx_c1', vres_c1]
    simp only [show ((0 : UInt64) == 5) = false by decide, show ((0 : UInt64) == 0) = true by decide,
      Bool.false_eq_true, if_false, if_true, apply_ite (vo _), vo_none, vo_some]
  | [], st, sp, d, d0, w, ty, cz => by
    rw [lx, vres]
    simp only [show ((0 : UInt64) == 5) = false by decide, show ((0 : UInt64) == 0) = true by decide,
      Bool.false_eq_true, if_false, if_true, apply_ite (vo _), vo_none, vo_some]

/-- passes 5 and 0 of `lx` -/
theorem lx_vres5 (o : List UInt8) : ∀ (xs : List UInt8) (st sp d d0 w ty cz : UInt64),
    lx xs o 5 st sp d d0 w ty cz = vo (fun ty => lx o o 1 0 0 0 0 0 ty 0) (vres xs o 5 st sp d d0 w ty cz)
  | c :: n :: t, st, sp, d, d0, w, ty, cz => by
    rw [lx_c2', vres_c2]
    simp only [show ((5 : UInt64) == 5) = true by decide, if_true, apply_ite (vo _), vo_none, lx_vres5 o (n :: t)]
  | [c], st, sp, d, d0, w, ty, cz => by
    rw [lx_c1', vres_c1]
    simp only [show ((5 : UInt64) == 5) = true by decide, if_true, lx_vres0]
  | [], st, sp, d, d0, w, ty, cz => by
    rw [lx, vres]
    simp only [show ((5 : UInt64) == 5) = true by decide, if_true, lx_vres0]

theorem lv_c2 (c n : UInt8) (t o : List UInt8) (m : Nat) (st sp d d0 w ty cz : UInt64) :
    lv (c :: n :: t) o m st sp d d0 w ty cz =
      if m == 1 then c :: lv (n :: t) o m st sp d d0 w ty cz else STEPNV := by rw [lv]
