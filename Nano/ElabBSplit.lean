      Bool.false_eq_true, if_false, if_true, lv_vres0]

/-- a type the validator may return: nonzero and one byte -/
def good (ty : UInt64) : Bool := (ty != 0) && (ty.toUInt8.toUInt64 == ty)

theorem inv_ite {c : Prop} [Decidable c] {a b : UInt64} (ha : a.toUInt8.toUInt64 = a) (hb : b.toUInt8.toUInt64 = b) :
    (if c then a else b).toUInt8.toUInt64 = (if c then a else b) := by split <;> assumption

theorem good_end (ty : UInt64) (h : ty.toUInt8.toUInt64 = ty) :
    (Option.all good (if ty == 0 then none else some ty)) = true := by
  by_cases h0 : ty = 0
  · subst h0; rfl
  · simp [good, h0, h]

theorem lit1 : (1 : UInt64).toUInt8.toUInt64 = 1 := rfl
theorem lit2 : (2 : UInt64).toUInt8.toUInt64 = 2 := rfl
theorem lit9 : (9 : UInt64).toUInt8.toUInt64 = 9 := rfl

theorem end_good (ty : UInt64) (h : ty.toUInt8.toUInt64 = ty) :
    (if (ty == 0) = true then true else Option.all good (some ty)) = true := by
  by_cases h0 : ty = 0
  · subst h0; rfl
  · simp [good, h0, h]

theorem vres0_good (o : List UInt8) : ∀ (xs : List UInt8) (st sp d d0 w ty cz : UInt64),
    ty.toUInt8.toUInt64 = ty → (vres xs o 0 st sp d d0 w ty cz).all good = true
  | c :: n :: t, st, sp, d, d0, w, ty, cz, h => by
    have ih := vres0_good o (n :: t)
    rw [vres_c2]
    simp only [show ((0 : UInt64) == 5) = false by decide, show ((0 : UInt64) == 0) = true by decide,
      Bool.false_eq_true, if_false, if_true, apply_ite (Option.all good), Option.all_none]
    simp (config := {maxSteps := 4000000}) (disch := repeat (first | assumption | exact lit1 | exact lit2 | exact lit9 | apply inv_ite)) only [ih, ite_self]
  | [c], st, sp, d, d0, w, ty, cz, h => by
    rw [vres_c1]
    simp only [show ((0 : UInt64) == 5) = false by decide, show ((0 : UInt64) == 0) = true by decide,
      Bool.false_eq_true, if_false, if_true, apply_ite (Option.all good), Option.all_none]
    simp (config := {maxSteps := 4000000}) (disch := repeat (first | assumption | exact lit1 | exact lit2 | exact lit9 | apply inv_ite)) only [end_good, ite_self]
  | [], st, sp, d, d0, w, ty, cz, h => by
    rw [vres]
    simp only [show ((0 : UInt64) == 5) = false by decide, Bool.false_eq_true, if_false]
    exact good_end ty h

theorem vres5_good (o : List UInt8) : ∀ (xs : List UInt8) (st sp d d0 w ty cz : UInt64),
    (vres xs o 5 st sp d d0 w ty cz).all good = true
  | c :: n :: t, st, sp, d, d0, w, ty, cz => by
    rw [vres_c2]
    simp only [show ((5 : UInt64) == 5) = true by decide, if_true, apply_ite (Option.all good), Option.all_none,
      vres5_good o (n :: t), ite_self]
  | [c], st, sp, d, d0, w, ty, cz => by
    rw [vres_c1]; simp only [show ((5 : UInt64) == 5) = true by decide, if_true]; exact vres0_good o o _ _ _ _ _ _ _ rfl
  | [], st, sp, d, d0, w, ty, cz => by
    rw [vres]; simp only [show ((5 : UInt64) == 5) = true by decide, if_true]; exact vres0_good o o _ _ _ _ _ _ _ rfl

theorem good_iff {ty : UInt64} (h : good ty = true) : ty.toUInt8 ≠ 0 ∧ ty.toUInt8.toUInt64 = ty := by
  simp only [good, Bool.and_eq_true, bne_iff_ne, ne_eq, beq_iff_eq] at h
  refine ⟨fun e => h.1 ?_, h.2⟩
  rw [← h.2, e]; rfl

/-- **the split lexer is the lexer**, on every input -/
theorem eB_vB (xs : List UInt8) : eB (vB xs) = lexB xs := by
  unfold eB vB lexB
  rw [lv_vres5, lx_vres5]
  have hg := vres5_good xs xs 0 0 0 0 0 0 0
  generalize vres xs xs 5 0 0 0 0 0 0 0 = r at hg ⊢
  cases r with
  | none => simp only [vo_none]; rw [le]; rfl
  | some ty =>
    obtain ⟨h0, h8⟩ := good_iff (by simpa using hg)
    simp only [vo_some]
    cases xs with
    | nil =>
      rw [le, lx]
      simp [h0]
    | cons n t =>
      rw [le_c2, if_pos (by decide), if_neg (by simpa using h0), le_lx, h8]

