/- `mexp` (Nano/Expand.lean) as a record-per-step machine `mx` (branch nano-closeA), so that the front end compiles
it with at most 4 stored bytes per step: state `k` (record number within the micro-op), `ph` (0: look up the record,
1: emit it), `c` (the record: bytes 0-3, bit 32: byte 3 is the micro-op's argument `x`, bit 33: byte 0 is `x`,
bit 34: last record of the micro-op).  The table (a decision tree on `m`, `k` in tail position) is generated by Testing/nano/gen_mx.py from `mexp`'s arms.
`mexp_eq_mx : mexp xs = mx xs 0 0 0`. -/
import Nano.Expand

namespace Nano.MX
open Nano

def mx (xs : List UInt8) (k ph c : UInt64) : List UInt8 :=
  match xs with
  | m :: x :: rest =>
    if ph == 0 then
      (if m < 6 then (if m == 0 then (if k == 0 then mx (m :: x :: rest) k 1 (0x3021F05 : UInt64) else if k == 1 then mx (m :: x :: rest) k 1 (0x31F1F01 : UInt64) else mx (m :: x :: rest) k 1 (0x4000A1C00 : UInt64)) else if m == 1 then (mx (m :: x :: rest) k 1 (0x4071C0504 : UInt64)) else if m == 2 then (if k == 0 then mx (m :: x :: rest) k 1 (0x8050501 : UInt64) else if k == 1 then mx (m :: x :: rest) k 1 (0x1001C0604 : UInt64) else mx (m :: x :: rest) k 1 (0x40605050E : UInt64)) else if m == 3 then (if k == 0 then mx (m :: x :: rest) k 1 (0xF81F1F00 : UInt64) else if k == 1 then mx (m :: x :: rest) k 1 (0xC1F0007 : UInt64) else if k == 2 then mx (m :: x :: rest) k 1 (0xFF000A00 : UInt64) else if k == 3 then mx (m :: x :: rest) k 1 (0x10030 : UInt64) else mx (m :: x :: rest) k 1 (0x4001F050B : UInt64)) else if m == 4 then (mx (m :: x :: rest) k 1 (0x4011C1C08 : UInt64)) else (mx (m :: x :: rest) k 1 (0x400000500 : UInt64))) else if m < 12 then (if m == 6 then (if k == 0 then mx (m :: x :: rest) k 1 (0x8050501 : UInt64) else mx (m :: x :: rest) k 1 (0x500050506 : UInt64)) else if m == 7 then (mx (m :: x :: rest) k 1 (0x5001F0503 : UInt64)) else if m == 8 then (if k == 0 then mx (m :: x :: rest) k 1 (0x1F0603 : UInt64) else if k == 1 then mx (m :: x :: rest) k 1 (0x11F0503 : UInt64) else if k == 2 then mx (m :: x :: rest) k 1 (0x11F1F08 : UInt64) else if k == 3 then mx (m :: x :: rest) k 1 (0x206050500 : UInt64) else mx (m :: x :: rest) k 1 (0x4001F050B : UInt64)) else if m == 9 then (if k == 0 then mx (m :: x :: rest) k 1 (0x1F0503 : UInt64) else if k == 1 then mx (m :: x :: rest) k 1 (0x1001F1F08 : UInt64) else mx (m :: x :: rest) k 1 (0x4001F050B : UInt64)) else if m == 10 then (mx (m :: x :: rest) k 1 (0x500050605 : UInt64)) else (mx (m :: x :: rest) k 1 (0x5000D0610 : UInt64))) else (mx (m :: x :: rest) k 1 (0x400010030 : UInt64)))
    else if (c >>> 34) &&& 1 == 1 || 6 ≤ k then
      (if (c >>> 33) &&& 1 == 1 then x else c.toUInt8) :: (c >>> 8).toUInt8 :: (c >>> 16).toUInt8 ::
        (if (c >>> 32) &&& 1 == 1 then x else (c >>> 24).toUInt8) :: mx rest 0 0 0
    else
      (if (c >>> 33) &&& 1 == 1 then x else c.toUInt8) :: (c >>> 8).toUInt8 :: (c >>> 16).toUInt8 ::
        (if (c >>> 32) &&& 1 == 1 then x else (c >>> 24).toUInt8) :: mx (m :: x :: rest) (k + 1) 0 0
  | _ => []
termination_by xs.length * 32 + (if ph = 0 then 1 else 0) + 2 * (15 - k.toNat)
decreasing_by
  all_goals simp only [List.length_cons]
  all_goals (repeat' split) <;> (try simp_all) <;> (try omega)
  all_goals (obtain ⟨-, hk⟩ := ‹_ ∧ _›; have := UInt64.lt_iff_toNat_lt.mp hk; simp at this; omega)

end Nano.MX

namespace Nano.MX
open Nano

theorem mx_c (m x : UInt8) (rest : List UInt8) (k ph c : UInt64) : mx (m :: x :: rest) k ph c =
    if ph == 0 then
      (if m < 6 then (if m == 0 then (if k == 0 then mx (m :: x :: rest) k 1 (0x3021F05 : UInt64) else if k == 1 then mx (m :: x :: rest) k 1 (0x31F1F01 : UInt64) else mx (m :: x :: rest) k 1 (0x4000A1C00 : UInt64)) else if m == 1 then (mx (m :: x :: rest) k 1 (0x4071C0504 : UInt64)) else if m == 2 then (if k == 0 then mx (m :: x :: rest) k 1 (0x8050501 : UInt64) else if k == 1 then mx (m :: x :: rest) k 1 (0x1001C0604 : UInt64) else mx (m :: x :: rest) k 1 (0x40605050E : UInt64)) else if m == 3 then (if k == 0 then mx (m :: x :: rest) k 1 (0xF81F1F00 : UInt64) else if k == 1 then mx (m :: x :: rest) k 1 (0xC1F0007 : UInt64) else if k == 2 then mx (m :: x :: rest) k 1 (0xFF000A00 : UInt64) else if k == 3 then mx (m :: x :: rest) k 1 (0x10030 : UInt64) else mx (m :: x :: rest) k 1 (0x4001F050B : UInt64)) else if m == 4 then (mx (m :: x :: rest) k 1 (0x4011C1C08 : UInt64)) else (mx (m :: x :: rest) k 1 (0x400000500 : UInt64))) else if m < 12 then (if m == 6 then (if k == 0 then mx (m :: x :: rest) k 1 (0x8050501 : UInt64) else mx (m :: x :: rest) k 1 (0x500050506 : UInt64)) else if m == 7 then (mx (m :: x :: rest) k 1 (0x5001F0503 : UInt64)) else if m == 8 then (if k == 0 then mx (m :: x :: rest) k 1 (0x1F0603 : UInt64) else if k == 1 then mx (m :: x :: rest) k 1 (0x11F0503 : UInt64) else if k == 2 then mx (m :: x :: rest) k 1 (0x11F1F08 : UInt64) else if k == 3 then mx (m :: x :: rest) k 1 (0x206050500 : UInt64) else mx (m :: x :: rest) k 1 (0x4001F050B : UInt64)) else if m == 9 then (if k == 0 then mx (m :: x :: rest) k 1 (0x1F0503 : UInt64) else if k == 1 then mx (m :: x :: rest) k 1 (0x1001F1F08 : UInt64) else mx (m :: x :: rest) k 1 (0x4001F050B : UInt64)) else if m == 10 then (mx (m :: x :: rest) k 1 (0x500050605 : UInt64)) else (mx (m :: x :: rest) k 1 (0x5000D0610 : UInt64))) else (mx (m :: x :: rest) k 1 (0x400010030 : UInt64)))
    else if (c >>> 34) &&& 1 == 1 || 6 ≤ k then
      (if (c >>> 33) &&& 1 == 1 then x else c.toUInt8) :: (c >>> 8).toUInt8 :: (c >>> 16).toUInt8 ::
        (if (c >>> 32) &&& 1 == 1 then x else (c >>> 24).toUInt8) :: mx rest 0 0 0
    else
      (if (c >>> 33) &&& 1 == 1 then x else c.toUInt8) :: (c >>> 8).toUInt8 :: (c >>> 16).toUInt8 ::
        (if (c >>> 32) &&& 1 == 1 then x else (c >>> 24).toUInt8) :: mx (m :: x :: rest) (k + 1) 0 0 := by
  rw [mx]

theorem mx_cons (m x : UInt8) (rest : List UInt8) : mx (m :: x :: rest) 0 0 0 = mexp [m, x] ++ mx rest 0 0 0 := by
  by_cases h0 : m = 0
  · subst h0; simp (config := {decide := true}) [mx_c, mexp]
  by_cases h1 : m = 1
  · subst h1; simp (config := {decide := true}) [mx_c, mexp]
  by_cases h2 : m = 2
  · subst h2; simp (config := {decide := true}) [mx_c, mexp]
  by_cases h3 : m = 3
  · subst h3; simp (config := {decide := true}) [mx_c, mexp]
  by_cases h4 : m = 4
  · subst h4; simp (config := {decide := true}) [mx_c, mexp]
  by_cases h5 : m = 5
  · subst h5; simp (config := {decide := true}) [mx_c, mexp]
  by_cases h6 : m = 6
  · subst h6; simp (config := {decide := true}) [mx_c, mexp]
  by_cases h7 : m = 7
  · subst h7; simp (config := {decide := true}) [mx_c, mexp]
  by_cases h8 : m = 8
  · subst h8; simp (config := {decide := true}) [mx_c, mexp]
  by_cases h9 : m = 9
  · subst h9; simp (config := {decide := true}) [mx_c, mexp]
  by_cases h10 : m = 10
  · subst h10; simp (config := {decide := true}) [mx_c, mexp]
  by_cases h11 : m = 11
  · subst h11; simp (config := {decide := true}) [mx_c, mexp]
  have t : ∀ k : UInt8, ¬ m = k → m.toNat ≠ k.toNat := fun k h e => h (UInt8.toNat_inj.mp e)
  have := t 0 h0; have := t 1 h1; have := t 2 h2; have := t 3 h3; have := t 4 h4; have := t 5 h5
  have := t 6 h6; have := t 7 h7; have := t 8 h8; have := t 9 h9; have := t 10 h10; have := t 11 h11
  simp only [UInt8.toNat_ofNat] at *
  have a6 : ¬ m < 6 := by rw [UInt8.lt_iff_toNat_lt]; simp; omega
  have a12 : ¬ m < 12 := by rw [UInt8.lt_iff_toNat_lt]; simp; omega
  simp (config := {decide := true}) [mx_c, mexp, h0, h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11, a6, a12]

set_option linter.unusedSimpArgs false in
theorem mexp_cons (m x : UInt8) (rest : List UInt8) : mexp (m :: x :: rest) = mexp [m, x] ++ mexp rest := by
  by_cases h0 : (m == 0) = true
  · simp only [mexp, h0, if_true, if_false, Bool.false_eq_true, List.cons_append, List.nil_append, List.append_nil]
  by_cases h1 : (m == 1) = true
  · simp only [mexp, h0, h1, if_true, if_false, Bool.false_eq_true, List.cons_append, List.nil_append, List.append_nil]
  by_cases h2 : (m == 2) = true
  · simp only [mexp, h0, h1, h2, if_true, if_false, Bool.false_eq_true, List.cons_append, List.nil_append, List.append_nil]
  by_cases h3 : (m == 3) = true
  · simp only [mexp, h0, h1, h2, h3, if_true, if_false, Bool.false_eq_true, List.cons_append, List.nil_append, List.append_nil]
  by_cases h4 : (m == 4) = true
  · simp only [mexp, h0, h1, h2, h3, h4, if_true, if_false, Bool.false_eq_true, List.cons_append, List.nil_append, List.append_nil]
  by_cases h5 : (m == 5) = true
  · simp only [mexp, h0, h1, h2, h3, h4, h5, if_true, if_false, Bool.false_eq_true, List.cons_append, List.nil_append, List.append_nil]
  by_cases h6 : (m == 6) = true
  · simp only [mexp, h0, h1, h2, h3, h4, h5, h6, if_true, if_false, Bool.false_eq_true, List.cons_append, List.nil_append, List.append_nil]
  by_cases h7 : (m == 7) = true
  · simp only [mexp, h0, h1, h2, h3, h4, h5, h6, h7, if_true, if_false, Bool.false_eq_true, List.cons_append, List.nil_append, List.append_nil]
  by_cases h8 : (m == 8) = true
  · simp only [mexp, h0, h1, h2, h3, h4, h5, h6, h7, h8, if_true, if_false, Bool.false_eq_true, List.cons_append, List.nil_append, List.append_nil]
  by_cases h9 : (m == 9) = true
  · simp only [mexp, h0, h1, h2, h3, h4, h5, h6, h7, h8, h9, if_true, if_false, Bool.false_eq_true, List.cons_append, List.nil_append, List.append_nil]
  by_cases h10 : (m == 10) = true
  · simp only [mexp, h0, h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, if_true, if_false, Bool.false_eq_true, List.cons_append, List.nil_append, List.append_nil]
  by_cases h11 : (m == 11) = true
  · simp only [mexp, h0, h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11, if_true, if_false, Bool.false_eq_true, List.cons_append, List.nil_append, List.append_nil]
  simp only [mexp, h0, h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11, if_true, if_false, Bool.false_eq_true, List.cons_append, List.nil_append, List.append_nil]

theorem mexp_eq_mx : ∀ xs : List UInt8, mexp xs = mx xs 0 0 0
  | m :: x :: rest => by rw [mexp_cons, mx_cons, mexp_eq_mx rest]
  | [] => by rw [mx]; rfl; simp
  | [_] => by rw [mx]; rfl; simp

end Nano.MX
