/- Nano/Expr/CExpr: eval_emit for C itself. `emitAll` succeeds on C's certified AST `Cert.PC.all` (kernel-checked;
`ExprC.ds` / `ExprC.natC` / `ExprC.st` are C's def headers, Nat slots and side flags, generated by
Testing/nano/expr/gen_cdata.lean; the theorem holds for any headers / Nat slots / flags with which emitAllL succeeds;
Nano/Expr/CNat.lean checks `ExprC.natC` = NumSpec's classes, so `oC` is also `emitAll`'s output). So every result of C's meaning is the meaning of C's
emitted Expr. With `self_meaning_C` / `self_correct_C` (Nano/Main/SelfC.lean) this is a statement about C's machine
code: see Nano/Expr/CExprTop.lean. -/
import Nano.Expr.Correct
import Nano.Expr.CData
import Nano.SelfHost.Cert.PC
set_option maxHeartbeats 0
namespace ExprSpec
open NanoMain ParSpec

theorem emitC_isSome : (emitAllL ExprC.ds 0 ExprC.natC Cert.PC.all ExprC.st).isSome = true := by decide +kernel

/-- C's emitted Exprs: (name, type, value) per def -/
def oC : List (String × X × X) := (emitAllL ExprC.ds 0 ExprC.natC Cert.PC.all ExprC.st).get emitC_isSome

theorem emitC : emitAllL ExprC.ds 0 ExprC.natC Cert.PC.all ExprC.st = some oC := by simp [oC]

theorem oC_nodup : (oC.map (·.1)).Nodup := by
  have : (oC.map (·.1)) = ExprC.ds.map (fun d => nameS d.name) := by decide +kernel
  rw [this]; decide +kernel

theorem mainC' : (ExprC.ds[Cert.PC.all.length - 1]?.map fun d => (d.name, d.params, d.res)) = some ([109], [.inp], .ls) := by
  decide +kernel

theorem mainC : ∃ dm, ExprC.ds[Cert.PC.all.length - 1]? = some dm ∧ dm.name = [109] ∧ dm.params = [.inp] ∧ dm.res = .ls := by
  have h := mainC'
  rcases hd : ExprC.ds[Cert.PC.all.length - 1]? with _ | dm <;> rw [hd] at h <;> simp at h
  exact ⟨dm, rfl, h.1, h.2.1, h.2.2⟩

/-- **C's meaning is the meaning of C's emitted Expr**: whenever C's meaning on `inp` has a result (`mC inp`, the
Lean function `C.m`), that result is the big-step meaning of the emitted Expr of `m` applied to `inp` -/
theorem C_expr (inp : List UInt8) (hin : inp.length < 2 ^ 64) (hs : Sem κC Cert.PC.all inp = .ok (mC inp)) :
    Ev (progOf oC) [.l inp] (.app (.c "m" []) (.bv 0)) (.l (mC inp)) := by
  obtain ⟨dm, hm, h1, h2, h3⟩ := mainC
  exact eval_emitL emitC oC_nodup hin hm h1 h2 h3 hs

end ExprSpec
