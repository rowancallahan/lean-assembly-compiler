def g (a b : UInt64) : UInt64 := a - b
def k : UInt64 := 7
def f (x y : UInt64) : UInt64 := if g (if x < y then x else y) 1 == 0 then k else g k x
def src : String := "def g (a b : UInt64) : UInt64 := a - b\ndef k : UInt64 := 7\ndef f (x y : UInt64) : UInt64 := if g (if x < y then x else y) 1 == 0 then k else g k x"
theorem bytes_eq : src.toUTF8.toList = src.toList.map (fun c => c.toNat.toUInt8) := by decide +kernel
theorem elabEq : nanoElab (src.toList.map (fun c => c.toNat.toUInt8)) = some (2, Nano.V2.E.ite (Nano.V2.Cmp.eq) (Nano.V2.E.call (Nano.V2.E.sub (Nano.V2.E.var 1) (Nano.V2.E.var 0)) (Nano.V2.E.acons (Nano.V2.E.ite (Nano.V2.Cmp.ltu) (Nano.V2.E.var 1) (Nano.V2.E.var 0) (Nano.V2.E.var 1) (Nano.V2.E.var 0)) (Nano.V2.E.acons (Nano.V2.E.num 1) (Nano.V2.E.anil)))) (Nano.V2.E.num 0) (Nano.V2.E.call (Nano.V2.E.num 7) (Nano.V2.E.anil)) (Nano.V2.E.call (Nano.V2.E.sub (Nano.V2.E.var 1) (Nano.V2.E.var 0)) (Nano.V2.E.acons (Nano.V2.E.call (Nano.V2.E.num 7) (Nano.V2.E.anil)) (Nano.V2.E.acons (Nano.V2.E.var 1) (Nano.V2.E.anil))))) := by decide +kernel
theorem agree : ∀ x0 x1 : UInt64, (nanoElab src.toUTF8.toList).bind (·.eval [x0, x1]) = some (f x0 x1) := by
  intro x0 x1; rw [bytes_eq, elabEq]
  simp [Prog.eval, den, denA, Cmp.test, u_inj, apply_ite Int64.toUInt64, g, k, f]
  all_goals repeat' (first | rfl | decide | (split <;> simp_all [u_inj]))
end P18

