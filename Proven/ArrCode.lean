/- Byte arrays: the source language (expressions over 8 variables, statements with byte loads and stores
into named blocks, `while` loops) and its RV64I code generator.  Proofs: `Proven/ArrExp.lean`,
`Proven/Arr.lean`; per-word lemmas for the new words: `Proven/ArrWords.lean` (generated by `gen_arr.py`).

Registers: variables `v0..v7` = `a0..a7` (`x10..x17`); expression temporaries `t0..t6` (`T 0 .. T 6`,
so expression depth < 7); a block's base address is held in a variable chosen by the caller (`bv`). -/
import Proven.Code

namespace Proven

/-! ## Expressions over 8 variables (same operators as `Exp`) -/

inductive AExp where
  | var (i : Fin 8)
  | const (c : BitVec 64)
  | bin (op : Op) (a b : AExp)
  /-- `ite c a b` is `a` if `c ≠ 0`, else `b` (both are evaluated) -/
  | ite (c a b : AExp)
  deriving Repr

abbrev AEnv := Fin 8 → BitVec 64

def AExp.denote (env : AEnv) : AExp → BitVec 64
  | .var i => env i
  | .const c => c
  | .bin op a b => op.eval (a.denote env) (b.denote env)
  | .ite c a b => if c.denote env = 0 then b.denote env else a.denote env

def AExp.depth : AExp → Nat
  | .var _ | .const _ => 0
  | .bin _ a b => max a.depth (b.depth + 1)
  | .ite c a b => max c.depth (max (a.depth + 1) (b.depth + 2))

/-- variable `i` lives in `a_i = x(10 + i)` -/
def A8 (i : Fin 8) : Fin 32 := ⟨10 + i.val, by omega⟩

def iVar8 (i : Fin 8) (k : Nat) : BitVec 32 := encR 0 0 (T k) 0 (A8 i)   -- add tk, x0, a_i
def iMv8 (v : Fin 8) : BitVec 32 := encR 0 0 (A8 v) 0 5                  -- add a_v, x0, t0
def iLbuT : BitVec 32 := 0x0002c283#32                                    -- lbu t0, 0(t0)
def iSbT : BitVec 32 := 0x00628023#32                                     -- sb t1, 0(t0)

/-- code leaving the value of `e` in `t_k` (as `gen`, with 8 variables) -/
def gen8 : AExp → Nat → List (BitVec 32)
  | .var i, k => [iVar8 i k]
  | .const c, k => genConst k c.toNat
  | .bin op a b, k => gen8 a k ++ gen8 b (k + 1) ++ opCode op k
  | .ite c a b, k => gen8 c k ++ gen8 a (k + 1) ++ gen8 b (k + 2) ++ selCode k

/-! ## Statements -/

/-- Block contents (block `b` = `heap[b]`). -/
abbrev Heap := List (List (BitVec 8))

structure AState where
  env : AEnv
  heap : Heap

def AEnv.set (σ : AEnv) (v : Fin 8) (x : BitVec 64) : AEnv := fun i => if i = v then x else σ i

inductive AStmt where
  | assign (v : Fin 8) (e : AExp)
  /-- `v := block b [i]` (zero-extended byte) -/
  | load (v : Fin 8) (b : Nat) (i : AExp)
  /-- `block b [i] := low byte of e` -/
  | store (b : Nat) (i e : AExp)
  | seq (p q : AStmt)
  /-- `while c ≠ 0 do body` -/
  | loop (c : AExp) (body : AStmt)

/-- big-step semantics; an out-of-bounds load or store has no derivation -/
inductive AExec : AStmt → AState → AState → Prop
  | assign {v e σ} : AExec (.assign v e) σ ⟨σ.env.set v (e.denote σ.env), σ.heap⟩
  | load {v b i σ} (hb : b < σ.heap.length) (hi : (i.denote σ.env).toNat < σ.heap[b].length) :
      AExec (.load v b i) σ ⟨σ.env.set v (σ.heap[b][(i.denote σ.env).toNat].setWidth 64), σ.heap⟩
  | store {b i e σ} (hb : b < σ.heap.length) (hi : (i.denote σ.env).toNat < σ.heap[b].length) :
      AExec (.store b i e) σ
        ⟨σ.env, σ.heap.set b (σ.heap[b].set (i.denote σ.env).toNat ((e.denote σ.env).setWidth 8))⟩
  | seq {p q σ σ₁ σ₂} : AExec p σ σ₁ → AExec q σ₁ σ₂ → AExec (.seq p q) σ σ₂
  | loopF {c b σ} : c.denote σ.env = 0 → AExec (.loop c b) σ σ
  | loopT {c b σ σ₁ σ₂} : c.denote σ.env ≠ 0 → AExec b σ σ₁ → AExec (.loop c b) σ₁ σ₂ →
      AExec (.loop c b) σ σ₂

/-! ## Compiler -/

/-- address of `block b [i]`: the base variable `bv[b]` plus `i` -/
def addrE (bv : List (Fin 8)) (b : Nat) (i : AExp) : AExp := .bin .add (.var (bv.getD b 0)) i

end Proven
