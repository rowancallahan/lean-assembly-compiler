/- Byte arrays with spill slots: the source language `BExp`/`BStmt` (variables `0..7` in registers
`a0..a7`, variables `8..8+N-1` in 8-byte stack slots) and its RV64I code generator.
Proofs: `Proven/Arr2Exp.lean`, `Proven/Arr2.lean`; per-word lemmas: `Proven/Arr2Words.lean`
(generated by `gen_arr2.py`).

Frame: the prologue computes `fp = alignDown(sp, 8) - 8 (N + 1)`, saves `gp` (`x3`) at `fp`, sets
`gp := fp` and zeroes the slots; slot `j` is the 8 bytes at `fp + 8 (j + 1)` (`ld t_k, 8(j+1)(gp)`,
`sd t0, 8(j+1)(gp)`); the epilogue restores `gp` (`ld gp, 0(gp)`) and returns.  At most `NS = 16` slots. -/
import Spec.ArrCode
import Riscv.Direct.Loop

namespace Proven

/-! ## Expressions over variables `Nat` (the same operators as `Exp`) -/

inductive BExp where
  | var (i : Nat)
  | const (c : BitVec 64)
  | bin (op : Op) (a b : BExp)
  /-- `ite c a b` is `a` if `c ≠ 0`, else `b` (both are evaluated) -/
  | ite (c a b : BExp)
  deriving Repr

abbrev BEnv := Nat → BitVec 64

def BExp.denote (env : BEnv) : BExp → BitVec 64
  | .var i => env i
  | .const c => c
  | .bin op a b => op.eval (a.denote env) (b.denote env)
  | .ite c a b => if c.denote env = 0 then b.denote env else a.denote env

def BExp.depth : BExp → Nat
  | .var _ | .const _ => 0
  | .bin _ a b => max a.depth (b.depth + 1)
  | .ite c a b => max c.depth (max (a.depth + 1) (b.depth + 2))

/-- every variable is `< m` -/
def BExp.vlt (m : Nat) : BExp → Prop
  | .var i => i < m
  | .const _ => True
  | .bin _ a b => a.vlt m ∧ b.vlt m
  | .ite c a b => c.vlt m ∧ a.vlt m ∧ b.vlt m

/-! ## Statements -/

structure BState where
  env : BEnv
  heap : Heap

def BEnv.set (σ : BEnv) (v : Nat) (x : BitVec 64) : BEnv := fun i => if i = v then x else σ i

inductive BStmt where
  | assign (v : Nat) (e : BExp)
  /-- `v := block b [i]` (zero-extended byte) -/
  | load (v : Nat) (b : Nat) (i : BExp)
  /-- `block b [i] := low byte of e` -/
  | store (b : Nat) (i e : BExp)
  | seq (p q : BStmt)
  /-- `while c ≠ 0 do body` -/
  | loop (c : BExp) (body : BStmt)

/-- big-step semantics; an out-of-bounds load or store has no derivation -/
inductive BExec : BStmt → BState → BState → Prop
  | assign {v e σ} : BExec (.assign v e) σ ⟨σ.env.set v (e.denote σ.env), σ.heap⟩
  | load {v b i σ} (hb : b < σ.heap.length) (hi : (i.denote σ.env).toNat < σ.heap[b].length) :
      BExec (.load v b i) σ ⟨σ.env.set v (σ.heap[b][(i.denote σ.env).toNat].setWidth 64), σ.heap⟩
  | store {b i e σ} (hb : b < σ.heap.length) (hi : (i.denote σ.env).toNat < σ.heap[b].length) :
      BExec (.store b i e) σ
        ⟨σ.env, σ.heap.set b (σ.heap[b].set (i.denote σ.env).toNat ((e.denote σ.env).setWidth 8))⟩
  | seq {p q σ σ₁ σ₂} : BExec p σ σ₁ → BExec q σ₁ σ₂ → BExec (.seq p q) σ σ₂
  | loopF {c b σ} : c.denote σ.env = 0 → BExec (.loop c b) σ σ
  | loopT {c b σ σ₁ σ₂} : c.denote σ.env ≠ 0 → BExec b σ σ₁ → BExec (.loop c b) σ₁ σ₂ →
      BExec (.loop c b) σ σ₂

/-! ## Words -/

/-- maximal number of spill slots -/
def NS : Nat := 16

/-- `ld t_k, 8(j+1)(gp)` -/
def iLdS (j k : Nat) : BitVec 32 :=
  BitVec.ofNat 32 ((8 * (j + 1)) <<< 20 ||| 3 <<< 15 ||| 3 <<< 12 ||| (T k).val <<< 7 ||| 0x03)
/-- `sd t0, 8(j+1)(gp)` -/
def iSdS (j : Nat) : BitVec 32 :=
  BitVec.ofNat 32 ((8 * (j + 1)) >>> 5 <<< 25 ||| 5 <<< 20 ||| 3 <<< 15 ||| 3 <<< 12 |||
    ((8 * (j + 1)) % 32) <<< 7 ||| 0x23)
def iSpT : BitVec 32 := encR 0 0 5 0 2      -- add t0, x0, sp
def iGpT : BitVec 32 := encR 0 0 3 0 5      -- add gp, x0, t0
def iSdGp : BitVec 32 := 0x0032b023#32      -- sd gp, 0(t0)
def iLdGp : BitVec 32 := 0x0001b183#32      -- ld gp, 0(gp)

/-- code leaving the value of `e` in `t_k` -/
def genB : BExp → Nat → List (BitVec 32)
  | .var i, k => if h : i < 8 then [iVar8 ⟨i, h⟩ k] else [iLdS (i - 8) k]
  | .const c, k => genConst k c.toNat
  | .bin op a b, k => genB a k ++ genB b (k + 1) ++ opCode op k
  | .ite c a b, k => genB c k ++ genB a (k + 1) ++ genB b (k + 2) ++ selCode k

/-- `v := t0` -/
def setV (v : Nat) : BitVec 32 := if h : v < 8 then iMv8 ⟨v, h⟩ else iSdS (v - 8)

/-- address of `block b [i]`: the base variable `bv[b]` plus `i` -/
def addrB (bv : List Nat) (b : Nat) (i : BExp) : BExp := .bin .add (.var (bv.getD b 0)) i

def compileB (bv : List Nat) : BStmt → List (BitVec 32)
  | .assign v e => genB e 0 ++ [setV v]
  | .load v b i => genB (addrB bv b i) 0 ++ [iLbuT, setV v]
  | .store b i e => genB (addrB bv b i) 0 ++ genB e 1 ++ [iSbT]
  | .seq p q => compileB bv p ++ compileB bv q
  | .loop c body => genB c 0 ++ [iBeqz ((compileB bv body).length + 2)] ++ compileB bv body ++
      [iJmp ((genB c 0).length + 1 + (compileB bv body).length)]

/-- prologue for `N` slots: `t0 := alignDown(sp) - 8(N+1)`, `sd gp, 0(t0)`, `gp := t0`, slots `:= 0` -/
def prologue (N : Nat) : List (BitVec 32) :=
  [iSpT] ++ genConst 1 3 ++ [iOp .lshr 0, iOp .shl 0] ++ genConst 1 (8 * (N + 1)) ++ [iOp .sub 0, iSdGp, iGpT] ++
    [iZero 0] ++ (List.range N).map iSdS

/-- the compiled function: prologue, body, restore `gp`, `ret` -/
def compileBF (N : Nat) (bv : List Nat) (p : BStmt) : List (BitVec 32) :=
  prologue N ++ compileB bv p ++ [iLdGp, iRet]

/-- expressions fit the 7 temporaries and use variables `< 8 + N`, base variables are never assigned,
blocks exist, loop bodies fit the `beq` range -/
def BStmt.wf (N : Nat) (bv : List Nat) : BStmt → Prop
  | .assign v e => e.depth < 7 ∧ e.vlt (8 + N) ∧ v < 8 + N ∧ v ∉ bv
  | .load v b i => i.depth < 6 ∧ i.vlt (8 + N) ∧ v < 8 + N ∧ v ∉ bv ∧ b < bv.length
  | .store b i e => i.depth < 6 ∧ e.depth < 6 ∧ i.vlt (8 + N) ∧ e.vlt (8 + N) ∧ b < bv.length
  | .seq p q => p.wf N bv ∧ q.wf N bv
  | .loop c body => c.depth < 7 ∧ c.vlt (8 + N) ∧ body.wf N bv ∧
      (genB c 0).length + (compileB bv body).length + 2 < 1024

/-! ## The old language embeds -/

def AExp.toB : AExp → BExp
  | .var i => .var i.val
  | .const c => .const c
  | .bin op a b => .bin op a.toB b.toB
  | .ite c a b => .ite c.toB a.toB b.toB

def AStmt.toB : AStmt → BStmt
  | .assign v e => .assign v.val e.toB
  | .load v b i => .load v.val b i.toB
  | .store b i e => .store b i.toB e.toB
  | .seq p q => .seq p.toB q.toB
  | .loop c b => .loop c.toB b.toB

/-- an old state, with the variables `≥ 8` taken from `ρ` -/
def AState.toB (σ : AState) (ρ : BEnv) : BState :=
  ⟨fun i => if h : i < 8 then σ.env ⟨i, h⟩ else ρ i, σ.heap⟩

theorem AExp.denote_toB (σ : AState) (ρ : BEnv) : ∀ e : AExp, e.toB.denote (σ.toB ρ).env = e.denote σ.env
  | .var i => by simp [AExp.toB, BExp.denote, AExp.denote, AState.toB, i.isLt]
  | .const c => rfl
  | .bin op a b => by simp only [AExp.toB, BExp.denote, AExp.denote, denote_toB σ ρ a, denote_toB σ ρ b]
  | .ite c a b => by
    simp only [AExp.toB, BExp.denote, AExp.denote, denote_toB σ ρ c, denote_toB σ ρ a, denote_toB σ ρ b]

theorem AState.toB_set (σ : AState) (ρ : BEnv) (v : Fin 8) (x : BitVec 64) (H : Heap) :
    (⟨(σ.toB ρ).env.set v.val x, H⟩ : BState) = AState.toB ⟨σ.env.set v x, H⟩ ρ := by
  simp only [AState.toB, BState.mk.injEq, and_true]
  funext i
  simp only [BEnv.set, AEnv.set]
  by_cases hi : i < 8
  · by_cases hv : i = v.val
    · subst hv; simp
    · have : (⟨i, hi⟩ : Fin 8) ≠ v := fun e => hv (by rw [← e])
      simp [hv, hi, this]
  · have : i ≠ v.val := fun e => hi (e ▸ v.isLt)
    simp [hi, this]

/-- **Embedding**: a run of an old program is a run of its translation (variables `≥ 8` untouched) -/
theorem AExec.toB {p : AStmt} {σ σ' : AState} (h : AExec p σ σ') (ρ : BEnv) :
    BExec p.toB (σ.toB ρ) (σ'.toB ρ) := by
  induction h with
  | assign => rw [← AState.toB_set]; simp only [AStmt.toB, ← AExp.denote_toB _ ρ]; exact .assign
  | @load v b i σ hb hi =>
    rw [← AState.toB_set]
    have := BExec.load (v := v.val) (i := i.toB) (σ := σ.toB ρ) hb (by rwa [AExp.denote_toB])
    simp only [AExp.denote_toB] at this; exact this
  | @store b i e σ hb hi =>
    have := BExec.store (e := e.toB) (i := i.toB) (σ := σ.toB ρ) hb (by rwa [AExp.denote_toB])
    simp only [AExp.denote_toB] at this; exact this
  | seq _ _ ih1 ih2 => exact .seq ih1 ih2
  | loopF hc => exact .loopF (by rwa [AExp.denote_toB])
  | loopT hc _ _ ih1 ih2 => exact .loopT (by rwa [AExp.denote_toB]) ih1 ih2

end Proven
