section
-- E1: module

-- E1: public import ConLeche.Cached.CheckerC

-- E1: @[expose] public section

/-!

One `CState` for the whole stream, the environment-dependent caches
flushed per declaration, declarations consumed as `Declaration` records
straight from the direct parse (`ConLeche/Frontend/ExportC.lean`, task

`checkDeclStepC` is the check of one record, every kind: the fold `checkDecls`
(`ConLeche/Cached/Decls.lean`) runs it at each position, and the binary's driver
(`ConLeche/Driver/*`) runs it as a job at a view of the stream's index and returns the fold's
environment together with the proof that `checkDecls` returns it.  It runs at `.verified` and at
`.trusted` alike (the trusted mode is the same fold at the other mode, and nothing else):
acceptance at `.verified` is covered by the main corollary `no_False_declaration`
(`ConLeche/MainTheorem.lean`, through `no_False_theorem_accepted` in
`ConLeche/Verify/Cached/StreamThm.lean`), and two modes that both accept end in the same
environment (`checkDecls_agree`, `ConLeche/Verify/Cached/DeclPushes.lean`).

The driver's parameter is the `CheckMode` itself (task #185): the knot it
enters (`inferI mode`, `defeqI mode`) and the block's stages all take the same
mode.
-/

namespace ConLeche.Cached

open ConLeche

/-! ## The parsed-declaration checker -/

variable (mode : CheckMode)

/-- Check a definition's value against its declared type, returning the
record to install, unpushed: the pinned `Nat`-operation arm of
`checkDeclC` certifies against an overlay before it pushes. -/
def checkDefnValCI (fe : FEnv) (cv : ConstantVal)
    (value : Expr) (hint : ReducibilityHint) : CheckCM ConstantInfo := do
  unless Expr.looseBVarsBounded 0 value do
    throw (.invalid s!"loose bound variable in value of {cv.name}")
  if value.hasFvar then
    throw (.invalid s!"unexpected free variable in value of {cv.name}")
  let jv := value
  unless Expr.allLevelParamsDefinedC cv.levelParams jv do
    throw (.invalid s!"undeclared universe parameter in value of {cv.name}")
  unless constsResolveFC fe jv do
    throw (unresolvedConstsErrorLC (strLitStoredF fe) s!"value of {cv.name}" jv)
  let jvt ← inferI mode fe false checkFuel false 0 jv
  unless ← defeqI mode fe false checkFuel 0 jvt cv.type do
    throw (.invalid s!"type mismatch in definition {cv.name}")
  pure (.defnInfo cv jv hint)

/-- Check a theorem's value against its declared type, returning the
record to install, unpushed: its statement alone, a theorem being opaque
to reduction. -/
def checkThmValCI (fe : FEnv) (cv : ConstantVal) (value : Expr) : CheckCM ConstantInfo := do
  let jsty ← inferI mode fe false checkFuel false 0 cv.type
  let u ← opSIxC mode fe 0 jsty
  unless (← liftFueled "level comparison" (Level.isEquiv u .zero)) do
    throw (.invalid s!"type of theorem {cv.name} is not a proposition")
  unless Expr.looseBVarsBounded 0 value do
    throw (.invalid s!"loose bound variable in value of {cv.name}")
  if value.hasFvar then
    throw (.invalid s!"unexpected free variable in value of {cv.name}")
  let jv := value
  unless Expr.allLevelParamsDefinedC cv.levelParams jv do
    throw (.invalid s!"undeclared universe parameter in value of {cv.name}")
  unless constsResolveFC fe jv do
    throw (unresolvedConstsErrorLC (strLitStoredF fe) s!"value of {cv.name}" jv)
  let jvt ← inferI mode fe false checkFuel false 0 jv
  unless ← defeqI mode fe false checkFuel 0 jvt cv.type do
    throw (.invalid s!"type mismatch in theorem {cv.name}")
  pure (.thmInfo cv)

/-- Check an opaque's value against its declared type, returning the
axiom record to install, unpushed (as `checkDefnValCI`). -/
def checkOpaqueValCI (fe : FEnv) (cv : ConstantVal)
    (value : Expr) : CheckCM ConstantInfo := do
  unless Expr.looseBVarsBounded 0 value do
    throw (.invalid s!"loose bound variable in value of {cv.name}")
  if value.hasFvar then
    throw (.invalid s!"unexpected free variable in value of {cv.name}")
  let jv := value
  unless Expr.allLevelParamsDefinedC cv.levelParams jv do
    throw (.invalid s!"undeclared universe parameter in value of {cv.name}")
  unless constsResolveFC fe jv do
    throw (unresolvedConstsErrorLC (strLitStoredF fe) s!"value of {cv.name}" jv)
  let jvt ← inferI mode fe false checkFuel false 0 jv
  unless ← defeqI mode fe false checkFuel 0 jvt cv.type do
    throw (.invalid s!"type mismatch in opaque {cv.name}")
  pure (.axiomInfo cv)

/-- `checkQuotRecord`'s cached twin. -/
def checkQuotRecordC (fe : FEnv) (k : QuotKind) (cv : ConstantVal) : CheckCM FEnv := do
  unless quotPinHit k cv do
    throw (.notImplemented (match k with
      | .sound => "quotient soundness axiom mismatch"
      | _ => "quotient declaration mismatch"))
  unless quotPredsOk fe.find? k do
    throw (.notImplemented "quotient declaration before what it needs")
  installBasisDeclF fe (quotAt k cv)

/-- **An inductive block's install** (`checkDeclKind`'s `.indDecl` arm's
twin).

* Task #228: the stream's DECLARED parameter count, checked before the
  dispatch.
* ONE ROUTE (task #210), dispatched by the RECOGNISER alone (task
  #219): a recognised block is the installer's, nested ones and the
  pinned basis blocks included; any other is rejected with the reason
  `readBlock` gives. -/
def checkIndDeclC (fe : FEnv) (block : List ConstantInfo) (nP : Nat) :
    CheckCM FEnv :=
  if indParamsOk nP block then
    match readBlock nP block with
    | .ok p => checkBlockKS mode fe block p
    | .error e => throw e
  else throw (.invalid "number of parameters mismatch")

/-! ## The `Nat.div`/`Nat.mod` pin check (task #497)

`checkDivModPinF`'s twin (and `checkReducePinF`'s).  The specification substitutes the pinned
operation's value into each certificate proof with the tree walk
`Expr.substConstAll` (written five times per certificate: four guards
and the inference), and guards the result with the structurally
memoised `constsResolveF`/`allLevelParamsDefined`.  Here each variant's
proofs are substituted ONCE, by the sharing-preserving `substConstAllC`,
and the substituted proofs feed both the guard and the check; the guards
are the cached tier's (`constsResolveFC`, `allLevelParamsDefinedC`).
The twins are monomorphic in `CheckCM` and call the cached core
(`inferI`, `defeqI` at `checkFuel`) directly; `checkDivModPinC_eq` and `checkReducePinC_eq`
(`ConLeche/Verify/Cached/PinsC.lean`) are their equations to the
specification at the shared operations (`sharedOpsC`). -/

/-- `divModCertGuardF` at a substituted proof `sp`. -/
def divModCertGuardC (fe : FEnv) (c : Name) (annVal : Expr)
    (hyps : List Expr) (eqE sp : Expr) : Bool :=
  sp.looseBVarsBounded 0 && !sp.hasFvar &&
  Expr.allLevelParamsDefinedC [] sp && constsResolveFC fe sp &&
  (hyps.map (Expr.substConst0 c annVal)).all (fun h => constsResolveFC fe h) &&
  constsResolveFC fe (Expr.substConst0 c annVal eqE)

/-- `divModPinGuardF` over the cached guards. -/
def divModPinGuardC (ps : NatOpPinSet) (fe : FEnv) (c : Name) : Bool :=
  (divModDeclPin ps c).looseBVarsBounded 0 && !(divModDeclPin ps c).hasFvar &&
  Expr.allLevelParamsDefinedC [] (divModDeclPin ps c) &&
  constsResolveFC fe (divModDeclPin ps c) &&
  (divModTypePins ps c).all fun p =>
    (fe.find? p.1).isSome && !(typePinStoredF fe p.1).hasFvar &&
    p.2.looseBVarsBounded 0 && !p.2.hasFvar && constsResolveFC fe p.2

/-- `checkTypePinsF` at the cached core. -/
def checkTypePinsC (fe : FEnv) : List (Name × Expr) → CheckCM Bool
  | [] => pure true
  | p :: rest => do
    if ← defeqI mode fe false checkFuel 0 (typePinStoredF fe p.1) p.2 then
      checkTypePinsC fe rest
    else pure false

/-- `checkDivModCertsF` at the substituted proofs, at the cached core. -/
def checkDivModCertsC (fe : FEnv) (c : Name) (annVal : Expr) :
    List (List Expr × Expr) → List Expr → CheckCM Bool
  | [], [] => pure true
  | (hyps, eqE) :: srest, sp :: prest => do
    if divModCertGuardC fe c annVal hyps eqE sp then
      let tp ← inferI mode fe false checkFuel false 4
        (divModCertApplied sp (hyps.map (Expr.substConst0 c annVal)))
      if ← defeqI mode fe false checkFuel 4 tp (Expr.substConst0 c annVal eqE) then
        checkDivModCertsC fe c annVal srest prest
      else pure false
    else pure false
  | _, _ => pure false

/-- `checkDivModPinAtF` at the substituted proofs `sps`, at the cached core. -/
def checkDivModPinAtC (fe : FEnv) (c : Name) (value' : Expr) (ps : NatOpPinSet)
    (sps : List Expr) : CheckCM Bool := do
  if ← checkTypePinsC mode fe (divModTypePins ps c) then
    if ← defeqI mode fe false checkFuel 0 value' (divModDeclPin ps c) then
      checkDivModCertsC mode fe c value' (divModCertStmts c) sps
    else pure false
  else pure false

/-- `checkDivModPinLoopF`: each variant's proofs substituted once. -/
def checkDivModPinLoopC (fe : FEnv) (c : Name) (value' : Expr) :
    List NatOpPinSet → List String → CheckCM Unit
  | [], tried =>
    throw (.notImplemented s!"unsupported Nat.div/mod spelling ({c}: no \
      pin variant matched — {String.intercalate "; " tried})")
  | ps :: rest, tried =>
    let sps := (divModCertProofs ps c).map (Expr.substConstAllC c value')
    if divModPinGuardC ps fe c &&
        ((divModCertStmts c).zip sps).all
          (fun p => divModCertGuardC fe c value' p.1.1 p.1.2 p.2) then do
      if ← checkDivModPinAtC mode fe c value' ps sps then pure ()
      else
        checkDivModPinLoopC fe c value' rest
          (tried ++ [divModAttemptReason ps])
    else
      checkDivModPinLoopC fe c value' rest
        (tried ++ [s!"{ps.toolchain}: pin or certificate ground constants \
          absent"])

/-- `checkDivModPinF`'s twin, at the cached core. -/
def checkDivModPinC (pins : List NatOpPinSet) (fe fe2 : FEnv) (c : Name) : CheckCM Unit := do
  if divModEnvGuardF fe2 c then
    match fe2.find? c with
    | some (.defnInfo _ value' _) =>
      checkDivModPinLoopC mode fe c value' pins []
    | _ => throw (.internal s!"Nat.div/mod operation not stored ({c})")
  else throw (.notImplemented
    s!"unsupported Nat.div/mod environment ({c})")

/-- `reducePinGuardF` over the cached guards. -/
def reducePinGuardC (fe : FEnv) (c : Name) : Bool :=
  (reduceDeclPin c).looseBVarsBounded 0 && !(reduceDeclPin c).hasFvar &&
  Expr.allLevelParamsDefinedC [] (reduceDeclPin c) &&
  constsResolveFC fe (reduceDeclPin c)

/-- `checkReducePinF`'s twin, at the cached core. -/
def checkReducePinC (fe fe2 : FEnv) (c : Name) (value : Expr) : CheckCM Unit := do
  if reduceStoredOkF fe2 c && reduceElemOkF fe c then
    if reducePinGuardC fe c then do
      let valA := value
      let pinA := (reduceDeclPin c)
      let okPin ← defeqI mode fe false checkFuel 0 valA pinA
      if okPin then do
        let x := reduceCertVar c
        let ok ← defeqI mode fe false checkFuel 1 (.app valA x) x
        if ok then pure ()
        else throw (.internal
          s!"pinned compiler-trust opaque is not the identity ({c})")
      else throw (.notImplemented
        s!"unsupported compiler-trust opaque spelling ({c})")
    else throw (.notImplemented
      s!"unsupported compiler-trust opaque spelling ({c}: pin ground constants absent)")
  else throw (.notImplemented
    s!"unsupported compiler-trust opaque declaration ({c})")

/-- **A declaration's own checks** (`checkDeclKind`'s twin), every kind (inductive blocks reuse
the `Expr`-level drivers).  `pins` is the `Nat.div`/`Nat.mod` pin-variant list the gate tries
(task #304), threaded from the fold.

**The pinned arms push last.**  A pinned `Nat`-operation definition and
a `reduce*` opaque are certified against the environment before the
push (`fe`) AND after it.  Holding both alive across a push would copy
the whole index, so the value check returns the record unpushed
(`checkDefnValCI`, `checkOpaqueValCI`), the "after" environment is an
overlay sharing `fe`'s index (`FEnv.overlay`, read-only; it answers
`find?` as the push would, `find?_overlay_push`), and the push comes
last, onto an index nothing else holds. -/
def checkDeclKindC (pins : List NatOpPinSet) (fe : FEnv) (pd : Declaration) :
    CheckCM FEnv :=
  match pd with
  | .defnDecl cv value hint => do
    checkConstantValC mode fe cv true
    let ci ← checkDefnValCI mode fe cv value hint
    if natOpNames.contains cv.name then
      let fe2 := fe.overlay [ci]
      unless natOpGuardF fe2 cv.name &&
          (natOpDeps cv.name).all (natOpStoredOkF fe2) do
        throw (.notImplemented
          s!"nonstandard structural Nat operation environment ({cv.name})")
      match fe2.find? cv.name with
      | some (.defnInfo _ value' _) =>
        let ok ← certifyNatEqs (sharedOpsC mode fe) fe.env
          ((natOpEquations 0 cv.name).map fun eq =>
            (Expr.substConst0 cv.name value' eq.1,
             Expr.substConst0 cv.name value' eq.2))
        unless ok do
          throw (.notImplemented
            s!"nonstandard structural Nat operation ({cv.name})")
      | _ => throw (.internal
          s!"structural Nat operation not stored ({cv.name})")
    if natDivModNames.contains cv.name then
      checkDivModPinC mode pins fe (fe.overlay [ci]) cv.name
    pure (fe.push ci)
  | .thmDecl cv value => do
    checkConstantValC mode fe cv
    let ci ← checkThmValCI mode fe cv value
    pure (fe.push ci)
  | .opaqueDecl cv value => do
    checkConstantValC mode fe cv
    let ci ← checkOpaqueValCI mode fe cv value
    if reduceOpNames.contains cv.name then
      checkReducePinC mode fe (fe.overlay [ci]) cv.name value
    pure (fe.push ci)
  | .axiomDecl cv =>
    if cv.name = quotSoundName then
      checkQuotRecordC fe .sound cv
    else do
      checkConstantValC mode fe cv
      if stdAxiomOkF fe cv then
        pure (fe.push (.axiomInfo cv))
      else if cv.name = trustCompilerName then
        if trustCompilerOkF fe cv then
          pure (fe.push (.axiomInfo cv))
        else throw (.notImplemented
          s!"unsupported Lean.trustCompiler shape ({cv.name})")
      else if cv.name = ofReduceNatName ∨ cv.name = ofReduceBoolName then
        if ofReduceAxOkF fe cv then
          pure (fe.push (.axiomInfo cv))
        else throw (.notImplemented
          s!"unsupported compiler-trust axiom environment ({cv.name})")
      else if cv.name = propextName ∨ cv.name = choiceName then
        throw (.notImplemented s!"standard axiom shape mismatch ({cv.name})")
      else if cv.name = sorryAxName then
        pure fe
      else
        throw (.notImplemented (nonStdAxiomMsg cv.name))
  | .indDecl block nP => checkIndDeclC mode fe block nP
  | .quotDecl k cv => checkQuotRecordC fe k cv

/-- **One declaration** (`checkDecl`'s twin): its own checks, then the reserved names'. -/
def checkDeclC (pins : List NatOpPinSet) (fe : FEnv) (pd : Declaration) :
    CheckCM FEnv := do
  let fe₂ ← checkDeclKindC mode pins fe pd
  unless basisNamesOk pd do
    throw (basisNamesError pd)
  pure fe₂

/-! ## Names and durations for the driver's messages -/

/-- Milliseconds as `s.d` seconds (`12345` ↦ `"12.3"`).  `Nat`
arithmetic — no `Float` formatting on a message path. -/
def msSecs (ms : Nat) : String := s!"{ms / 1000}.{(ms % 1000) / 100}"

/-- A parsed declaration's display label (`ConLeche.Driver.declCName`,
shared with the driver's progress callback so the two can never
drift). -/
def declCLabel : Declaration → String
  | .defnDecl cv _ _ => s!"def {cv.name}"
  | .thmDecl cv _ => s!"theorem {cv.name}"
  | .opaqueDecl cv _ => s!"opaque {cv.name}"
  | .axiomDecl cv => s!"axiom {cv.name}"
  | .indDecl b _ => s!"inductive {(b.head?.map (·.name)).getD .anonymous}"
  | .quotDecl _ cv => s!"quot {cv.name}"

/-- The check of one record: flush, then check. -/
def checkDeclStepC (pins : List NatOpPinSet) (fe : FEnv) (pd : Declaration) :
    CheckCM FEnv := do
  flushC
  checkDeclC mode pins fe pd

end ConLeche.Cached

end
-- ===== ConLeche.Cached.Decls (152 lines) =====
section
-- E1: module

-- E1: public import ConLeche.Cached.ParsedC

-- E1: @[expose] public section

/-!

`checkDecls mode pins maxNatSize ds` is the verified implementation: the pure fold the main theorem and
main corollary are stated about (`ConLeche/MainTheorem.lean`).  At each position it checks the
record (`checkDeclStepC`, from a fresh memo state: nothing but the index crosses from one record to
the next), and what the record adds to the index is a function of the record alone (`declConstants`,
`declTables`, `ConLeche/Kernel/Install.lean`; `checkDeclStepC_pushes`).

The binary's driver (`ConLeche/Driver/*`) builds the index of the whole stream first and runs the
checks in any order, each at the view of its position (`ConLeche/Cached/StreamIndex.lean`); that
every check passing is an accept of this fold is `checkDecls_of_jobs`
(`ConLeche/Verify/Cached/StreamIndex.lean`), so the driver's accept comes with the proof that
`checkDecls` accepts.

**The pin list is a parameter.**  `checkDecls`, `declStep` and below them `checkDeclStepC` and the
`Expr`-level `checkDecl` take the list of `Nat.div`/`Nat.mod` pin variants the gate tries, as their
second argument, right after `mode`.  The shipped checker runs at `natOpPinSets`, the variants this
toolchain committed; the main theorem and the main corollary are stated for every list, because
nothing the model tier consumes reads which list the matched variant came from.

**So is the maximum `Nat` size.**  `maxNatSize`, right after the pin list, is the largest `Nat` numeral
in bytes the core takes in or computes (`natOpRefusal`, `ConLeche/Cached/StateC.lean`); each
record's fresh memo state carries it (`CState.maxNatSize`).  The shipped checker runs at
`maxNatSizeDefault` unless `--max-nat-size` says otherwise; the theorems hold at every `maxNatSize`,
because a refusal only ever throws.

Nothing here is `IO`.  A rejection carries the fold position of the declaration it names, so the
driver reports the declaration by indexing the record array it already holds.
-/

namespace ConLeche.Cached

open ConLeche

variable (mode : CheckMode)

/-- **One record of the fold**: the `And` pin, then the record's check from a fresh memo state.
The accumulator is the position and the index; a failure is tagged with the position.

The pin comes first (`andPinOk`, `ConLeche/Kernel/Basis.lean`): a record that declares `And`,
`And.intro` or `And.rec` and is not the toolchain's `And` block is rejected whatever its kind, so
the name `And` in an accepted environment is the pinned block, and the stuck-proof rescue that
serves it (`majorToCtor`'s `And` branch) is always available.  The soundness proofs never read it
(the rescue is sound for any `And`), so `checkDecl` does not repeat it. -/
def declStep (pins : List NatOpPinSet) (maxNatSize : Nat) (p : Nat × FEnv) (pd : Declaration) :
    Except (CheckError × Nat) (Nat × FEnv) :=
  if andPinOk pd then
    match checkDeclStepC mode pins p.2 pd { maxNatSize := maxNatSize } with
    | .ok (fe', _) => .ok (p.1 + 1, fe')
    | .error e => .error (e, p.1)
  else .error (.invalid "`And` must be the standard `And`", p.1)

/-- An accepting run of the fold: a chain of accepting `declStep`s. -/
inductive DeclsRun (pins : List NatOpPinSet) (maxNatSize : Nat) :
    List Declaration → Nat × FEnv → Nat × FEnv → Prop where
  | nil (p : Nat × FEnv) : DeclsRun pins maxNatSize [] p p
  | cons {pd : Declaration} {ds : List Declaration} {p p₁ p' : Nat × FEnv}
      (h : declStep mode pins maxNatSize p pd = .ok p₁) (rest : DeclsRun pins maxNatSize ds p₁ p') :
      DeclsRun pins maxNatSize (pd :: ds) p p'

/-- The accepting step's result, unfolded. -/
theorem declStep_ok {mode : CheckMode} {pins : List NatOpPinSet} {maxNatSize : Nat} {p q : Nat × FEnv}
    {pd : Declaration} (h : declStep mode pins maxNatSize p pd = .ok q) :
    ∃ fe' s', q = (p.1 + 1, fe') ∧ checkDeclStepC mode pins p.2 pd { maxNatSize := maxNatSize } = .ok (fe', s') := by
  unfold declStep at h
  split at h
  case isFalse => exact nomatch h
  cases hs : checkDeclStepC mode pins p.2 pd { maxNatSize := maxNatSize } with
  | error e => rw [hs] at h; exact nomatch h
  | ok r =>
    obtain ⟨fe', s₁⟩ := r
    rw [hs] at h
    simp only [Except.ok.injEq] at h
    exact ⟨fe', s₁, h.symm, rfl⟩

/-- **The declaration fold.**

The records are the array the frontend produces (`Frontend.preparePrelude`); the proofs read the
fold as `ds.toList.foldlM` (`Array.foldlM_toList`), which is where `DeclsRun` lives.  The `× Nat` of
the error is the failure's position: here the record's position in the fold, in the frontend's half
of the same error type the input's line number (`ConLeche/Frontend/Export.lean`). -/
def checkDecls (mode : CheckMode) (pins : List NatOpPinSet) (maxNatSize : Nat) (ds : Array Declaration) :
    Except (CheckError × Nat) Env := do
  let p ← ds.foldlM (declStep mode pins maxNatSize) (0, mkFEnv Env.empty)
  pure p.2.env

/-- An accepting run is an accepting `foldlM`. -/
theorem DeclsRun.foldlM {pins : List NatOpPinSet} {maxNatSize : Nat} {ds : List Declaration} {p p' : Nat × FEnv}
    (h : DeclsRun mode pins maxNatSize ds p p') : ds.foldlM (declStep mode pins maxNatSize) p = .ok p' := by
  induction h with
  | nil p => rfl
  | cons hstep _ ih =>
    rw [List.foldlM_cons]
    simp only [Bind.bind, hstep, Except.bind]
    exact ih

/-- An accepting `foldlM` is an accepting run. -/
theorem DeclsRun.of_foldlM {pins : List NatOpPinSet} {maxNatSize : Nat} :
    ∀ (ds : List Declaration) (p : Nat × FEnv) {p' : Nat × FEnv},
      ds.foldlM (declStep mode pins maxNatSize) p = .ok p' → DeclsRun mode pins maxNatSize ds p p'
  | [], p, p', h => by
    simp only [List.foldlM_nil, pure, Except.pure, Except.ok.injEq] at h
    subst h
    exact .nil p
  | pd :: ds, p, p', h => by
    rw [List.foldlM_cons] at h
    simp only [Bind.bind] at h
    cases hstep : declStep mode pins maxNatSize p pd with
    | error e => simp only [hstep, Except.bind] at h; exact nomatch h
    | ok p₁ =>
      simp only [hstep, Except.bind] at h
      exact .cons hstep (DeclsRun.of_foldlM ds p₁ h)

/-- A run extends at its end by one accepting step. -/
theorem DeclsRun.snoc {pins : List NatOpPinSet} {maxNatSize : Nat} {ds : List Declaration} {p p' p₁ : Nat × FEnv}
    (h : DeclsRun mode pins maxNatSize ds p p') {pd : Declaration} (hstep : declStep mode pins maxNatSize p' pd = .ok p₁) :
    DeclsRun mode pins maxNatSize (ds ++ [pd]) p p₁ := by
  induction h with
  | nil p => exact .cons hstep (.nil _)
  | cons h₀ _ ih => exact .cons h₀ (ih hstep)

/-- **Every accept of the fold is an accepting run from the empty index.** -/
theorem checkDecls_run {pins : List NatOpPinSet} {maxNatSize : Nat} {ds : Array Declaration} {env : Env}
    (h : checkDecls mode pins maxNatSize ds = .ok env) :
    ∃ n fe, DeclsRun mode pins maxNatSize ds.toList (0, mkFEnv Env.empty) (n, fe) ∧ fe.env = env := by
  unfold checkDecls at h
  rw [← Array.foldlM_toList] at h
  cases hrun : ds.toList.foldlM (declStep mode pins maxNatSize) (0, mkFEnv Env.empty) with
  | error e => rw [hrun] at h; exact nomatch h
  | ok r =>
    obtain ⟨n, fe⟩ := r
    rw [hrun] at h
    obtain rfl : fe.env = env := Except.ok.inj h
    exact ⟨n, fe, DeclsRun.of_foldlM mode ds.toList _ hrun, rfl⟩

/-- **An accepting run is an accept of the fold.** -/
theorem checkDecls_of_run {pins : List NatOpPinSet} {maxNatSize : Nat} {ds : Array Declaration} {n : Nat} {fe : FEnv}
    (h : DeclsRun mode pins maxNatSize ds.toList (0, mkFEnv Env.empty) (n, fe)) :
    checkDecls mode pins maxNatSize ds = .ok fe.env := by
  unfold checkDecls
  rw [← Array.foldlM_toList, h.foldlM]
  rfl

end ConLeche.Cached

end
