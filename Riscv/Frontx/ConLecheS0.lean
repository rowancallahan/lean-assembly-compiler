section
-- E1: module

-- E1: public import ConLeche.Cached.IndRec

-- E1: @[expose] public section

/-!

The production twins of the pass's stages (`checkBlockInds`,
`checkBlockCtors`, `ConLeche/Kernel/Inductives/BlockInstall.lean`,
`SumInstall.lean`, `StructInstall.lean`), with the pushes onto the index
their conses are (`consBlockIndsF`, `consSumCtorsF`, `consBlockCtorsF`), and of the classes
(`checkBlockClasses`, `GenRec.lean`, with `classRead`, `ClassRead.lean`,
and the major's resolution, `RecCheck.lean`): monomorphic `CheckCM`
definitions at a mode and an environment index, calling the cached core
(`inferI`, `defeqI`, … at `checkFuel`) directly and the cached walks of
`ConLeche/Cached/ExprOpsC.lean` (`openPisAtFvarsC`, `constsResolveFC`,
`getAppArgsC`, `instantiate1C`, `replaceFVarsC`, `nestOccC`,
`instPisWithC`) where the specification runs the plain ones, and the
constant check `checkConstantValC` (`IndPass.lean`).  Each mirrors its
specification at the shared operations, so the relation is an equation
(`checkBlockIndsC_eq`, `checkBlockCtorsC_eq`, `checkBlockClassesC_eq`,
`checkBlockIdxSortsC_eq`, `ConLeche/Verify/Cached/IndBlockC.lean`; a stage
that reads the environment, at the index `mkFEnv env` of the specification's
`env`); the cached drivers (`checkBlockPassS`, `checkBlockTailS`) run them.
-/

namespace ConLeche.Cached

open ConLeche

variable (mode : CheckMode)

/-! ## The pushes onto the index -/

/-- `consSumCtors` through the index. -/
def consSumCtorsF (nP : Nat) (T : Name) : List (ConstantVal × Nat) → FEnv → FEnv
  | [], fe => fe
  | c :: cs, fe => consSumCtorsF nP T cs (fe.push (.ctorInfo c.1 nP c.2 T))

/-- `consBlockInds` through the index. -/
def consBlockIndsF (p₁ : BlockShape) (isRec : Bool) :
    List ConstantVal → Nat → FEnv → FEnv
  | [], _, fe => fe
  | cvTa :: rest, i, fe =>
    consBlockIndsF p₁ isRec rest (i + 1) (fe.push (.indInfo cvTa (blockCapsAt p₁ i isRec)))

/-- `consBlockCtors` through the index. -/
def consBlockCtorsF (nP : Nat) : List (Name × List (ConstantVal × Nat)) → FEnv → FEnv
  | [], fe => fe
  | (T, ctorList) :: rest, fe => consBlockCtorsF nP rest (consSumCtorsF nP T ctorList fe)

/-! ## Stage 1: the formers -/

/-- The cached `checkBlockTele`. -/
def checkBlockTeleC (fe : FEnv) (nP : Nat) (ms : MemberShape) :
    CheckCM (ConstantVal × Level) := do
  checkConstantValC mode fe ms.cvT
  let (cvTa, s) ← checkSumTele (nP + ms.nIdx) ms.cvT
  let (_, tbody) ← unwrapOr (cvTa.type.stripPis (nP + ms.nIdx))
    (.internal "direct sum: type former telescope")
  unless tbody == Expr.sort s do
    throw (.internal "direct sum: type former result sort")
  pure (cvTa, s)

/-- The cached `checkBlockTeles`. -/
def checkBlockTelesC (fe : FEnv) (nP : Nat) :
    List MemberShape → CheckCM (List (ConstantVal × Level))
  | [] => pure []
  | ms :: rest => do
    let r ← checkBlockTeleC mode fe nP ms
    let rs ← checkBlockTelesC fe nP rest
    pure (r :: rs)

/-- The cached `checkBlockDomsAt`. -/
def checkBlockDomsAtC (fe : FEnv) (off : Nat) (fvs doms : List Expr) : Nat → CheckCM Unit
  | 0 => pure ()
  | j + 1 => do
    let a ← unwrapOr fvs[j]? (.internal "block: domain index")
    let b ← unwrapOr doms[j]? (.internal "block: domain index")
    unless ← defeqI mode fe false checkFuel (off + j) a.fvarTypeD b do
      throw (.invalid "parameters of all inductive datatypes must match")
    checkBlockDomsAtC fe off fvs doms j

/-- The cached `checkBlockAgree`: the telescopes opened by
`openPisAtFvarsC`. -/
def checkBlockAgreeC (fe : FEnv) (nP : Nat) (cvTa0 : ConstantVal) (s0 : Level) :
    List (ConstantVal × Level) → CheckCM Unit
  | [] => pure ()
  | (cvTa, s) :: rest => do
    let tq0 ← unwrapOr (openPisAtFvarsC nP cvTa0.type 0)
      (.internal "block: type former telescope")
    let tq ← unwrapOr (openPisAtFvarsC nP cvTa.type 0)
      (.invalid "parameters of all inductive datatypes must match")
    unless tq.1.length == tq0.1.length do
      throw (.invalid "parameters of all inductive datatypes must match")
    checkBlockDomsAtC mode fe 0 tq.1 (tq0.1.map Expr.fvarTypeD) nP
    unless ← liftFueled "level comparison" (Level.isEquiv s s0) do
      throw (.invalid "mutually inductive types must live in the same universe")
    checkBlockAgreeC fe nP cvTa0 s0 rest

/-- The cached `checkBlockInds`; the formers are pushed by `consBlockIndsF`. -/
def checkBlockIndsC (fe : FEnv) (p : BlockShape) (isRec : Bool) :
    CheckCM (FEnv × BlockShape) :=
  match p.members with
  | [] => throw (.internal "block: no type former")
  | ms0 :: rest => do
    let (cvTa0, s0) ← checkBlockTeleC mode fe p.nP ms0
    let cvs ← checkBlockTelesC mode fe p.nP rest
    checkBlockAgreeC mode fe p.nP cvTa0 s0 cvs
    let p₁ := p.withSort s0
    pure (consBlockIndsF p₁ isRec (p.members.map (·.declared)) 0 fe, p₁)

/-! ## Stage 1b: the constructors -/

/-- The cached `checkStructDomsAt`, over arrays. -/
def checkStructDomsAtC (fe : FEnv) (off : Nat) (fvs doms : Array Expr) : Nat → CheckCM Unit
  | 0 => pure ()
  | j + 1 => do
    let a ← unwrapOr fvs[j]? (.internal "direct structure: domain index")
    let b ← unwrapOr doms[j]? (.internal "direct structure: domain index")
    unless ← defeqI mode fe false checkFuel (off + j) a.fvarTypeD b do
      throw (.notImplemented "direct structure: binder domain mismatch")
    checkStructDomsAtC fe off fvs doms j

/-- The cached `checkStructFieldSortsI`, over an array of field variables. -/
def checkStructFieldSortsC (fe : FEnv) (isProp large : Bool) (s : Level) (nP : Nat)
    (fvs : Array Expr) (idxArgs : List Expr) : Nat → CheckCM Unit
  | 0 => pure ()
  | j + 1 => do
    let fv ← unwrapOr fvs[j]? (.internal "direct sum: field index")
    let ty ← inferI mode fe false checkFuel false (nP + j) fv.fvarTypeD
    let u ← ensureSortI mode fe false checkFuel (nP + j) ty
    if !isProp then
      unless ← liftFueled "level comparison" (Level.leq u s) do
        throw (.invalid "direct sum: field universe too large")
    else if large then
      unless Level.isEquiv u .zero == some true || idxArgs.contains fv do
        throw (.invalid "direct sum: large eliminator with a non-propositional \
          field outside the indices")
    checkStructFieldSortsC fe isProp large s nP fvs idxArgs j

/-- The cached `checkSumCtor`: the telescopes opened by
`openPisAtFvarsC`, the residual's spine read once by `getAppArgsC`,
the resolution gates by `constsResolveFC`. -/
def checkSumCtorC (fe₀ fe : FEnv) (T : Name) (lps : List Name) (nP nIdx : Nat)
    (resSort : Level) (isProp large : Bool) (cvC : ConstantVal) (nF : Nat)
    (cvTa : ConstantVal) : CheckCM Unit := do
  checkConstantValC mode fe cvC
  let (_, cbody) ← unwrapOr (cvC.type.stripPis (nP + nF))
    (.notImplemented "direct sum: constructor telescope")
  unless structCtorResidOk T lps nP nF nIdx cbody do
    throw (.invalid "direct sum: invalid constructor return type")
  let cq ← unwrapOr (openPisAtFvarsC nP cvC.type 0)
    (.notImplemented "direct sum: constructor telescope")
  let tq ← unwrapOr (openPisAtFvarsC nP cvTa.type 0)
    (.notImplemented "direct sum: type former telescope")
  checkStructDomsAtC mode fe 0 cq.1.toArray (tq.1.map Expr.fvarTypeD).toArray nP
  let xq ← unwrapOr (openPisAtFvarsC nF cq.2 nP)
    (.notImplemented "direct sum: constructor field telescope")
  let args := Expr.getAppArgsC xq.2
  unless xq.2.getAppFn == Expr.const T (lps.map .param) &&
      args.take nP == cq.1 && args.length == nP + nIdx do
    throw (.notImplemented "direct sum: opened constructor residual")
  unless xq.1.all fun x => constsResolveFC fe₀ x.fvarTypeD do
    throw (.notImplemented "direct sum: field domain after the block")
  unless (args.drop nP).all fun e => constsResolveFC fe₀ e do
    throw (.invalid "direct sum: index expression mentions the block")
  checkStructFieldSortsC mode fe isProp large resSort nP xq.1.toArray (args.drop nP) nF

/-- The cached `checkSumCtors`. -/
def checkSumCtorsC (fe₀ fe : FEnv) (T : Name) (lps : List Name) (nP nIdx : Nat)
    (resSort : Level) (isProp large : Bool) (cvTa : ConstantVal) :
    List (ConstantVal × Nat) → CheckCM Unit
  | [] => pure ()
  | c :: cs => do
    checkSumCtorC mode fe₀ fe T lps nP nIdx resSort isProp large c.1 c.2 cvTa
    checkSumCtorsC fe₀ fe T lps nP nIdx resSort isProp large cvTa cs

/-- The cached `checkBlockCtors`. -/
def checkBlockCtorsC (fe₀ fe : FEnv) (p : BlockShape) : List MemberShape → CheckCM Unit
  | [] => pure ()
  | ms :: rest => do
    checkSumCtorsC mode fe₀ fe ms.cvT.name p.lps p.nP ms.nIdx
      p.resSort p.isProp p.large ms.cvT ms.ctors
    checkBlockCtorsC fe₀ fe p rest

/-- The cached `checkBlockIdxSorts` (the tail's index sorts), over
positivity's `checkStructFieldSortsIC`. -/
def checkBlockIdxSortsC (fe₁ : FEnv) (p : BlockShape) : List MemberShape → CheckCM Unit
  | [] => pure ()
  | ms :: rest => do
    let tq ← unwrapOr (openPisAtFvarsC (p.nP + ms.nIdx) ms.cvT.type 0)
      (.internal "direct rec: type former telescope")
    checkStructFieldSortsIC mode fe₁ true false p.resSort p.nP (tq.1.drop p.nP) [] ms.nIdx
    checkBlockIdxSortsC fe₁ p rest

/-! ## The classes: the pre-pass -/

/-- The cached `classReadMinor`: the minor's telescope opened by
`openPisAtFvarsC`, the spines read by `getAppArgsC`. -/
def classReadMinorC (nP : Nat) (motPos : List Nat) (d : Nat) (dom : Expr) :
    Option ClassSlot := do
  let n := dom.piBinders.1.length
  let (fvs, concl) ← openPisAtFvarsC n dom d
  let .fvar p _ := concl.getAppFn | none
  let c ← classOfMotiveVar nP motPos p
  let .const C _ := (← (Expr.getAppArgsC concl).getLast?).getAppFn | none
  let ihs := (List.range fvs.length).filterMap fun q =>
    match (fvs.getD q default).fvarTypeD.piResult.getAppFn with
    | .fvar p' _ =>
      match classOfMotiveVar nP motPos p' with
      | some t =>
        match (Expr.getAppArgsC (fvs.getD q default).fvarTypeD.piResult).getLast? with
        | some a =>
          match a.getAppFn with
          | .fvar f _ => if d ≤ f then some (f - d, t) else none
          | _ => none
        | none => none
      | none => none
    | _ => none
  pure (.minor c C ihs)

/-- The cached `classReadSlots`: each binder opened by `instantiate1C`. -/
def classReadSlotsC (nPc : Name → Nat) (np : Nat) :
    Nat → List Nat → Nat → Expr → Option (List ClassSlot)
  | 0, _, _, _ => some []
  | n + 1, motPos, d, .forallE dom body => do
    let slot ← match dom.piResult with
      | .sort _ => do
        let (bs, _) := dom.piBinders
        let mdom ← bs.getLast?
        let .const I us := mdom.getAppFn | none
        pure (ClassSlot.motive ⟨I, us, (Expr.getAppArgsC mdom).take (nPc I)⟩)
      | _ => classReadMinorC np motPos d dom
    let motPos' := match slot with | .motive _ => motPos ++ [d - np] | _ => motPos
    let rest ← classReadSlotsC nPc np n motPos' (d + 1) (Expr.instantiate1C body (.fvar d dom))
    pure (slot :: rest)
  | _ + 1, _, _, _ => none

/-- The cached `classRead` (the UNVERIFIED pre-pass, `ClassRead.lean`):
the recursor types opened by `openPisAtFvarsC`. -/
def classReadC (nP : Nat) (nPc : Name → Nat) (recs : List RecShape) : Option ClassRead := do
  let rc0 ← recs.head?
  let (_, body) ← openPisAtFvarsC nP rc0.cvR.type 0
  let slots ← classReadSlotsC nPc nP (rc0.rP - nP) [] nP body
  let motPos := (List.range slots.length).filter fun s =>
    match slots[s]? with | some (.motive _) => true | _ => false
  let recCls ← recs.mapM fun rc => do
    let (_, concl) ← openPisAtFvarsC (rc.mI + 1) rc.cvR.type 0
    let .fvar p _ := concl.getAppFn | none
    classOfMotiveVar nP motPos p
  pure ⟨slots, recCls⟩

/-! ## The classes: the keys and the majors -/

/-- The cached `classKeyCanon`. -/
def classKeyCanonC (params : List Expr) (k : ClassKey) : ClassKey :=
  { k with ds := k.ds.map (targetCanonParamsC params) }

/-- The cached `classKeyOf`. -/
def classKeyOfC (nP : Nat) (params : List Expr) (k : ClassKey) : CheckCM ClassKey := do
  let k := classKeyCanonC params k
  unless k.ds.all (fun x => x.bvarB == 0 && x.fvarB ≤ nP) do
    throw (.invalid "target rec: the major's parameters mention more than the \
      recursor's parameters")
  pure k

/-- The cached `targetOutsideInst`: the former's telescope by
`familyTelescopeC`, at the class's levels by `instLevelParams` and its
parameters by `instPisWithC`. -/
def targetOutsideInstC (fe : FEnv) (I : Name) (us : List Level) (ds : List Expr) :
    CheckCM (Nat × Level) := do
  let some (.indInfo cvI capsI) := fe.find? I
    | throw (.invalid "target rec: the recursor's major is not a stored inductive")
  let tyI ← familyTelescopeC mode fe cvI capsI
  let some ty := Expr.instPisWithC ds (Expr.instLevelParams cvI.levelParams us tyI)
    | throw (.invalid "target rec: the major's type former does not bind its parameters \
        (official: ill-formed inductive type)")
  let (ibs, s) := ty.piBinders
  let .sort s := s
    | throw (.invalid "target rec: the major's type former is not a telescope ending in a \
        sort (official: type expected)")
  pure (ibs.length, s)

/-- The cached `targetMajorOf`: the spine read by `getAppArgsC`, the
auxiliary-type test by `nestOccC`. -/
def targetMajorOfC (fe : FEnv) (p : BlockShape) (pfvs fvs : List Expr) (mty : Expr) :
    CheckCM TargetMajor := do
  let args := Expr.getAppArgsC mty
  match mty.getAppFn with
  | .const I us =>
    match p.memberNames.findIdx? (· == I) with
    | some t => do
      let ms ← unwrapOr p.members[t]? (.internal "target rec: member")
      unless us == p.lps.map .param && args.take p.nP == fvs.take p.nP do
        throw (.invalid "target rec: the recursor's major premise is not the member at its \
          parameters and its index binders")
      pure { ind := I, lvls := us, ds := fvs.take p.nP, nPc := p.nP, nIdx := ms.nIdx,
             ctors := ms.ctors, member := some t, pfvs := pfvs : TargetMajor }
    | none => do
      if I == quotName then
        throw (.invalid "target rec: the recursor's major is Quot, which is no inductive")
      let some (nPc, ctors) := targetCtorsOf fe I
        | throw (.invalid "target rec: the recursor's major is not a stored inductive")
      let ds := args.take nPc
      unless ds.length == nPc &&
          ds.all (fun x => x.bvarB == 0 && x.fvarB ≤ p.nP) do
        throw (.invalid "target rec: the major's parameters mention more than the \
          recursor's parameters")
      unless ds.any (fun x => Expr.nestOccC p.memberNames 0 0 x) do
        throw (.invalid "target rec: the recursor's major is an outside inductive at an \
          instantiation that is no auxiliary type of the block (official generates no such \
          auxiliary recursor: `elim_nested_inductive`, `is_nested`)")
      let (nIdx, sI) ← targetOutsideInstC mode fe I us ds
      unless ← liftFueled "level comparison" (Level.isEquiv sI p.resSort) do
        throw (.invalid "target rec: the recursor's major lives in another universe than \
          the block (Q1)")
      pure { ind := I, lvls := us, ds := ds, nPc := nPc, nIdx := nIdx, ctors := ctors,
             member := none, pfvs := pfvs }
  | _ => throw (.invalid "target rec: the recursor's major premise is not an inductive's \
      application")

/-- The cached `targetPinTys`. -/
def targetPinTysC (fe : FEnv) (d : Nat) : List Expr → CheckCM Unit
  | [] => pure ()
  | x :: xs => do
    let _ ← inferI mode fe false checkFuel false d x
    targetPinTysC fe d xs

/-- The cached `targetMajorPins`. -/
def targetMajorPinsC (fe : FEnv) (rP : Nat) (M : TargetMajor) : CheckCM Unit :=
  if M.member.isNone then do
    targetPinTysC mode fe rP M.ds
    familyKeyCheckC mode fe fe.find? rP M.ind M.lvls M.ds
  else pure ()

/-- The cached `classMajors`. -/
def classMajorsC (fe : FEnv) (p : BlockShape) (pfvs : List Expr) :
    List ClassKey → CheckCM (List TargetMajor)
  | [] => pure []
  | key :: keys => do
    let M ← targetMajorOfC mode fe p pfvs pfvs (Expr.mkAppN (.const key.ind key.lvls) key.ds)
    targetMajorPinsC mode fe p.nP M
    let Ms ← classMajorsC fe p pfvs keys
    pure (M :: Ms)

/-- The cached `checkBlockClasses`. -/
def checkBlockClassesC (fe₁ : FEnv) (p : BlockShape) (params : List Expr) :
    CheckCM (ClassRead × List TargetMajor) := do
  -- [UNVERIFIED] the pre-pass: the classes, the layout, each recursor's class
  let rd ← unwrapOr (classReadC p.nP (classNPcOf p fe₁) p.recs)
    (.invalid "generated recursor: the recursor family is not of the generated shape \
      (official: invalid recursor)")
  let keys ← rd.classes.mapM (classKeyOfC p.nP params)
  let Ms ← classMajorsC mode fe₁ p params keys
  unless (List.range p.k).all (fun t => (Ms.filter (·.member == some t)).length == 1) do
    throw (.invalid "generated recursor: the recursor family does not have exactly one class \
      per member (official: invalid recursor)")
  pure (rd, Ms)

end ConLeche.Cached

end
-- ===== ConLeche.Cached.IndTail (212 lines) =====
section
-- E1: module

-- E1: public import ConLeche.Cached.IndPass
-- E1: public import ConLeche.Kernel.Inductives.RecCheck

-- E1: @[expose] public section

/-!

The production twins of the block check's tail (`checkBlockTail`,
`ConLeche/Kernel/Inductives/BlockTail.lean`) that the cached driver
(`checkBlockTailS`, `ConLeche/Cached/CheckerC.lean`) runs after the
recursor stage: the generated recursors' records
(`blockRecInfosTF`), the stream's recursors against the generated ones
(`streamRecsCheck`, `ConLeche/Kernel/Inductives/StreamRecs.lean`) and the
projection tables' checks (`checkBlockTables`).  Monomorphic `CheckCM`
definitions at a mode and an environment index, calling the cached core
(`inferI`, `defeqI` at `checkFuel`) directly and the cached walks of
`ConLeche/Cached/ExprOpsC.lean` where the specification runs the plain
ones.  Each is the specification at the shared operations
(`ConLeche/Verify/Cached/IndTailC.lean`; the tables' checks, which read
the environment, at the index `mkFEnv env` of the specification's `env`).
-/

namespace ConLeche.Cached

open ConLeche

variable (mode : CheckMode)

/-! ## The generated recursors' records -/

/-- The cached `auxRuleFire`: the class's parameters closed by
`abstractPrefixC` (one pass each). -/
def auxRuleFireC (M : TargetMajor) (rP : Nat) : RecRuleFire :=
  .nested M.lvls (M.ds.map (Expr.abstractPrefixC rP 0))

/-- The cached `generatedRules`. -/
def generatedRulesC (rP : Nat) (M : TargetMajor) (rhss : List Expr) : List RecRule :=
  let rules := sumRules M.ctors rhss
  match M.member with
  | none =>
    let fire := auxRuleFireC M rP
    rules.map fun rl => { rl with fire := fire }
  | some _ => rules

/-- The cached `blockRecInfosTF`: the checked family's records, at their
majors, in push order. -/
def blockRecInfosTC
    (p : BlockShape) : Nat → List (ConstantVal × TargetMajor × List Expr) → List ConstantInfo
  | _, [] => []
  | m, (cv, M, rhss) :: rest =>
    .recInfo cv (p.majorIdxAt m) (p.rulePrefixAt m)
        (recKExpected p M) (generatedRulesC (p.rulePrefixAt m) M rhss)
      :: blockRecInfosTC p (m + 1) rest

/-- The cached `generatedFire`. -/
def generatedFireC (M : TargetMajor) (rP : Nat) : RecRuleFire :=
  match M.member with
  | none => auxRuleFireC M rP
  | some _ => .plain

/-! ## The stream's recursors against the generated ones -/

/-- The cached `streamNestedOk`: the pins lifted by `liftLooseBVarsC`, the
major domain's spine read by `getAppArgsC`. -/
def streamNestedOkC (ty : Expr) (mI rP : Nat) : RecRuleFire → Bool
  | .plain => true
  | .levels _ => true
  | .nested lvls pins =>
    match ty.stripPis mI with
    | some (_, .forallE dom _) =>
      (match dom.getAppFn with
       | .const _ us => us == lvls
       | _ => false) &&
      Expr.getAppArgsC dom ==
        pins.map (fun e => Expr.liftLooseBVarsC (mI - rP) e 0) ++
          (List.range (mI - rP)).map (fun i => Expr.bvar (mI - rP - 1 - i))
    | _ => false

/-- The cached `recDomsAt`. -/
def recDomsAtC (fe : FEnv) (rec : Name) (sfvs gfvs : List Expr) :
    Nat → Nat → CheckCM Unit
  | _, 0 => pure ()
  | j, k + 1 => do
    let a ← unwrapOr sfvs[j]? (.internal "stored recursor: domain index")
    let b ← unwrapOr gfvs[j]? (.internal "stored recursor: domain index")
    unless ← defeqI mode fe false checkFuel j a.fvarTypeD b.fvarTypeD do
      throw (.invalid s!"the type of the recursor {rec} is not the generated one: the \
        domain of binder {j} differs")
    recDomsAtC fe rec sfvs gfvs (j + 1) k

/-- The cached `recTyOpened`. -/
def recTyOpenedC (fe : FEnv) (rec : Name) (n : Nat) :
    Option (List Expr × Expr) → Option (List Expr × Expr) → CheckCM Unit
  | some (sfvs, srest), some (gfvs, grest) => do
    recDomsAtC mode fe rec sfvs gfvs 0 n
    unless ← defeqI mode fe false checkFuel n srest grest do
      throw (.invalid s!"the type of the recursor {rec} is not the generated one: its body \
        after the major differs")
  | none, _ =>
    throw (.invalid s!"the type of the recursor {rec} is not the generated one: it has fewer \
      than {n} binders")
  | some _, none =>
    throw (.internal s!"the generated type of the recursor {rec} has fewer than {n} binders")

/-- The cached `recTyCheck`: the guards by the memoised walks, the two
types opened by `openPisAtFvarsC`. -/
def recTyCheckC (fe : FEnv) (rec : Name) (lps : List Name) (n : Nat) (s g : Expr) :
    CheckCM Unit := do
  unless s.looseBVarsBounded 0 && !s.hasFvar && !g.hasFvar do
    throw (.invalid s!"the type of the recursor {rec} is not closed")
  unless Expr.allLevelParamsDefinedC lps s do
    throw (.invalid s!"undeclared universe parameter in the type of the recursor {rec}")
  unless constsResolveFC fe s do
    throw (unresolvedConstsErrorLC true s!"the type of the recursor {rec}" s)
  let st ← inferI mode fe false checkFuel false 0 s
  let _ ← ensureSortI mode fe false checkFuel 0 st
  recTyOpenedC mode fe rec n (openPisAtFvarsC n s 0) (openPisAtFvarsC n g 0)

/-- The cached `ruleAgree`. -/
def ruleAgreeC (fe : FEnv) (rec ctor : Name) (lps : List Name) (s g : Expr) :
    CheckCM Unit := do
  unless s.looseBVarsBounded 0 && !s.hasFvar && !g.hasFvar do
    throw (.invalid s!"the recursor {rec}'s rule for {ctor} has a right-hand side that is \
      not closed")
  unless Expr.allLevelParamsDefinedC lps s do
    throw (.invalid s!"the recursor {rec}'s rule for {ctor} has an undeclared universe \
      parameter")
  unless constsResolveFC fe s do
    throw (unresolvedConstsErrorLC true s!"the recursor {rec}'s rule for {ctor}" s)
  let ts ← inferI mode fe false checkFuel false 0 s
  let tg ← inferI mode fe false checkFuel false 0 g
  unless ← defeqI mode fe false checkFuel 0 ts tg do
    throw (.invalid s!"the recursor {rec}'s rule for {ctor} has a right-hand side whose \
      type is not the generated one's")
  unless ← defeqI mode fe false checkFuel 0 s g do
    throw (.invalid s!"the recursor {rec}'s rule for {ctor} has a right-hand side that is \
      not definitionally equal to the generated one")

/-- The cached `streamRulesShape`. -/
def streamRulesShapeC (rec : Name) : List RecRule → List (ConstantVal × Nat) → CheckCM Unit
  | [], [] => pure ()
  | r :: rs, c :: cs => do
    unless r.ctor == c.1.name && r.nfields == c.2 do
      throw (.invalid s!"the recursor {rec}'s rule for {r.ctor} is not the generated one's \
        (constructor {c.1.name}, {c.2} fields)")
    streamRulesShapeC rec rs cs
  | rs, cs =>
    throw (.invalid s!"the recursor {rec} carries {rs.length} more or fewer rules than the \
      generated one ({cs.length} unmatched)")

/-- The cached `streamRulesCheck`. -/
def streamRulesCheckC (fe : FEnv) (rec : Name) (lps : List Name) :
    List RecRule → List Expr → CheckCM Unit
  | r :: rs, g :: gs => do
    unless r.rhs == g do
      ruleAgreeC mode fe rec r.ctor lps r.rhs g
    streamRulesCheckC fe rec lps rs gs
  | [], [] => pure ()
  | _, _ =>
    throw (.internal s!"the recursor {rec}: the generated rules are not one per stored rule")

/-- The cached `streamRecCompare`. -/
def streamRecCompareC (fe : FEnv) (rc : RecShape) (g : ConstantVal × TargetMajor × List Expr) :
    CheckCM Unit := do
  unless rc.cvR.type == g.1.type do
    recTyCheckC mode fe g.1.name g.1.levelParams (rc.mI + 1) rc.cvR.type g.1.type
  streamRulesCheckC mode fe g.1.name g.1.levelParams rc.rules g.2.2

/-- The cached `streamRecCheck`. -/
def streamRecCheckC (fe : FEnv) (rc : RecShape) (g : ConstantVal × TargetMajor × List Expr) :
    CheckCM Unit := do
  streamRulesShapeC rc.cvR.name rc.rules g.2.1.ctors
  unless streamNestedOkC rc.cvR.type rc.mI rc.rP (generatedFireC g.2.1 rc.rP) do
    throw (.invalid s!"the recursor {rc.cvR.name}'s stored type does not apply its \
      major's container at the generated firing data")
  streamRecCompareC mode fe rc g

/-- The cached `streamRecsCheck`. -/
def streamRecsCheckC (fe : FEnv) :
    List RecShape → List (ConstantVal × TargetMajor × List Expr) → CheckCM Unit
  | rc :: rcs, g :: gs => do
    streamRecCheckC mode fe rc g
    streamRecsCheckC fe rcs gs
  | [], [] => pure ()
  | _, _ => throw (.internal "stored recursors: the generated family is not the records'")

/-! ## The projection tables -/

/-- The cached `checkStructProjTable`: the bodies' guards by the memoised
walks. -/
def checkStructProjTableC (t : ProjTable) (fe : FEnv) : CheckCM Unit := do
  unless t.bodies.size = t.numFields ∧ t.bodies.all (fun b => !b.hasFvar &&
      Expr.allLevelParamsDefinedC t.levelParams b && constsResolveFC fe b &&
      b.looseBVarsBounded (t.numParams + 1)) do
    throw (.internal "direct structure: projection body scoping")
  unless (fe.find? t.structName).isSome do
    throw (.internal "direct structure: projection table before its structure")
  unless (fe.findTable? t.structName).isNone do
    throw (.invalid "projection table taken")

/-- The cached `checkBlockTables`. -/
def checkBlockTablesC (fe : FEnv) : List ProjTable → CheckCM Unit
  | [] => pure ()
  | t :: rest => do
    checkStructProjTableC t fe
    checkBlockTablesC fe rest

end ConLeche.Cached

end
-- ===== ConLeche.Cached.CheckerC (262 lines) =====
section
-- E1: module

-- E1: public import ConLeche.Kernel.Inductives.BlockTail
-- E1: public import ConLeche.Cached.IndBlock
-- E1: public import ConLeche.Cached.IndTail

-- E1: @[expose] public section

/-!

The declaration checker *above* `CheckerOps` is shared verbatim with
the generic one: only the core is replaced.  What lives here is the
thin per-declaration phase-driver layer at `CheckCM`, plus the
entry-point record over the cached core.

What the layer is *for*: the per-declaration phase driver that the
parsed-declaration driver (`ConLeche/Cached/ParsedC.lean`) and its bridges
consume — at a `CheckMode` (see `ParsedC.lean`'s header).
-/

namespace ConLeche.Cached

open ConLeche

/-! ### The direct installers' walker (task #214) -/

/-- `structProjBodiesGo` at the memoised substitution
(`structProjBodiesGoC_eq`). -/
def structProjBodiesGoC (T : Name) (vs : List Expr) : Nat → Nat → Expr → Option (List Expr)
  | 0, _, _ => some []
  | k + 1, i, .forallE fdom body =>
    (structProjBodiesGoC T (structProjArgP T i :: vs) k (i + 1) body).map
      (Expr.instantiateLiftC fdom vs :: ·)
  | _ + 1, _, _ => none

/-- `structProjBodies` at the memoised substitution: each field's raw
domain substituted once by `instantiateLiftC` (`structProjBodiesC_eq`). -/
def structProjBodiesC (T : Name) (nP nF : Nat) (cty : Expr) : Option (Array Expr) :=
  match cty.stripPis nP with
  | some (_, r) => (structProjBodiesGoC T (structProjPs nP).reverse nF 0 r).map List.toArray
  | none => none

/-- `blockTables` over the memoised projection bodies (task #497;
`blockTablesC_eq`, `ConLeche/Verify/Cached/WalkersC.lean`): the tables
the index records (`declTablesC`, `StreamIndex.add`) and the tables the
block's install checks and pushes (`checkBlockKS`). -/
def blockTablesC (p : BlockShape) : List MemberShape → Option (List ProjTable)
  | [] => some []
  | ms :: rest =>
    match ms.structCtor? with
    | some c =>
      (structProjBodiesC ms.declared.name p.nP c.2 c.1.type).bind fun bodies =>
        (blockTablesC p rest).map (⟨ms.declared.name, p.lps, p.nP, c.1.name, c.2, bodies⟩ :: ·)
    | none => blockTablesC p rest

/-- `declTables` over `blockTablesC`. -/
def declTablesC : Declaration → List ProjTable
  | .indDecl block nP =>
    match readBlock nP block with
    | .ok p => (blockTablesC p p.members).getD []
    | .error _ => []
  | _ => []

/-- The cached `blockIsRec` (official's `is_rec`): the declared
constructors' syntactic domains scanned by `mentionsAnyConstC`
(`blockIsRecC_eq`). -/
def blockIsRecC (p : BlockShape) : Bool :=
  p.members.any fun ms => ms.ctors.any fun c => Expr.piDomsMentionAnyC p.memberNames c.1.type

/-- The cached `Expr.dropVars`: each variable dropped by `instantiate1C`
(`dropVarsC_eq`). -/
def Expr.dropVarsC : Nat → Expr → Expr
  | 0, e => e
  | n + 1, e => Expr.dropVarsC n (Expr.instantiate1C e (.sort .zero))

/-- The cached `recFire`: a nested recursor's container parameters
moved by `dropVarsC` (`recFireC_eq`). -/
def recFireC (p : BlockShape) (rc : RecShape) : RecRuleFire :=
  if rc.tgt < p.k then .plain
  else
    match rc.cvR.type.stripPis rc.mI with
    | some (_, .forallE dom _) =>
      match dom.getAppFn with
      | .const _ us =>
        let nI := rc.mI - rc.rP
        let args := dom.getAppArgs
        .nested us ((args.take (args.length - nI)).map (Expr.dropVarsC nI))
      | _ => .plain
    | _ => .plain

/-- The cached `blockRecs`, over `recFireC` (`blockRecsC_eq`). -/
def blockRecsC (p : BlockShape) : List RecShape → List ConstantInfo
  | [] => []
  | rc :: rest =>
    .recInfo rc.cvR rc.mI rc.rP rc.isK (rc.rules.map ({ · with fire := recFireC p rc })) ::
      blockRecsC p rest

/-- `blockConstants` at `blockIsRecC` and `blockRecsC`: the constants the index records
(`declConstantsC`) and the block's install pushes (`checkBlockKS`). -/
def blockConstantsC (p : BlockShape) : List ConstantInfo :=
  blockFormers p (blockIsRecC p) ++ blockCtors p ++ blockRecsC p p.recs

/-- `declConstants` over `blockConstantsC`. -/
def declConstantsC : Declaration → List ConstantInfo
  | .defnDecl cv value hint => [.defnInfo cv value hint]
  | .thmDecl cv _ => [.thmInfo cv]
  | .opaqueDecl cv _ => [.axiomInfo cv]
  | .axiomDecl cv =>
    if cv.name = quotSoundName then [quotAt .sound cv]
    else if cv.name = sorryAxName then []
    else [.axiomInfo cv]
  | .quotDecl k cv => [quotAt k cv]
  | .indDecl block nP =>
    match readBlock nP block with
    | .ok p => blockConstantsC p
    | .error _ => []

variable (mode : CheckMode)

/-! ## The entry-point record over the cached core

`opI`/`opW`/`opB`/`opS` pass their `Expr` arguments through: there is one
expression type (task #172 B3a). -/

/-- Shared-state inference entry point: the cached knot's full-grade
`inferI`. -/
def opI (fe : FEnv) (d : Nat) (e : Expr) : CheckCM Expr :=
  inferI mode fe false checkFuel false d e

/-- Shared-state head-normalization entry point. -/
def opW (fe : FEnv) (d : Nat) (e : Expr) : CheckCM Expr :=
  whnfI mode fe false checkFuel d e

/-- Shared-state definitional-equality entry point. -/
def opB (fe : FEnv) (d : Nat) (a b : Expr) : CheckCM Bool :=
  defeqI mode fe false checkFuel d a b

/-- Shared-state sort-ensuring entry point. -/
def opS (fe : FEnv) (d : Nat) (e : Expr) : CheckCM Level :=
  ensureSortI mode fe false checkFuel d e

/-- The per-declaration shared operations at a fixed environment
index. -/
def sharedOpsC (fe : FEnv) : CheckerOps CheckCM where
  inferType _ d e := opI mode fe d e
  isDefEq _ d a b := opB mode fe d a b
  ensureSort _ d e := opS mode fe d e
  whnf _ d e := opW mode fe d e


/-! ## Thin phase drivers (one `CState` per declaration)

Each mirrors its `ConLeche/Kernel/Checker.lean` counterpart clause by
clause; the differences are exactly: `flushC` at environment
transitions, `FEnv.push` maintaining the index, and *every*
environment lookup routed through the index (task #63). -/

/-- **The rule stage's operations at the rule-less recursors'
environment**: `sharedOpsC` at `feR`, with a `flushC` ENTERING and
LEAVING its `inferType`.

One rule runs operations at TWO environments, interleaved: its
right-hand side is typed at `feR` (the `k` rule-less
recursors consed), and everything after — the λ-domains' defeq, the
residue's inference, the conclusion's defeq — at the constructors'
index.  The memo caches are keyed by the term alone, and their
invariant (`CSOK`, `ConLeche/Verify/Cached/SimC.lean`) is a claim at
ONE environment, so a state threaded unflushed across the two is not
a state of either: an entry the `feR` half wrote (a term naming a
recursor, typed where the recursor is stored) is not a claim at the
constructors' environment, where the recursor is absent.  The flushes
are the drivers' own discipline (`flushC` at every environment
transition), placed where the transitions are: the stage's `feR` half
is exactly one operation, the `inferType` (`classRuleOk`,
`ConLeche/Kernel/Inductives/GenRec.lean`, infers only).  Every other
operation is `sharedOpsC`'s. -/
def sharedOpsRuleR (fe : FEnv) : CheckerOps CheckCM :=
  { sharedOpsC mode fe with
    inferType := fun _ d e => do
      -- the flush entering the `feR` half
      flushC
      let t ← opI mode fe d e
      flushC
      pure t }

/-- **`checkBlockPass` through the index**: the k
formers checked and consed — one flush entering the environment that
holds them all — then the constructors per member at that
environment, the classes, and the positivity check walking every class
(the members' root frame first). -/
def checkBlockPassS (fe : FEnv) (p₀ : BlockShape) (isRec : Bool) :
    CheckCM (BlockPass FEnv) := do
  let (fe₁, p₁) ← checkBlockIndsC mode fe p₀ isRec
  flushC
  checkBlockCtorsC mode fe₁ fe₁ p₁ p₁.members
  let (ctx, holes) ← blockNestCtxC p₁ fe₁.find?
  let (rd, Ms) ← checkBlockClassesC mode fe₁ p₁ ctx.params
  let (outs, pos) ← checkBlockPositivityC mode fe₁ fe₁.find? p₁
  let st ← nestSeedsC mode fe₁ ctx (classSeedsC ctx holes Ms) pos
  pure ⟨fe₁, p₁, nestOutKinds outs, ctx.params, rd, Ms, st.ctorNfs⟩

/-- **`checkBlockTail` through the index**: one flush entering the recursors' environment.  The
constructors' index `fe₂` is read at once by the rule-less recursors (the rule stage reads `fe₂` and
them) and by the generated recursors, so both are overlays sharing it (`classFeROvl`,
`genRecCheckC`; `blockRecInfosTC`): a push onto `fe₂` while it is alive would copy the whole bucket
array, once per inductive block. -/
def checkBlockTailS (block : List ConstantInfo) (q : BlockPass FEnv) (Q : List ProjTable) :
    CheckCM Unit :=
  match q with
  | ⟨env₁, p, kinds, params, rd, cls, tbl⟩ => do
  checkBlockIdxSortsC mode env₁ p p.members
  let fe₂ := consBlockCtorsF p.nP p.ctorGroups env₁
  flushC
  let out ← genRecCheckC mode fe₂ p (blockNestedBit p kinds) params tbl.toList rd cls block
  -- the stream's recursors against the generated ones, at the generated recursors as an OVERLAY on
  -- the constructors' index (read-only, sharing it), a flush entering and leaving that environment
  streamKCheck p p.recs out
  let feG := fe₂.overlay (blockRecInfosTC p 0 out).reverse
  flushC
  streamRecsCheckC mode feG p.recs out
  flushC
  checkBlockTablesC fe₂ Q

/-- Twin of `reduceMember`. -/
def reduceMemberS (fe : FEnv) (ms : MemberShape) (nP : Nat) : CheckCM MemberShape :=
  if formerDefHeaded ms.cvT then do
    if declinedAtDefinition.contains ms.cvT.name then
      throw (.notImplemented s!"this family stored at a definition ({ms.cvT.name})")
    else do
      checkConstantValC mode fe ms.cvT
      let cvR ← reducedFormerC mode fe ms.cvT (nP + ms.nIdx)
      unless ← defeqI mode fe false checkFuel 0 ms.cvT.type cvR.type do
        throw (.invalid "direct sum: a type former's declared type and its reduct differ")
      pure { ms with cvT := cvR }
  else pure ms

/-- Twin of `reduceMembers`. -/
def reduceMembersS (fe : FEnv) (nP : Nat) : List MemberShape → CheckCM (List MemberShape)
  | [] => pure []
  | ms :: rest => do
    flushC
    let ms' ← reduceMemberS mode fe ms nP
    let rest' ← reduceMembersS fe nP rest
    pure (ms' :: rest')

/-- **`checkBlock` through the index.** -/
def checkBlockKS (fe : FEnv) (block : List ConstantInfo) (p₀ : BlockShape) :
    CheckCM FEnv := do
  unless (p₀.allCtors.map (·.1.name)).Nodup ∧ p₀.memberNames.Nodup do
    throw (.invalid "direct rec: duplicate constructor")
  unless boolTrueName ∉ p₀.memberNames ∧ boolFalseName ∉ p₀.memberNames do
    throw (.invalid "direct rec: a family at a `Bool` constructor's name")
  let ms ← reduceMembersS mode fe p₀.nP p₀.members
  flushC
  let q ← checkBlockPassS mode fe { p₀ with members := ms } (blockIsRecC p₀)
  let Q ← unwrapOr (blockTablesC p₀ p₀.members) (.internal "direct structure: projection bodies")
  checkBlockTailS mode block q Q
  pure (FEnv.pushDelta (blockConstantsC p₀) Q fe)

end ConLeche.Cached

end
