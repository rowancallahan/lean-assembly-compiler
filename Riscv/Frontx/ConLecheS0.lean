-- ===== ConLeche.Kernel.FEnv (229 lines) =====
section
-- E1: module

-- E1: public import ConLeche.Kernel.Core
-- E1: import Std.Data.HashMap.Lemmas

-- E1: @[expose] public section

/-!

The spec environment together with a name index whose lookup function
agrees with `Env.find?`, built once per top-level entry call, plus the
`Env`-guard twins that read through it (`natLitStoredF`,
`strLitStoredF`, `natOpGuardF`).

**Representation-free.**  Nothing here mentions an expression
representation: `FEnv` indexes `ConstantInfo`s by `Name`, and the four
guards ask only about the constants an environment holds.  Both
executable cores read the environment through it, and the F-mirror
agreement (`ConLeche/Verify/EnvBound.lean`) is stated about it.  The
`F` suffix on the guards reads "through the index".
-/

namespace ConLeche
/-! ## The frozen base layer -/

/-- **A frozen lookup layer**: the index of a whole stream, built once
before any record is checked and never written again
(`ConLeche/Cached/StreamIndex.lean`).  An entry `n ↦ (c, ci)` says that
the first constant named `n` in the stream is `ci`, at counter `c`; an
entry `T ↦ (r, t)` says that the first table of `T` is `t`, of record `r`.
A view of the stream below a record reads the entries below that record's
first counter `below` and that record's position `belowRec` only.  The
empty layer answers `none` everywhere (`FBase.find?_empty`). -/
structure FBase where
  idx : Std.HashMap Name (Nat × ConstantInfo) := {}
  tbls : Std.HashMap Name (Nat × ProjTable) := {}
  below : Nat := 0
  belowRec : Nat := 0

/-- The base layer's lookup: a visible entry's constant. -/
def FBase.find? (b : @& FBase) (n : Name) : Option ConstantInfo :=
  match b.idx[n]? with
  | some (c, ci) => if c < b.below then some ci else none
  | none => none

/-- The base layer's table lookup: a visible entry's table. -/
def FBase.findTable? (b : @& FBase) (T : Name) : Option ProjTable :=
  match b.tbls[T]? with
  | some (r, t) => if r < b.belowRec then some t else none
  | none => none

/-! ## The indexed environment -/

/-- The spec environment together with a name index whose lookup function
agrees with `Env.find?` (built once per top-level entry call), over the
frozen layer of a stream's index (`base`). -/
structure FEnv where
  env : Env
  idx : Std.HashMap Name ConstantInfo
  /-- The frozen lookup layer under the index (`FBase`): consulted on an
  index miss.  Empty everywhere except in a view of a stream's index;
  `mkFEnv` and `push` leave it as it is. -/
  base : FBase
  /-- The **overlay**: constants consed onto `env` WITHOUT
  entering the index, newest first (`overlay`).  Empty on every
  environment a step threads (`mkFEnv`, `push`); non-empty only on
  the inductive block's rule-less-recursor environment, a read-only view
  that shares the constructors' index instead of copying it.  `find?`
  reads it before the index, as if its constants had been pushed
  (`find?_overlay_pushAll`, `ConLeche/Verify/Cached/BlockOverlay.lean`). -/
  ovl : List ConstantInfo
  /-- **The projection tables** (task #362), keyed on the structure's
  name: `env.tables` as a map (the newest table of a name wins, as
  `List.find?` takes the first). -/
  tbls : Std.HashMap Name ProjTable

/-- The index build, from the back: the newest (front) constant is
inserted last and wins, exactly as `List.find?` takes the first match —
so the agreement with `Env.find?` is unconditional (no freshness
assumption). -/
def mkIdxGo : List ConstantInfo → Std.HashMap Name ConstantInfo
  | [] => ∅
  | ci :: cs => (mkIdxGo cs).insert ci.name ci

/-- The table map's build, from the back: the newest (front) table is
inserted last and wins, exactly as `List.find?` takes the first. -/
def mkTblsGo : List ProjTable → Std.HashMap Name ProjTable
  | [] => ∅
  | t :: ts => (mkTblsGo ts).insert t.structName t

/-- Build the index of `env`. -/
def mkFEnv (env : Env) : FEnv :=
  ⟨env, mkIdxGo env.consts, {}, [], mkTblsGo env.tables⟩

namespace FEnv

/-- The index, then the frozen layer.  A job's own index is empty until its record pushes, and the
lookups are hot, so an empty index is not hashed into. -/
@[inline] def lookup (fe : @& FEnv) (n : Name) : Option ConstantInfo :=
  if fe.idx.isEmpty then fe.base.find? n
  else
    match fe.idx[n]? with
    | some ci => some ci
    | none => fe.base.find? n

/-- The emptiness test changes no answer. -/
theorem lookup_eq (fe : FEnv) (n : Name) :
    fe.lookup n = match fe.idx[n]? with
      | some ci => some ci
      | none => fe.base.find? n := by
  unfold lookup
  split
  · rename_i h
    rw [Std.HashMap.getElem?_of_isEmpty h]
  · rfl

/-- Indexed lookup (`= Env.find?` for `mkFEnv`); an index miss falls through to the base layer (empty
but in a view of a stream's index).  With an overlay, the overlay first -- exactly what pushing the
overlay's constants would answer.  `fe` is borrowed: the overlay branch otherwise makes the compiler
take it owned, reference-count traffic on every lookup. -/
def find? (fe : @& FEnv) (n : Name) : Option ConstantInfo :=
  match fe.ovl with
  | [] => fe.lookup n
  | ovl@(_ :: _) =>
    match ovl.find? (·.name == n) with
    | some ci => some ci
    | none => fe.lookup n

/-- The index of the cons-extended environment (`push_mkFEnv`:
`FEnv.push (mkFEnv env) ci = mkFEnv ⟨ci :: env.consts, env.tables⟩`,
definitionally). -/
def push (fe : FEnv) (ci : ConstantInfo) : FEnv :=
  ⟨⟨ci :: fe.env.consts, fe.env.tables⟩, fe.idx.insert ci.name ci, fe.base, fe.ovl, fe.tbls⟩

/-- **Push a projection table** (task #362): the table component
extended, the constant index untouched (`pushTable_mkFEnv`:
`FEnv.pushTable (mkFEnv env) t = mkFEnv ⟨env.consts, t :: env.tables⟩`,
definitionally). -/
def pushTable (fe : FEnv) (t : ProjTable) : FEnv :=
  ⟨⟨fe.env.consts, t :: fe.env.tables⟩, fe.idx, fe.base, fe.ovl, fe.tbls.insert t.structName t⟩

/-- Install a list of tables, head first (as `FEnv.pushAll` pushes
constants): `(pushTables Q fe).env.tables = Q.reverse ++ fe.env.tables`.
Tail-recursive, so the index is threaded owned. -/
def pushTables : List ProjTable → FEnv → FEnv
  | [], fe => fe
  | t :: Q, fe => pushTables Q (fe.pushTable t)

/-- Push a list of records, head first. -/
def pushAll : List ConstantInfo → FEnv → FEnv
  | [], fe => fe
  | ci :: rest, fe => pushAll rest (fe.push ci)

/-- **What an install step leaves behind**: the constants `L` pushed,
then the tables `Q` installed, each in install order — a constant push
and a table install touch different components, so every interleaving
of the two is this one. -/
def pushDelta (L : List ConstantInfo) (Q : List ProjTable) (fe : FEnv) : FEnv :=
  pushTables Q (pushAll L fe)

/-- **Cons `new` (newest first) as an overlay**: the environment `new` pushed onto `fe` would be
(`find?_overlay`, for an `fe` without an overlay), with the index SHARED, not mutated -- two live
environments, one bucket array.  Read-only: nothing pushes onto it. -/
def overlay (fe : FEnv) (new : List ConstantInfo) : FEnv :=
  ⟨⟨new ++ fe.env.consts, fe.env.tables⟩, fe.idx, fe.base, new ++ fe.ovl, fe.tbls⟩

/-- The table map's lookup, ungated: a miss in the map falls through to
the base layer (empty but in a view of a stream's index). -/
def rawTable? (fe : FEnv) (T : Name) : Option ProjTable :=
  match fe.tbls[T]? with
  | some t => some t
  | none => fe.base.findTable? T

/-- **The table lookup** (task #362): `T`'s table, visible exactly
where the constant `T` is (`= Env.findTable?` for `mkFEnv`,
`mkFEnv_findTable?`). -/
def findTable? (fe : FEnv) (T : Name) : Option ProjTable :=
  if (fe.find? T).isSome then fe.rawTable? T else none

/-- Indexed projection-table lookup (`= Env.findProj?` for `mkFEnv`). -/
def findProj? (fe : FEnv) (T : Name) (i : Nat) : Option ProjEntry :=
  match fe.findTable? T with
  | some tbl => if i < tbl.numFields then some (tbl.entry i) else none
  | none => none

/-- `andRescueSlots` through the index. -/
def andRescueSlotsF (fe : FEnv) (ctor : Name) (nP : Nat) : Bool :=
  andRescueSlotsOf fe.findProj? ctor nP

end FEnv

/-! ### Indexed guard twins (same result as the `Env` versions) -/

/-- `natLitSupported` through the index. -/
def natLitSupportedF (fe : FEnv) : Bool :=
  natIndOk (fe.find? natName) && natZeroOk (fe.find? natZeroName) &&
    natSuccOk (fe.find? natSuccName)

/-- `natLitStored` through the index. -/
def natLitStoredF (fe : FEnv) : Bool :=
  (fe.find? natName).isSome && (fe.find? natZeroName).isSome && (fe.find? natSuccName).isSome

/-- `strLitStored` through the index. -/
def strLitStoredF (fe : FEnv) : Bool :=
  natLitStoredF fe && (fe.find? stringName).isSome && (fe.find? stringOfListName).isSome &&
    (fe.find? listName).isSome && (fe.find? listNilName).isSome &&
    (fe.find? listConsName).isSome && (fe.find? charName).isSome &&
    (fe.find? charOfNatName).isSome

/-- `natOpGuard` through the index. -/
def natOpGuardF (fe : FEnv) (c : Name) : Bool :=
  natLitSupportedF fe &&
  (natOpDeps c).all (fun n => match fe.find? n with
    | some (.defnInfo cv _ _) => cv.levelParams.isEmpty
    | _ => false) &&
  (if c = natBeqName || c = natBleName || natDivModNames.contains c then
    (match fe.find? boolTrueName with
      | some ci => ci.toConstantVal.levelParams.isEmpty &&
          ci.toConstantVal.type == .const boolName []
      | none => false) &&
    (match fe.find? boolFalseName with
      | some ci => ci.toConstantVal.levelParams.isEmpty &&
          ci.toConstantVal.type == .const boolName []
      | none => false)
   else true)

end ConLeche

end
-- ===== ConLeche.Kernel.StdAxioms (217 lines) =====
section
-- E1: module

-- E1: public import ConLeche.Kernel.Basis.Builder

-- E1: @[expose] public section

/-!

A stream may use the standard axioms `propext` and `Classical.choice`.
Both are true in the set-theoretic model — `propext` by extensionality
of propositions (derived through the stored `Iff` recursor),
`Classical.choice` by global choice (through the stored `Nonempty`
recursor) — so the checker accepts exactly these two axioms, after
pinning their types and the *shapes of the inductives they quantify
over* to the toolchain's.  The pins below are hand-written through the
builder in `ConLeche/Kernel/Basis/Builder.lean`.

**Binder annotations (tasks #142, #203, #205).**  A pin carries no
binder name and no binder info — `Expr` has neither field (task #205),
so `propext`'s `{a b : Prop}` and `Classical.choice`'s `{α}` are
`pi`/`piI` for the reader only.  Binders carry no datum either (task
`Expr.ErasedEq` — the model's "same denotation" relation, up to `fvar`
type annotations — bridges a hit.
-/

namespace ConLeche

open Name (anonymous)
open BasisDSL

/-- The name `propext`. -/
def propextName : Name := anonymous |>.str "propext"

/-- The name `Classical.choice`. -/
def choiceName : Name := (anonymous |>.str "Classical") |>.str "choice"

/-- The name `Iff`. -/
def iffName : Name := anonymous |>.str "Iff"

/-- The name `Iff.intro`. -/
def iffIntroName : Name := iffName |>.str "intro"

/-- The name `Iff.rec`. -/
def iffRecName : Name := iffName |>.str "rec"

/-- The name `Nonempty`. -/
def nonemptyName : Name := anonymous |>.str "Nonempty"

/-- The name `Nonempty.intro`. -/
def nonemptyIntroName : Name := nonemptyName |>.str "intro"

/-- The name `Nonempty.rec`. -/
def nonemptyRecName : Name := nonemptyName |>.str "rec"

/-- Shape comparison for the standard pins: exact name, level
parameters and type.

**Guidance for anyone adding a pin.**  Two properties of a pin decide
how expensive it is for a *consumer* of the pin (the checker's own
soundness proofs, and the type-theory bridge of task #119):

* **Pin the level when the artifact only ever needs one.**  A pin that
  quantifies a level is more general, and that generality is paid for
  by every consumer: it must supply a level assignment and carry it
  through each application.  Measured instance —
  `Nonempty.rec`'s motive sort is pinned to `Prop` while
  `Iff.rec.{u_1,u}` quantifies its, and the bridge's `Iff` elimination
  needed a bespoke assignment driving `u_1` to `0` where the
  `Nonempty` one needed nothing at all.  *A pin that fixes a level is
  easier to consume than a pin that quantifies one, even when the
  quantified pin is more general.*
* **What this comparison forgives is what the interpretation ignores.**
  `matchesPin` accepts a stored type equal to the pin *up to binder
  names*, and neither the set model's `interp` nor
  `denote` reads a binder name — a binder is opened with a variable
  whose meaning is its de Bruijn index.  That alignment is why a
  `matchesPin` hit is usable at all: a consumer may compute on the
  *pin* rather than on whatever spelling the input stream sent.
  Preserve it — a pin comparison must never forgive something the
  interpretation reads.

**The comparison is plain equality** (task #342): `Expr` carries no
binder name, no binder info and no binder datum, so nothing is left to
forgive.  `Expr`'s `==` is the memoised, pointer-first `Expr.beq`, so a
DAG-shared stream side is compared without unfolding it (the
`tests/e2e/tower_axiom_pin.ndjson` shape, task #226). -/
def ConstantVal.matchesPin (cv pin : ConstantVal) : Bool :=
  cv.name = pin.name && cv.levelParams = pin.levelParams &&
    cv.type == pin.type

/-- `Iff (a b : Prop) : Prop`. -/
def iffA : ConstantInfo :=
  .indInfo ⟨iffName, [], pi "a" prop <| pi "b" prop prop⟩ {}

/-- `Iff.intro (a b : Prop) (mp : a → b) (mpr : b → a) : Iff a b`. -/
def iffIntroA : ConstantInfo :=
  .ctorInfo ⟨iffIntroName, [],
    pi "a" prop <|
    pi "b" prop <|
    pi "mp" (piA (bv 1) (bv 1)) <|
    pi "mpr" (piA (bv 1) (bv 3)) <|
    ap2 (cnst iffName) (bv 3) (bv 2)⟩
    2 2 iffName

/-- `Iff.rec`'s minor premise, in the `a`/`b`/`motive` binder context:
`∀ (mp : a → b) (mpr : b → a), motive (Iff.intro a b mp mpr)`. -/
def iffRecIntro : Expr :=
  pi "mp" (pi "right" (bv 2) (bv 2)) <|
  pi "mpr" (piA (bv 2) (bv 4)) <|
  .app (bv 2) (ap4 (cnst iffIntroName) (bv 4) (bv 3) (bv 1) (bv 0))

/-- `Iff.rec.{u} (a b : Prop) (motive : Iff a b → Sort u)
(intro : ∀ mp mpr, motive (Iff.intro a b mp mpr)) (t : Iff a b) :
motive t`. -/
def iffRecA : ConstantInfo :=
  .recInfo ⟨iffRecName, [uN],
    pi "a" prop <|
    pi "b" prop <|
    pi "motive" (pi "t" (ap2 (cnst iffName) (bv 1) (bv 0)) (srt u)) <|
    pi "intro" iffRecIntro <|
    pi "t" (ap2 (cnst iffName) (bv 3) (bv 2)) (.app (bv 2) (bv 0))⟩
    4 4 false []

/-- The raw `propext` declaration:
`propext (a b : Prop) : Iff a b → Eq.{1} Prop a b`. -/
def propextA : ConstantVal :=
  ⟨propextName, [],
    pi "a" prop <|
    pi "b" prop <|
    piA (ap2 (cnst iffName) (bv 1) (bv 0)) <|
    ap3 (cnst eqName [.succ .zero]) prop (bv 2) (bv 1)⟩

/-- `Nonempty.{u} (α : Sort u) : Prop`. -/
def nonemptyA : ConstantInfo :=
  .indInfo ⟨nonemptyName, [uN], pi "α" (srt u) prop⟩ {}

/-- `Nonempty.intro.{u} (α : Sort u) (val : α) : Nonempty α`. -/
def nonemptyIntroA : ConstantInfo :=
  .ctorInfo ⟨nonemptyIntroName, [uN],
    pi "α" (srt u) <|
    pi "val" (bv 0) <|
    .app (cnst nonemptyName [u]) (bv 1)⟩
    1 1 nonemptyName

/-- `Nonempty.rec.{u} (α : Sort u) (motive : Nonempty α → Prop)
(intro : ∀ val, motive (Nonempty.intro α val)) (t : Nonempty α) :
motive t`.  The motive sort is pinned to `Prop` (see the guidance
above). -/
def nonemptyRecA : ConstantInfo :=
  .recInfo ⟨nonemptyRecName, [uN],
    pi "α" (srt u) <|
    pi "motive" (pi "t" (.app (cnst nonemptyName [u]) (bv 0)) prop) <|
    pi "intro"
      (pi "val" (bv 1) <|
        .app (bv 1) (ap2 (cnst nonemptyIntroName [u]) (bv 2) (bv 0))) <|
    pi "t" (.app (cnst nonemptyName [u]) (bv 2)) (.app (bv 2) (bv 0))⟩
    3 3 false []

/-- The raw `Classical.choice` declaration:
`Classical.choice.{u} (α : Sort u) : Nonempty α → α`. -/
def choiceA : ConstantVal :=
  ⟨choiceName, [uN],
    pi "α" (srt u) <|
    piA (.app (cnst nonemptyName [u]) (bv 0)) (bv 1)⟩

/-- Is this checked axiom one of the two recognized standard axioms,
over standardly-shaped stored `Iff` / `Nonempty` families (and the
pinned `Eq` basis)?  A pure predicate so the checker's `axiomDecl`
arm stays a single conditional.

**Why all three of the family's constants are pinned, not just the
type.**  The verification has to *realize* the axiom, and the two
spellings differ: the checker's `propext` takes `Iff a b`, while the
declarative layer's takes the two implications separately
(`ConLeche/Term/Const.lean`).  Bridging them needs the implications
extracted from the `Iff` — and **nothing in the layer turns an
inhabitant of an opaque family into its fields except that family's own
recursor**.  So `Iff.rec` (resp. `Nonempty.rec`) has to be pinned
alongside the type, and `Iff.intro` (resp. `Nonempty.intro`) with it,
because the recursor's minor premise is stated at the constructor.
Only the recursors' *types* are used — never their reduction rules
(DESIGN.md, task #209).  This is the reason the pins are right. -/
def stdAxiomOk (env : Env) (cv : ConstantVal) : Bool :=
  if cv.name = propextName then
    (env.find? eqName).isSome &&
    (match env.find? iffName with
     | some (.indInfo cvI _) => ConstantVal.matchesPin cvI iffA.toConstantVal
     | _ => false) &&
    (match env.find? iffIntroName with
     | some (.ctorInfo cvIi 2 2 _) =>
       ConstantVal.matchesPin cvIi iffIntroA.toConstantVal
     | _ => false) &&
    (match env.find? iffRecName with
     | some (.recInfo cvIr 4 4 _ _) =>
       ConstantVal.matchesPin cvIr iffRecA.toConstantVal
     | _ => false) &&
    ConstantVal.matchesPin cv propextA
  else if cv.name = choiceName then
    (match env.find? nonemptyName with
     | some (.indInfo cvN _) =>
       ConstantVal.matchesPin cvN nonemptyA.toConstantVal
     | _ => false) &&
    (match env.find? nonemptyIntroName with
     | some (.ctorInfo cvNi 1 1 _) =>
       ConstantVal.matchesPin cvNi nonemptyIntroA.toConstantVal
     | _ => false) &&
    (match env.find? nonemptyRecName with
     | some (.recInfo cvNr 3 3 _ _) =>
       ConstantVal.matchesPin cvNr nonemptyRecA.toConstantVal
     | _ => false) &&
    ConstantVal.matchesPin cv choiceA
  else false

end ConLeche

end
-- ===== ConLeche.Kernel.TypeChecker (57 lines) =====
section
-- E1: module

-- E1: public import ConLeche.Kernel.Core

-- E1: @[expose] public section

/-!

The core bodies (`ConLeche.Kernel.Core`) tied together at `CheckM`, with
no memoization: this instance is the **specification** — all semantic
verification (`ConLeche/Verify/*`, `ConLeche/Semantics/*`, `ConLeche/Model/*`)
reasons about these
fueled entry points, and the refinement bridge (see DESIGN.md) carries
every claim over to the cached instance the checker executes
(`ConLeche.Cached.CoreC`).
-/

namespace ConLeche

variable (mode : CheckMode) (eager : Bool)

/-- The pure core: the bodies tied at `CheckM`, fuel in the knot. -/
def pureFns (env : Env) : Nat → CoreFns CheckM :=
  coreKnot mode eager env id

/-- Head normalization without delta (fueled); `cheap` is the official
kernel's `cheap_proj` (`whnfCoreBody`), off by default. -/
def whnfCore (env : Env) (fuel depth : Nat) (e : Expr) (cheap : Bool := false) :
    CheckM Expr :=
  (pureFns mode eager env fuel).whnfCore cheap depth e

/-- The full reduction loop (fueled). -/
def whnf (env : Env) (fuel depth : Nat) (e : Expr) : CheckM Expr :=
  (pureFns mode eager env fuel).whnf depth e

/-- Full-grade type inference (fueled): the declaration front door's
entry — official's `infer_type_core(e, infer_only = false)`. -/
def inferTypeCore (env : Env) (fuel depth : Nat) (e : Expr) : CheckM Expr :=
  (pureFns mode eager env fuel).infer depth e

/-- Type inference at the io grade (fueled): the knot's `inferIO` slot
— what every internal inference call site runs (task #170).  At every
mode it is the io lane (`inferTypeIO_on`, `Verify/Knot.lean`). -/
def inferTypeIO (env : Env) (fuel depth : Nat) (e : Expr) : CheckM Expr :=
  (pureFns mode eager env fuel).inferIO depth e

/-- Definitional equality (fueled). -/
def isDefEqCore (env : Env) (fuel depth : Nat) (a b : Expr) : CheckM Bool :=
  (pureFns mode eager env fuel).defeq depth a b

/-- `ensureSort` over the pure knot (fueled). -/
def ensureSortCore (env : Env) (fuel depth : Nat) (e : Expr) : CheckM Level :=
  ensureSort (pureFns mode eager env fuel) env depth e

end ConLeche

end
-- ===== ConLeche.Kernel.NatOpPinSet (71 lines) =====
section
-- E1: module
-- E1: public import ConLeche.Kernel.Expr

-- E1: @[expose] public section

/-!

A **pin variant**: the pinned defining expressions and certificate
proof blobs of the eight pin-certified `Nat` operations as ONE
toolchain's generator produced them (`pins/<toolchain>.json`, see
`pins/README.md`).  `ConLeche/Kernel/NatOpPins.lean` splices one such
record per committed dump and lists them in `natOpPinSets`; the install
gate (`checkDivModPin`, `ConLeche/Kernel/Checker.lean`) tries the
variants of the list it is **given** — a parameter threaded from the
fold since task #304, `natOpPinSets` in the shipped checker — in that
order, and enables the operation's literal fast path on the first
whose guards pass, whose pin is definitionally equal to the stream's
stored value and whose certificates check.  Before that comparison
the gate checks the variant's **type pins** (task #364): for each
operation, the toolchain's types of the few constants its certificates
use whose types differ between supported toolchains (`Decidable.rec`
and `Decidable.casesOn`, rewritten when `Decidable` became a
structure), so that a variant whose certificates would be ill-typed
against the stream is recognised by a boolean comparison before they
are checked.

The record is data the checker reads; the model never inspects a pin
or a proof blob (the certificate *statements* it consumes are
hand-pinned in `Checker.lean` and shared by every variant).
-/

namespace ConLeche

/-- The pins of one toolchain: eight pinned defining expressions and
eight certificate-proof lists and eight type-pin lists, in the order of
