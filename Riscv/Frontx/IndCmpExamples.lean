/- Conditionals and comparisons over user inductives (`frontx_ind` with `E.ite`, NOTES section 19): library and
example code copied verbatim (provenance per block), each with a generated `Implements1` theorem.

A comparison of `Nat`s does not commute with the cells' words (`Nat` fields are stored mod `2^64`), so the theorems
of functions that compare `Nat`s take their input in the subtype `{t // T.small t}` (every `Nat` field below
`2^64`, generated by `frontx_ind_type`): the range hypothesis is part of the statement. -/
import Riscv.Frontx.IndExamples

/-! ## Lean 4 v4.29.0 `doc/examples/bintree.lean` (binary search trees) -/

namespace Proven.Frontx.IndCmp

-- doc/examples/bintree.lean:18-21
inductive Tree (β : Type v) where
  | leaf
  | node (left : Tree β) (key : Nat) (value : β) (right : Tree β)
  deriving Repr

-- doc/examples/bintree.lean:26-35
def Tree.contains (t : Tree β) (k : Nat) : Bool :=
  match t with
  | leaf => false
  | node left key value right =>
    if k < key then
      left.contains k
    else if key < k then
      right.contains k
    else
      true

-- doc/examples/bintree.lean:54-63
def Tree.insert (t : Tree β) (k : Nat) (v : β) : Tree β :=
  match t with
  | leaf => node leaf k v leaf
  | node left key value right =>
    if k < key then
      node (left.insert k v) key value right
    else if key < k then
      node left key value (right.insert k v)
    else
      node left k v right

-- the values are `Unit` (a set of keys): the `value` field is not in the byte format
frontx_ind_type TU := Tree Unit

/-- entry: is the key `5` in the tree -/
def contains5 (t : Tree Unit) : Bool := t.contains 5
/-- entry: insert the key `5` -/
def insert5 (t : Tree Unit) : Tree Unit := t.insert 5 ()

frontx_ind contains5 on TU
frontx_ind insert5 on TU

/-! ## Lean 4 v4.29.0 core, `Init/Data/List/Basic.lean` (`BEq` on `Nat`) -/

frontx_ind_type LN := List Nat

/-- entry: `List.elem` (`Init/Data/List/Basic.lean:785`) -/
def elem5 (xs : List Nat) : Bool := List.elem 5 xs
/-- entry: `List.erase` (`Init/Data/List/Basic.lean:1511`) -/
def erase5 (xs : List Nat) : List Nat := List.erase xs 5

frontx_ind elem5 on LN
frontx_ind erase5 on LN

end Proven.Frontx.IndCmp

/-! ## enumerations: fp-lean @0abeea5 `Weekday`, Lean 4 v4.29.0 core `Ordering` -/

namespace Proven.Frontx.IndCmp

-- examples/Examples/Monads/Conveniences.lean:71-79
inductive Weekday where
  | monday
  | tuesday
  | wednesday
  | thursday
  | friday
  | saturday
  | sunday
deriving Repr

namespace A
-- examples/Examples/Monads/Conveniences.lean:85-89
def Weekday.isWeekend (day : Weekday) : Bool :=
  match day with
  | Weekday.saturday => true
  | Weekday.sunday => true
  | _ => false
end A

namespace B
-- examples/Examples/Monads/Conveniences.lean:94-98
def Weekday.isWeekend (day : Weekday) : Bool :=
  match day with
  | .saturday => true
  | .sunday => true
  | _ => false
end B

frontx_ind_type WD := Weekday
frontx_ind A.Weekday.isWeekend on WD
frontx_ind B.Weekday.isWeekend on WD

-- core `Init/Data/Ord/Basic.lean`: `swap` (:45), `then` (:100, two inputs), `isLE` (:123), `isEq` (:107)
frontx_ind_type OrdT := Ordering
frontx_ind Ordering.swap on OrdT
frontx_ind Ordering.then on OrdT
frontx_ind Ordering.isLE on OrdT
frontx_ind Ordering.isEq on OrdT

end Proven.Frontx.IndCmp
