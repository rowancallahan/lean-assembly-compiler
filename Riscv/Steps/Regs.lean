/- The integer register file as a function `Fin 32 → BitVec 64`, with insert lemmas. -/
import Spec.Riscv
open LeanRV64D LeanRV64D.Functions Sail Sail.ConcurrencyInterfaceV1

set_option linter.unusedSimpArgs false

namespace Proven

abbrev Regs := Std.ExtDHashMap Register RegisterType

def xregs : List Register := [.x1, .x2, .x3, .x4, .x5, .x6, .x7, .x8, .x9, .x10, .x11, .x12, .x13, .x14, .x15, .x16, .x17, .x18, .x19, .x20, .x21, .x22, .x23, .x24, .x25, .x26, .x27, .x28, .x29, .x30, .x31]

/-- `x[i]` of a register map (`x0 = 0`; a missing register reads as `0`). -/
def xval (m : Regs) : Fin 32 → BitVec 64
  | 0 => 0
  | 1 => (m.get? .x1).getD 0
  | 2 => (m.get? .x2).getD 0
  | 3 => (m.get? .x3).getD 0
  | 4 => (m.get? .x4).getD 0
  | 5 => (m.get? .x5).getD 0
  | 6 => (m.get? .x6).getD 0
  | 7 => (m.get? .x7).getD 0
  | 8 => (m.get? .x8).getD 0
  | 9 => (m.get? .x9).getD 0
  | 10 => (m.get? .x10).getD 0
  | 11 => (m.get? .x11).getD 0
  | 12 => (m.get? .x12).getD 0
  | 13 => (m.get? .x13).getD 0
  | 14 => (m.get? .x14).getD 0
  | 15 => (m.get? .x15).getD 0
  | 16 => (m.get? .x16).getD 0
  | 17 => (m.get? .x17).getD 0
  | 18 => (m.get? .x18).getD 0
  | 19 => (m.get? .x19).getD 0
  | 20 => (m.get? .x20).getD 0
  | 21 => (m.get? .x21).getD 0
  | 22 => (m.get? .x22).getD 0
  | 23 => (m.get? .x23).getD 0
  | 24 => (m.get? .x24).getD 0
  | 25 => (m.get? .x25).getD 0
  | 26 => (m.get? .x26).getD 0
  | 27 => (m.get? .x27).getD 0
  | 28 => (m.get? .x28).getD 0
  | 29 => (m.get? .x29).getD 0
  | 30 => (m.get? .x30).getD 0
  | _ => (m.get? .x31).getD 0

/-- write `x[i]` (writes to `x0` are dropped) -/
def xset (m : Regs) : Fin 32 → BitVec 64 → Regs
  | 0, _ => m
  | 1, v => m.insert .x1 v
  | 2, v => m.insert .x2 v
  | 3, v => m.insert .x3 v
  | 4, v => m.insert .x4 v
  | 5, v => m.insert .x5 v
  | 6, v => m.insert .x6 v
  | 7, v => m.insert .x7 v
  | 8, v => m.insert .x8 v
  | 9, v => m.insert .x9 v
  | 10, v => m.insert .x10 v
  | 11, v => m.insert .x11 v
  | 12, v => m.insert .x12 v
  | 13, v => m.insert .x13 v
  | 14, v => m.insert .x14 v
  | 15, v => m.insert .x15 v
  | 16, v => m.insert .x16 v
  | 17, v => m.insert .x17 v
  | 18, v => m.insert .x18 v
  | 19, v => m.insert .x19 v
  | 20, v => m.insert .x20 v
  | 21, v => m.insert .x21 v
  | 22, v => m.insert .x22 v
  | 23, v => m.insert .x23 v
  | 24, v => m.insert .x24 v
  | 25, v => m.insert .x25 v
  | 26, v => m.insert .x26 v
  | 27, v => m.insert .x27 v
  | 28, v => m.insert .x28 v
  | 29, v => m.insert .x29 v
  | 30, v => m.insert .x30 v
  | _, v => m.insert .x31 v

def getX (s : St) (i : Fin 32) : BitVec 64 := xval s.regs i
def setX (s : St) (i : Fin 32) (v : BitVec 64) : St := { s with regs := xset s.regs i v }
@[simp] theorem getX_eq (s : St) (i : Fin 32) : getX s i = xval s.regs i := rfl

theorem xval_insert_other {m : Regs} {r : Register} {v} (hr : r ∉ xregs) (j : Fin 32) :
    xval (m.insert r v) j = xval m j := by
  simp only [xregs, List.mem_cons, not_or] at hr
  obtain ⟨h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11, h12, h13, h14, h15, h16, h17, h18, h19, h20, h21, h22, h23, h24, h25, h26, h27, h28, h29, h30, h31, -⟩ := hr
  match j with
  | 0 => rfl
  | 1 => simp [xval, Std.ExtDHashMap.get?_insert, h1]
  | 2 => simp [xval, Std.ExtDHashMap.get?_insert, h2]
  | 3 => simp [xval, Std.ExtDHashMap.get?_insert, h3]
  | 4 => simp [xval, Std.ExtDHashMap.get?_insert, h4]
  | 5 => simp [xval, Std.ExtDHashMap.get?_insert, h5]
  | 6 => simp [xval, Std.ExtDHashMap.get?_insert, h6]
  | 7 => simp [xval, Std.ExtDHashMap.get?_insert, h7]
  | 8 => simp [xval, Std.ExtDHashMap.get?_insert, h8]
  | 9 => simp [xval, Std.ExtDHashMap.get?_insert, h9]
  | 10 => simp [xval, Std.ExtDHashMap.get?_insert, h10]
  | 11 => simp [xval, Std.ExtDHashMap.get?_insert, h11]
  | 12 => simp [xval, Std.ExtDHashMap.get?_insert, h12]
  | 13 => simp [xval, Std.ExtDHashMap.get?_insert, h13]
  | 14 => simp [xval, Std.ExtDHashMap.get?_insert, h14]
  | 15 => simp [xval, Std.ExtDHashMap.get?_insert, h15]
  | 16 => simp [xval, Std.ExtDHashMap.get?_insert, h16]
  | 17 => simp [xval, Std.ExtDHashMap.get?_insert, h17]
  | 18 => simp [xval, Std.ExtDHashMap.get?_insert, h18]
  | 19 => simp [xval, Std.ExtDHashMap.get?_insert, h19]
  | 20 => simp [xval, Std.ExtDHashMap.get?_insert, h20]
  | 21 => simp [xval, Std.ExtDHashMap.get?_insert, h21]
  | 22 => simp [xval, Std.ExtDHashMap.get?_insert, h22]
  | 23 => simp [xval, Std.ExtDHashMap.get?_insert, h23]
  | 24 => simp [xval, Std.ExtDHashMap.get?_insert, h24]
  | 25 => simp [xval, Std.ExtDHashMap.get?_insert, h25]
  | 26 => simp [xval, Std.ExtDHashMap.get?_insert, h26]
  | 27 => simp [xval, Std.ExtDHashMap.get?_insert, h27]
  | 28 => simp [xval, Std.ExtDHashMap.get?_insert, h28]
  | 29 => simp [xval, Std.ExtDHashMap.get?_insert, h29]
  | 30 => simp [xval, Std.ExtDHashMap.get?_insert, h30]
  | ⟨k+31, _⟩ => simp [xval, Std.ExtDHashMap.get?_insert, h31]

