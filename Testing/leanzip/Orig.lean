namespace Orig

namespace Adler32.Spec

-- Zip/Spec/Adler32.lean:19-20 @7e10583
/-- The Adler-32 modulus: largest prime less than 2^16. -/
def MOD_ADLER : Nat := 65521

-- Zip/Spec/Adler32.lean:22-23 @7e10583
/-- The two components of an Adler-32 state: (A, B). -/
abbrev State := Nat × Nat

-- Zip/Spec/Adler32.lean:25-26 @7e10583
/-- Initial Adler-32 state: A = 1, B = 0. -/
def init : State := (1, 0)

-- Zip/Spec/Adler32.lean:28-32 @7e10583
/-- Process a single byte, updating the Adler-32 state. -/
def updateByte (s : State) (byte : UInt8) : State :=
  let a := (s.1 + byte.toNat) % MOD_ADLER
  let b := (s.2 + a) % MOD_ADLER
  (a, b)

-- Zip/Spec/Adler32.lean:38-40 @7e10583
/-- Pack the state into a `UInt32`: `(B <<< 16) ||| A`. -/
def pack (s : State) : UInt32 :=
  (UInt32.ofNat s.2 <<< 16) ||| UInt32.ofNat s.1

-- Zip/Spec/Adler32.lean:46-48 @7e10583
/-- Unpack a `UInt32` into Adler-32 state: `(A, B)`. -/
def unpack (v : UInt32) : State :=
  (v.toNat % 65536, v.toNat / 65536)
end Adler32.Spec

namespace Adler32.Native

-- Zip/Native/Adler32.lean:12-14 @7e10583
/-- Process a `ByteArray`, updating the Adler-32 state. -/
def updateBytes (s : Spec.State) (data : ByteArray) : Spec.State :=
  data.data.foldl Spec.updateByte s

-- Zip/Native/Adler32.lean:16-20 @7e10583
/-- Compute Adler-32 of an entire `ByteArray`. -/
def adler32 (init : UInt32 := 1) (data : ByteArray) : UInt32 :=
  let s := Spec.unpack init
  let s' := updateBytes s data
  Spec.pack s'
end Adler32.Native

namespace Crc32.Spec

-- Zip/Spec/Crc32.lean:24-25 @7e10583
/-- The CRC-32 polynomial (bit-reversed). -/
def POLY : UInt32 := 0xEDB88320

-- Zip/Spec/Crc32.lean:27-34 @7e10583
/-- Process one bit of a CRC-32 computation.
    If the LSB is 1, shift right and XOR with the polynomial.
    Otherwise, just shift right. -/
def crcBit (crc : UInt32) : UInt32 :=
  if crc &&& 1 == 1 then
    (crc >>> 1) ^^^ POLY
  else
    crc >>> 1

-- Zip/Spec/Crc32.lean:36-39 @7e10583
/-- Process one byte by XORing it into the CRC and processing 8 bits. -/
def crcByte (crc : UInt32) (byte : UInt8) : UInt32 :=
  let crc := crc ^^^ UInt32.ofNat byte.toNat
  crcBit (crcBit (crcBit (crcBit (crcBit (crcBit (crcBit (crcBit crc)))))))

-- Zip/Spec/Crc32.lean:77-81 @7e10583
/-- The CRC-32 lookup table: precomputed CRC for each byte value 0..255. -/
def mkTable : Array UInt32 :=
  Array.ofFn fun (i : Fin 256) =>
    let crc := UInt32.ofNat i.val
    crcBit (crcBit (crcBit (crcBit (crcBit (crcBit (crcBit (crcBit crc)))))))

-- Zip/Spec/Crc32.lean:83-89 @7e10583
/-- Table-driven single-byte CRC update. -/
def crcByteTable (table : Array UInt32) (crc : UInt32) (byte : UInt8) : UInt32 :=
  let index := ((crc ^^^ UInt32.ofNat byte.toNat) &&& 0xFF).toNat
  if h : index < table.size then
    (crc >>> 8) ^^^ table[index]
  else
    crc -- unreachable for a 256-entry table
end Crc32.Spec

namespace Crc32.Native

-- Zip/Native/Crc32.lean:13-14 @7e10583
/-- Precomputed CRC-32 lookup table (256 entries). -/
def table : Array UInt32 := Spec.mkTable

-- Zip/Native/Crc32.lean:16-18 @7e10583
/-- Process a `ByteArray` using the table-driven algorithm. -/
def updateBytes (crc : UInt32) (data : ByteArray) : UInt32 :=
  data.data.foldl (Spec.crcByteTable table) crc

-- Zip/Native/Crc32.lean:20-25 @7e10583
/-- Compute CRC-32 of a `ByteArray`.
    Matches the zlib API: `init = 0` starts a fresh checksum. -/
def crc32 (init : UInt32 := 0) (data : ByteArray) : UInt32 :=
  let raw := if init == 0 then 0xFFFFFFFF else init ^^^ 0xFFFFFFFF
  let result := updateBytes raw data
  result ^^^ 0xFFFFFFFF
end Crc32.Native

namespace ZipCommon

-- ZipCommon/BitReader.lean (lean-zip-common):10-13 @7e10583
structure BitReader where
  data : ByteArray
  pos : Nat       -- byte position
  bitOff : Nat    -- bit offset within current byte (0 = LSB)
namespace BitReader

-- ZipCommon/BitReader.lean (lean-zip-common):16-26
/-- Read a single bit. Returns (bit, updatedReader). -/
def readBit (br : BitReader) : Except String (UInt32 × BitReader) :=
  if br.pos ≥ br.data.size then
    .error "BitReader: unexpected end of input"
  else
    let byte := br.data[br.pos]!
    let bit : UInt32 := ((byte.toUInt32 >>> br.bitOff.toUInt32) &&& 1)
    if br.bitOff + 1 ≥ 8 then
      .ok (bit, { br with pos := br.pos + 1, bitOff := 0 })
    else
      .ok (bit, { br with bitOff := br.bitOff + 1 })

-- ZipCommon/BitReader.lean (lean-zip-common):28-36
/-- Read `n` bits (n ≤ 25), LSB first. Returns the value as UInt32. -/
def readBits (br : BitReader) (n : Nat) : Except String (UInt32 × BitReader) :=
  go br 0 0 n
where
  go (br : BitReader) (acc : UInt32) (shift : Nat) : Nat → Except String (UInt32 × BitReader)
    | 0 => .ok (acc, br)
    | k + 1 => do
      let (bit, br') ← br.readBit
      go br' (acc ||| (bit <<< shift.toUInt32)) (shift + 1) k

-- ZipCommon/BitReader.lean (lean-zip-common):38-41
/-- Align to the next byte boundary. Discards remaining bits in the current byte. -/
def alignToByte (br : BitReader) : BitReader :=
  if br.bitOff == 0 then br
  else { br with pos := br.pos + 1, bitOff := 0 }

-- ZipCommon/BitReader.lean (lean-zip-common):43-51
/-- Read a UInt16 in little-endian from the byte-aligned position. -/
def readUInt16LE (br : BitReader) : Except String (UInt16 × BitReader) :=
  let br := br.alignToByte
  if br.pos + 2 > br.data.size then
    .error "BitReader: unexpected end of input reading UInt16"
  else
    let lo := br.data[br.pos]!.toUInt16
    let hi := br.data[br.pos + 1]!.toUInt16
    .ok (lo ||| (hi <<< 8), { br with pos := br.pos + 2 })

-- ZipCommon/BitReader.lean (lean-zip-common):53-59
/-- Read `n` bytes from byte-aligned position. -/
def readBytes (br : BitReader) (n : Nat) : Except String (ByteArray × BitReader) :=
  let br := br.alignToByte
  if br.pos + n > br.data.size then
    .error "BitReader: unexpected end of input reading bytes"
  else
    .ok (br.data.extract br.pos (br.pos + n), { br with pos := br.pos + n })
end BitReader
end ZipCommon

namespace Zip.Native
open ZipCommon (BitReader)

-- Zip/Native/Inflate.lean:21-41 @7e10583
/-- Allocation-light `BitReader.readBits`: thread the cursor `(pos, bitOff)` as
    unboxed `Nat`s and build the `BitReader` struct **once** at the end, instead
    of allocating a fresh `BitReader` (+ `Except`/pair) on every bit as the
    `readBit`-looping `BitReader.readBits` does. Same per-bit byte reads, but a
    whole `n`-bit field now costs O(1) heap allocations instead of O(n). Proven
    equal to `BitReader.readBits` (`readBitsFast_eq`); used on the hot
    extra-bits path in `decodeHuffmanFast`. -/
def readBitsFast (br : BitReader) (n : Nat) : Except String (UInt32 × BitReader) :=
  go br.pos br.bitOff 0 0 n
where
  go (pos bitOff : Nat) (acc : UInt32) (shift : Nat) :
      Nat → Except String (UInt32 × BitReader)
    | 0 => .ok (acc, { br with pos := pos, bitOff := bitOff })
    | k + 1 =>
      if h : pos ≥ br.data.size then .error "BitReader: unexpected end of input"
      else
        let bit : UInt32 := (((br.data[pos]'(by omega)).toUInt32 >>> bitOff.toUInt32) &&& 1)
        if bitOff + 1 ≥ 8 then
          go (pos + 1) 0 (acc ||| (bit <<< shift.toUInt32)) (shift + 1) k
        else
          go pos (bitOff + 1) (acc ||| (bit <<< shift.toUInt32)) (shift + 1) k

-- Zip/Native/Inflate.lean:43-48 @7e10583
/-- A Huffman tree for decoding DEFLATE symbols.
    Leaf holds a symbol value; Node branches on 0 (left) vs 1 (right). -/
inductive HuffTree where
  | leaf (symbol : UInt16)
  | node (zero : HuffTree) (one : HuffTree)
  | empty

namespace HuffTree

-- Zip/Native/Inflate.lean:140-144 @7e10583
/-- Number of bits the fast decode table indexes on (the common "fast bits").
    Widened to libdeflate's `LITLEN_TABLEBITS = 11`: fewer codewords spill to the
    slow/subtable path, and the canonical O(2^bits) table build (#2671) keeps the
    wider table cheap to construct. -/
def fastBits : Nat := 11

-- Zip/Native/Inflate.lean:190-191 @7e10583
@[inline] def packEntry (sym : UInt16) (len : UInt8) : UInt32 :=
  len.toUInt32 ||| (sym.toUInt32 <<< 8)

-- Zip/Native/Inflate.lean:193-194 @7e10583
/-- The symbol field (bits 8–23) of a packed entry. -/
@[inline] def unpackSym (e : UInt32) : UInt16 := (e >>> 8).toUInt16

-- Zip/Native/Inflate.lean:196-198 @7e10583
/-- The codeword-length field (low byte) of a packed entry. Shift-free so it stays
    inert under the `whnf` the well-founded recursions force (see `packEntry`). -/
@[inline] def unpackLen (e : UInt32) : UInt8 := e.toUInt8

-- Zip/Native/Inflate.lean:221-222 @7e10583
structure DecodeTable where
  packed : Array UInt32

-- Zip/Native/Inflate.lean:224-229 @7e10583
/-- The codeword length of slot `idx`: the low byte of the packed entry. One
    scalar-array read plus a width truncation (no shift — see `packEntry` for why
    the length is the low byte, so this stays inert under the well-founded
    recursions' `whnf`). -/
@[inline] def DecodeTable.lenAt (t : DecodeTable) (idx : Nat) : UInt8 :=
  if h : idx < t.packed.size then unpackLen (t.packed[idx]'h) else 0

-- Zip/Native/Inflate.lean:231-235 @7e10583
/-- The symbol of slot `idx`: bits 8–23 of the packed entry. One scalar-array read
    plus a shift; the symbol never enters a termination measure, so the shift is
    never `whnf`-forced. -/
@[inline] def DecodeTable.symAt (t : DecodeTable) (idx : Nat) : UInt16 :=
  if h : idx < t.packed.size then unpackSym (t.packed[idx]'h) else 0
end HuffTree

namespace InflateBuf
open ZipCommon (BitReader)

-- Zip/Native/Inflate.lean:1149-1165 @7e10583
/-- Bit-by-bit tree walk over the buffer (fallback for codes longer than the
    11-bit table or near end-of-input). Mirrors `HuffTree.decode.go` exactly
    (same `depth > 20` guard, same error strings), so it is provably equal;
    `depth` is the tree-walk depth. Returns the symbol, the remaining buffer,
    and the number of bits consumed. -/
def walkTree (t : HuffTree) (bitBuf : UInt64) (cnt depth : Nat) :
    Except String (UInt16 × UInt64 × Nat × Nat) :=
  match t with
  | .leaf s => .ok (s, bitBuf, cnt, 0)
  | .empty => .error "Inflate: invalid Huffman code"
  | .node z o =>
    if depth > 20 then .error "Inflate: Huffman decode exceeded max depth"
    else if cnt = 0 then .error "BitReader: unexpected end of input"
    else
      match walkTree (if bitBuf &&& 1 == 0 then z else o) (bitBuf >>> 1) (cnt - 1) (depth + 1) with
      | .error e => .error e
      | .ok (s, bb, c, used) => .ok (s, bb, c, used + 1)

-- Zip/Native/Inflate.lean:1167-1175 @7e10583
/-- Decode one Huffman symbol from the (refilled) buffer via the 11-bit table,
    falling back to the tree walk for long codes / near EOF. Returns the symbol,
    remaining buffer state, and bits consumed. -/
@[inline] def decodeSym (tree : HuffTree) (table : HuffTree.DecodeTable)
    (bitBuf : UInt64) (cnt : Nat) : Except String (UInt16 × UInt64 × Nat × Nat) :=
  let idx := (bitBuf &&& 0x7FF).toNat
  let len := (table.lenAt idx).toNat
  if len == 0 || len > cnt then walkTree tree bitBuf cnt 0
  else .ok (table.symAt idx, bitBuf >>> len.toUInt64, cnt - len, len)

-- Zip/Native/Inflate.lean:1177-1184 @7e10583
/-- Read `n` bits LSB-first from the buffer without refilling. Errors (like
    `readBitsFast`) when the buffer holds fewer than `n` bits — for a refilled
    buffer this only fires at true end-of-input on a truncated stream. -/
@[inline] def takeBits (bitBuf : UInt64) (cnt n : Nat) : Except String (Nat × UInt64 × Nat) :=
  if n > cnt then .error "BitReader: unexpected end of input"
  else
    let v := (bitBuf &&& ((1 <<< n.toUInt64) - 1)).toNat
    .ok (v, bitBuf >>> n.toUInt64, cnt - n)
end InflateBuf

end Zip.Native

