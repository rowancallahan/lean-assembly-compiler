import Nano.Expr.ExprSpec
open ParSpec ExprSpec
/- usage: Testing/scripts/lean_run.sh Testing/nano/expr/gen_cdata.lean SRC NS > OUT.lean
Writes the def headers (`DefI` list) and the side flags of SRC as Lean data in namespace NS (for the kernel-checked
emitAll on C's AST, Nano/Expr/CExpr.lean). -/
def shS : Sh → String
  | .uw => ".uw" | .bf => ".bf" | .ls => ".ls" | .nt => ".nt" | .p a b => s!"(.p {shS a} {shS b})"
def psS : Ps → String | .inp => ".inp" | .fuel => ".fuel" | .sh s => s!"(.sh {shS s})"
def diS (d : DefI) : String := s!"⟨{d.name}, [{", ".intercalate (d.params.map psS)}], {shS d.res}, {d.resLst}, {d.npw}⟩"
def bl (l : List Bool) : String := s!"[{", ".intercalate (l.map toString)}]"
def main (args : List String) : IO Unit := do
  let src := (← IO.FS.readBinFile args[0]!).toList
  let some ws := lexAll (src.length + 1) src | throw (IO.userError "lex")
  let some toks := tokens ws | throw (IO.userError "tokens")
  let some (ds, _) := pDefs (8 * toks.length + 8) (toks.length + 1) [] toks | throw (IO.userError "parse")
  IO.println s!"/- GENERATED by Testing/nano/expr/gen_cdata.lean from {args[0]!}.  Do not edit. -/"
  IO.println "import Nano.Expr.ExprSpec"
  IO.println s!"namespace {args[1]!}\nopen ParSpec ExprSpec\n"
  IO.println s!"def ds : List DefI := [\n  {",\n  ".intercalate (ds.map diS)}]\n"
  IO.println s!"def st : Sd := ({bl (sideLets toks)},\n  {bl (sideNils toks)})\n"
  IO.println s!"end {args[1]!}"
