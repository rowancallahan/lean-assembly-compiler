import Nano.V2Self.Proof.ParSpec
open ParSpec
/- usage: lake env lean --run Testing/nano/v2self/srclink/gen.lean SRC OUTDIR GROUPTOKS
Regenerates the kernel-checked source link Nano/V2Self/Proof/Src/*.lean for the text SRC: the text is cut before each
line starting with `def`; per def i: its bytes x_i, words w_i (= lexAll x_i), tokens S_i (= tokens w_i), and the
reference parse step pDef F D_i T_i = (di_i, d_i, T_{i+1}).  Every piece is validated here before it is written. -/
partial def nd : Nd → String
  | .const v => s!"(.const {v})"
  | .loc s w => s!"(.loc {s} {w})"
  | .bin o a b => s!"(.bin {o} {nd a} {nd b})"
  | .ite c a b t e => s!"(.ite {c} {nd a} {nd b} {nd t} {nd e})"
  | .letE s w v b => s!"(.letE {s} {w} {nd v} {nd b})"
  | .pair cs => s!"(.pair [{", ".intercalate (cs.map nd)}])"
  | .call i as => s!"(.call {i} [{", ".intercalate (as.map nd)}])"
  | .prim p as => s!"(.prim {p} [{", ".intercalate (as.map nd)}])"
  | .loop z s => s!"(.loop {nd z} {nd s})"
  | .cont e => s!"(.cont {nd e})"
def shS : Sh → String
  | .uw => ".uw" | .bf => ".bf" | .ls => ".ls" | .nt => ".nt" | .p a b => s!"(.p {shS a} {shS b})"
def psS : Ps → String | .inp => ".inp" | .fuel => ".fuel" | .sh s => s!"(.sh {shS s})"
def diS (d : DefI) : String := s!"⟨{d.name}, [{", ".intercalate (d.params.map psS)}], {shS d.res}, {d.resLst}, {d.npw}⟩"
def daS (d : DefA) : String :=
  s!"\{ id := {d.id}, npw := {d.npw}, nslots := {d.nslots}, kind := {d.kind}, nres := {d.nres}, body := {nd d.body} }"
def tokS : Tok → String | .k t => s!"(.k {t})" | .num v => s!"(.num {v})" | .id n => s!"(.id {n})"
instance : Inhabited DefI := ⟨⟨[], [], .uw, false, 0⟩⟩
instance : Inhabited DefA := ⟨⟨0, 0, 0, 0, 0, .const 0⟩⟩
def lst {α} (f : α → String) (l : List α) : String := s!"[{",".intercalate (l.map f)}]"

/-- split after every newline that is followed by `def ` -/
def cut (b : List UInt8) : List (List UInt8) := Id.run do
  let arr := b.toArray
  let mut out : Array (List UInt8) := #[]
  let mut start := 0
  for i in [0:arr.size] do
    if arr[i]! == 10 && i + 4 < arr.size && arr[i+1]! == 100 && arr[i+2]! == 101 && arr[i+3]! == 102 && arr[i+4]! == 32 then
      out := out.push (arr.extract start (i + 1)).toList
      start := i + 1
  out := out.push (arr.extract start arr.size).toList
  return out.toList

def hdr (imports : List String) : String :=
  "/- GENERATED by Testing/nano/v2self/srclink/gen.lean.  Do not edit. -/\n" ++
  String.join (imports.map fun i => s!"import {i}\n") ++ "namespace SrcGen\nopen ParSpec SrcLink\n\n"

def main (args : List String) : IO Unit := do
  let src := (← IO.FS.readBinFile args[0]!).toList
  let out := args[1]!
  let gsz := args[2]!.toNat!
  let some ws := lexAll (src.length + 1) src | throw (IO.userError "lex REJECT")
  let some toks := tokens ws | throw (IO.userError "tokens REJECT")
  let F := 8 * toks.length + 8
  let xs := cut src
  -- per-chunk data, validated
  let mut defs : List DefI := []
  let mut rest := toks
  let mut rows : Array (List UInt8 × List UInt64 × List Tok × DefI × DefA) := #[]
  for x in xs do
    let some w := lexAll (x.length + 1) x | throw (IO.userError "chunk lex REJECT")
    let some S := tokens w | throw (IO.userError "chunk tokens REJECT")
    let some (di, da, r) := pDef F defs rest | throw (IO.userError "pDef REJECT")
    if rest.take (rest.length - r.length) != S then throw (IO.userError s!"segment mismatch at def {rows.size}")
    if r.length + S.length != rest.length then throw (IO.userError "segment length")
    rows := rows.push (x, w, S, di, da)
    defs := defs ++ [di]
    rest := r
  if rest != [] then throw (IO.userError "tokens left")
  if (xs.foldr (· ++ ·) []) != src then throw (IO.userError "cut does not cover the text")
  let n := rows.size
  -- groups by token count
  let mut groups : Array (Nat × Nat) := #[]
  let mut gs := 0
  let mut acc := 0
  for i in [0:n] do
    acc := acc + (rows[i]!.2.2.1).length
    if acc ≥ gsz || i + 1 = n then
      groups := groups.push (gs, i + 1); gs := i + 1; acc := 0
  -- data modules
  for gi in [0:groups.size] do
    let (a, b) := groups[gi]!
    let mut s := hdr ["Nano.V2Self.Proof.SrcLink"]
    for i in [a:b] do
      let (x, w, S, di, da) := rows[i]!
      s := s ++ s!"def x{i} : List UInt8 := {lst toString x}\n" ++ s!"def w{i} : List UInt64 := {lst toString w}\n" ++
        s!"def S{i} : List Tok := {lst tokS S}\n" ++ s!"def di{i} : DefI := {diS di}\n" ++ s!"def d{i} : DefA := {daS da}\n"
    IO.FS.writeFile s!"{out}/Data{gi}.lean" (s ++ "\nend SrcGen\n")
  -- chain module
  let mut c := hdr ((List.range groups.size).map fun g => s!"Nano.V2Self.Proof.Src.Data{g}")
  c := c ++ s!"def F : Nat := {F}\n"
  c := c ++ s!"def T{n} : List Tok := []\ndef X{n-1} : List UInt8 := x{n-1}\ndef W{n-1} : List UInt64 := w{n-1}\ndef Ls{n} : List DefA := []\n"
  for k in [0:n] do
    let i := n - 1 - k
    c := c ++ s!"def T{i} : List Tok := S{i} ++ T{i+1}\ndef Ls{i} : List DefA := d{i} :: Ls{i+1}\n"
    if i + 1 < n then c := c ++ s!"def X{i} : List UInt8 := x{i} ++ X{i+1}\ndef W{i} : List UInt64 := w{i} ++ W{i+1}\n"
  c := c ++ "def D0 : List DefI := []\n"
  for i in [0:n] do c := c ++ s!"def D{i+1} : List DefI := D{i} ++ [di{i}]\n"
  IO.FS.writeFile s!"{out}/Chain.lean" (c ++ "\nend SrcGen\n")
  -- check modules
  for gi in [0:groups.size] do
    let (a, b) := groups[gi]!
    let mut s := hdr ["Nano.V2Self.Proof.Src.Chain"]
    s := s ++ "set_option maxRecDepth 100000\n\n"
    for i in [a:b] do
      s := s ++ s!"theorem lex{i} : lexAll (x{i}.length + 1) x{i} = some w{i} := by decide +kernel\n"
      s := s ++ s!"theorem tok{i} : tokens w{i} = some S{i} := by decide +kernel\n"
      if i + 1 < n then s := s ++ s!"theorem nl{i} : x{i}.getLast? = some 10 := by decide +kernel\n"
      s := s ++ s!"theorem chk{i} : chkDef (pDef F D{i} T{i}) di{i} d{i} T{i+1} = true := by decide +kernel\n"
    IO.FS.writeFile s!"{out}/Chk{gi}.lean" (s ++ "\nend SrcGen\n")
  -- top module
  let mut t := hdr ((List.range groups.size).map fun g => s!"Nano.V2Self.Proof.Src.Chk{g}")
  t := t ++ "set_option maxRecDepth 100000\n\n"
  t := t ++ s!"theorem lx{n-1} : LexSpec.Lexes X{n-1} W{n-1} := lexAll_sound lex{n-1}\n"
  t := t ++ s!"theorem tk{n-1} : tokens W{n-1} = some T{n-1} := by\n  show tokens w{n-1} = some (S{n-1} ++ [])\n  rw [List.append_nil]; exact tok{n-1}\n"
  for k in [1:n] do
    let i := n - 1 - k
    t := t ++ s!"theorem lx{i} : LexSpec.Lexes X{i} W{i} := lexes_app (lexAll_sound lex{i}) lx{i+1} (.inr nl{i})\n"
    t := t ++ s!"theorem tk{i} : tokens W{i} = some T{i} := tokens_app tok{i} tk{i+1}\n"
  t := t ++ s!"theorem ch{n} : ∀ G, pDefs F (G + 1) D{n} T{n} = some (D{n}, Ls{n}) := pDefs_base F D{n}\n"
  for k in [0:n] do
    let i := n - 1 - k
    t := t ++ s!"theorem ch{i} : ∀ G, pDefs F (G + {n - i + 1}) D{i} T{i} = some (D{n}, Ls{i}) :=\n  pDefs_step (chkDef_sound chk{i}) (by intro h; cases h) ch{i+1}\n"
  t := t ++ s!"theorem len{n} : T{n}.length = 0 := rfl\n"
  let mut cum := 0
  for k in [0:n] do
    let i := n - 1 - k
    cum := cum + (rows[i]!.2.2.1).length
    t := t ++ s!"theorem len{i} : T{i}.length = {cum} := by\n  show (S{i} ++ T{i+1}).length = {cum}; rw [List.length_append, len{i+1}]; rfl\n"
  t := t ++ s!"theorem hF : 8 * T0.length + 8 = F := by rw [len0]; rfl\n"
  t := t ++ s!"theorem hK : {n + 1} ≤ T0.length + 1 := by rw [len0]; decide\n"
  t := t ++ s!"theorem hM : (D{n}.getLast?.map isMain) = some true := by decide +kernel\n"
  t := t ++ "/-- **the parse of the text** -/\ntheorem parse : refParse W0 = some Ls0 := refParse_of tk0 hK (hF ▸ ch0) hM\n"
  t := t ++ "/-- **the text lexes and parses to the AST** -/\ntheorem link : LexSpec.Lexes X0 W0 ∧ ParsesProgram W0 Ls0 := ⟨lx0, parse⟩\n"
  IO.FS.writeFile s!"{out}/Top.lean" (t ++ "\nend SrcGen\n")
  IO.println s!"defs {n}, groups {groups.size}, tokens {toks.length}, words {ws.length}"
