                  let msg : String := (String.append " can accept a value between 0 and 1. Value provided is " (dec_str value_name))
                  let _ : Unit := (print_endline (String.append arg msg))
                  sail_assert false "src/map_clauses.sail:65.20-65.21"))
          else
            (do
              if ((arg == "SMCR_EL3.LEN") : Bool)
              then
