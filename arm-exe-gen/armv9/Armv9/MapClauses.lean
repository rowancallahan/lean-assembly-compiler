/-- Type quantifiers: value_name : Int -/
def __SetConfig (arg : String) (value_name : Int) : SailM Unit := do
  if ((arg == "ZCR_EL3.LEN") : Bool)
  then
    (do
      if (((value_name ≥b 0) && ((value_name ≤b (BitVec.toNat 0xF#4)) : Bool)) : Bool)
      then writeReg ZCR_EL3_LEN_VALUE value_name
      else
        (do
          let msg : String := (String.append " can accept a value between 0 and 15. Value provided is " (dec_str value_name))
          let _ : Unit := (print_endline (String.append arg msg))
          sail_assert false "src/map_clauses.sail:47.20-47.21"))
  else
    (do
      if ((arg == "CPTR_EL3.EZ") : Bool)
      then
        (do
          if (((value_name ≥b 0) && ((value_name ≤b (BitVec.toNat 0x1#4)) : Bool)) : Bool)
          then writeReg CPTR_EL3_EZ_VALUE value_name
          else
            (do
              let msg : String := (String.append " can accept a value between 0 and 1. Value provided is " (dec_str value_name))
              let _ : Unit := (print_endline (String.append arg msg))
              sail_assert false "src/map_clauses.sail:56.20-56.21"))
      else
        (do
          if ((arg == "CPTR_EL3.ESM") : Bool)
          then
            (do
              if (((value_name ≥b 0) && ((value_name ≤b (BitVec.toNat 0x1#4)) : Bool)) : Bool)
              then writeReg CPTR_EL3_ESM_VALUE value_name
              else
