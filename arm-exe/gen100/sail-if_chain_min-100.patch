+  let (FCL_aux (FCL_funcl (id, pexp), annot)) = funcl in
+  let _, _, exp, _ = destruct_pexp pexp in
+  let exp = fixup_binders exp in
+  let splittable =
+    (not (Effects.function_is_pure id ctx.global.effect_info))
+    && (not (has_early_return exp))
+    && match meas with Rec_aux (Rec_nonrec, _) -> true | _ -> false
+  in
+  let rec cuts depth (E_aux (e, _) as full) =
+    match e with
+    | E_if (_, _, els) ->
+        let rest = cuts (depth + 1) els in
+        if depth > 0 && depth mod if_chain_split = 0 then full :: rest else rest
+    | E_typ (_, e') | E_block [e'] -> cuts depth e'
+    | _ -> []
+  in
+  let cut_nodes = if splittable then cuts 0 exp else [] in
+  let cut_nodes = if List.length cut_nodes * if_chain_split < if_chain_min then [] else cut_nodes in
+  if cut_nodes = [] then comment ^^ nest 2 (signature ^^ hardline ^^ doc_funcl_body fixup_binders ctx funcl) ^^ termination
+  else (
+    let suffix k = "_tail" ^ string_of_int k in
+    let call k = parens (separate space ((doc_id_ctor ctx id ^^ string (suffix k)) :: List.map (doc_id_ctor ctx) binder_ids)) in
+    let table = List.mapi (fun k n -> (n, call (k + 1))) cut_nodes in
+    let body_ctx = context_with_env ctx (env_of_tannot (snd annot)) in
+    let tail k node =
+      hoisted_tails := List.filter (fun (n, _) -> n != node) table;
+      let _, sig_k, _, _, _ = doc_funcl_init ~suffix:(suffix k) ctx.global funcl in
+      nest 2 (sig_k ^^ hardline ^^ doc_exp true body_ctx node)
+    in
+    let tails = List.rev (List.mapi (fun k n -> tail (k + 1) n) cut_nodes) in
+    hoisted_tails := table;
+    let main = comment ^^ nest 2 (signature ^^ hardline ^^ doc_funcl_body fixup_binders ctx funcl) ^^ termination in
+    hoisted_tails := [];
+    separate (twice hardline) (tails @ [main])
+  )
 
