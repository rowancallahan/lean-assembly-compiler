+(* An if/else chain along the body of a function is cut every [if_chain_split] levels: the rest of
+   the chain becomes an auxiliary definition [f_tailK] with the same parameters, called in tail
+   position.  No binder is crossed along the chain, so the tail only mentions the parameters. *)
+let if_chain_split = 100
+
+(* Only chains at least [if_chain_min] levels deep are cut; shallower ones are emitted unchanged. *)
+let if_chain_min = 100
+
