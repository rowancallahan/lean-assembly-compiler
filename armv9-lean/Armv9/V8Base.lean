def TranslationRegime (el : (BitVec 2)) : SailM Regime := do
  if ((el == EL3) : Bool)
  then
    (do
      if ((← (ELUsingAArch32 EL3)) : Bool)
      then (pure Regime_EL30)
      else (pure Regime_EL3))
  else
    (do
      if ((el == EL2) : Bool)
      then
        (do
          if ((← (ELIsInHost EL2)) : Bool)
          then (pure Regime_EL20)
          else (pure Regime_EL2))
      else
        (do
          if ((el == EL1) : Bool)
          then (pure Regime_EL10)
          else
            (do
              if ((el == EL0) : Bool)
              then
                (do
                  if ((←((pure (BEq.beq (← (CurrentSecurityState ())) SS_Secure)) <&&> (do
                       (ELUsingAArch32 EL3)))) : Bool)
                  then (pure Regime_EL30)
                  else
                    (do
                      if ((← (ELIsInHost EL0)) : Bool)
                      then (pure Regime_EL20)
                      else (pure Regime_EL10)))
              else
                (do
                  (Unreachable ())
                  (undefined_Regime ())))))

def AlignmentEnforced (_ : Unit) : SailM Bool := do
  let regime ← (( do (TranslationRegime (← readReg PSTATE).EL) ) : SailM Regime )
  let A ← (( do (undefined_bitvector 1) ) : SailM (BitVec 1) )
  let A ← (( do
    match regime with
    | .Regime_EL3 => (do (pure (_get_SCTLR_EL3_Type_A (← readReg SCTLR_EL3))))
    | .Regime_EL30 => (do (pure (_get_SCTLR_Type_A (← (SCTLR_read__2 ())))))
    | .Regime_EL2 =>
      (do
        if ((← (ELUsingAArch32 EL2)) : Bool)
        then (pure (_get_HSCTLR_Type_A (← (HSCTLR_read ()))))
        else (pure (_get_SCTLR_EL2_Type_A (← readReg SCTLR_EL2))))
    | .Regime_EL20 => (do (pure (_get_SCTLR_EL2_Type_A (← readReg SCTLR_EL2))))
    | .Regime_EL10 =>
      (do
        if ((← (ELUsingAArch32 EL1)) : Bool)
        then (pure (_get_SCTLR_Type_A (← (SCTLR_read__2 ()))))
        else (pure (_get_SCTLR_EL1_Type_A (← readReg SCTLR_EL1)))) ) : SailM (BitVec 1) )
  (pure (A == 1#1))

