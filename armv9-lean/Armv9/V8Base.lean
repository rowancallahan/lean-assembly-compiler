def ExternalRealmInvasiveDebugEnabled (_ : Unit) : SailM Bool := do
  if ((! (← (HaveRME ()))) : Bool)
  then (pure false)
  else (ExternalInvasiveDebugEnabled ()) <&&> (do (pure (BEq.beq (← readReg RLPIDEN) Signal_High)))

def ExternalRootInvasiveDebugEnabled (_ : Unit) : SailM Bool := do
  if ((! (← (HaveRME ()))) : Bool)
  then (pure false)
  else (ExternalInvasiveDebugEnabled ()) <&&> (do (pure (! (← (HaveSecureEL2Ext ())))) <||> (do (ExternalSecureInvasiveDebugEnabled ()))) <&&> (do (ExternalRealmInvasiveDebugEnabled ())) <&&> (do (pure (BEq.beq (← readReg RTPIDEN) Signal_High)))

def HaveBRBEv1p1 (_ : Unit) : SailM Bool := do
  (IsFeatureImplemented FEAT_BRBEv1p1)

def BranchRecordAllowed (el : (BitVec 2)) : SailM Bool := do
  if ((← (ELUsingAArch32 el)) : Bool)
  then (pure false)
  else
    (do
      if (((_get_BRBFCR_EL1_Type_PAUSED (← readReg BRBFCR_EL1)) == 1#1) : Bool)
      then (pure false)
      else
        (do
          if ((←((pure (el == EL3)) <&&> (do
               (HaveBRBEv1p1 ())))) : Bool)
          then (pure ((_get_MDCR_EL3_Type_E3BREC (← readReg MDCR_EL3)) != (_get_MDCR_EL3_Type_E3BREW (← readReg MDCR_EL3))))
          else
            (do
              if ((←((pure (HaveEL EL3)) <&&> (do
                   (pure ((_get_MDCR_EL3_Type_SBRBE (← readReg MDCR_EL3)) == 0b00#2)) <||> (do
                     (pure (BEq.beq (← (CurrentSecurityState ())) SS_Secure)) <&&> (do
                       (pure ((_get_MDCR_EL3_Type_SBRBE (← readReg MDCR_EL3)) == 0b01#2))))))) : Bool)
              then (pure false)
              else
