def CheckExceptionCatch (exception_entry : Bool) : SailM Unit := do
  let ctrl ← (( do (undefined_bitvector 2) ) : SailM (BitVec 2) )
  let exception_exit ← (( do (undefined_bool ()) ) : SailM Bool )
  let increment_name ← (( do (undefined_int ()) ) : SailM Int )
  let ss ← (( do (SecurityStateAtEL (← readReg PSTATE).EL) ) : SailM SecurityState )
  let base : Nat := 0
  let base : Int :=
    match ss with
    | .SS_Secure => 0
    | .SS_NonSecure => 4
    | .SS_Realm => 16
    | .SS_Root => 0
  let base := base
  if ((← (HaltingAllowed ())) : Bool)
  then
    (do
      let halt ← (( do (undefined_bool ()) ) : SailM Bool )
      let halt ← (( do
        if ((← (HaveExtendedECDebugEvents ())) : Bool)
        then
          (do
            let exception_exit : Bool := (! exception_entry)
            let increment_name :=
              if ((BEq.beq ss SS_Realm) : Bool)
              then 4
              else 8
            let ctrl ← (( do (pure ((BitVec.join1 [(BitVec.access (← (EDECCR_read ())) (((BitVec.toNat (← readReg PSTATE).EL) +i base) +i increment_name))]) +++ (BitVec.join1 [(BitVec.access (← (EDECCR_read ())) ((BitVec.toNat (← readReg PSTATE).EL) +i base))]))) ) : SailM (BitVec 2) )
            match (ctrl : BitVec 2) with
            | 0b00 => (pure false)
            | 0b01 => (pure true)
            | 0b10 => (pure (exception_exit == true))
            | _ => (pure (exception_entry == true)))
        else (do (pure ((BitVec.join1 [(BitVec.access (← (EDECCR_read ())) ((BitVec.toNat (← readReg PSTATE).EL) +i base))]) == 1#1))) ) : SailM Bool )
      if (halt : Bool)
      then
        (do
          if (((← (Havev8p8Debug ())) && exception_entry) : Bool)
          then writeReg EDESR (Sail.BitVec.updateSubrange (← readReg EDESR) 3 3 1#1)
          else (Halt DebugHalt_ExceptionCatch))
      else (pure ()))
  else (pure ())

