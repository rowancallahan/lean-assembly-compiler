def ImpDefBool (x : String) : SailM Bool := do
  if ((x == "the PE resets into EL2 or EL3") : Bool)
  then (pure ((EL2 == (HighestEL ())) || (EL3 == (HighestEL ()))))
  else
    (do
      if ((x == "the PE resets into EL1") : Bool)
      then (pure (EL1 == (HighestEL ())))
      else
        (do
          if ((x == "the PE resets into EL2") : Bool)
          then (pure (EL2 == (HighestEL ())))
          else
            (do
              if ((x == "the PE resets into EL3") : Bool)
              then (pure (EL3 == (HighestEL ())))
              else
                (do
                  if ((x == "IMPLEMENTED_ITD") : Bool)
