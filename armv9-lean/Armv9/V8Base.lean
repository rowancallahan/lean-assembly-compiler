def AltPARTIDspace (el : (BitVec 2)) (security : SecurityState) (primaryPIdSpace : PARTIDspaceType) : SailM PARTIDspaceType := do
  match security with
  | .SS_NonSecure =>
    (do
      sail_assert (el != EL3) "src/v8_base.sail:11334.26-11334.27"
      (pure primaryPIdSpace))
  | .SS_Secure =>
    (do
      sail_assert (el != EL3) "src/v8_base.sail:11338.26-11338.27"
      if ((BEq.beq primaryPIdSpace PIdSpace_NonSecure) : Bool)
      then (pure primaryPIdSpace)
      else (AltPIdSecure el primaryPIdSpace))
  | .SS_Root =>
    (do
      sail_assert (el == EL3) "src/v8_base.sail:11345.26-11345.27"
      if (((_get_MPAM3_EL3_Type_ALTSP_EL3 (← (MPAM3_EL3_read ()))) == 1#1) : Bool)
      then
        (do
          if (((_get_MPAM3_EL3_Type_RT_ALTSP_NS (← (MPAM3_EL3_read ()))) == 1#1) : Bool)
          then (pure PIdSpace_NonSecure)
          else (pure PIdSpace_Secure))
      else (pure primaryPIdSpace))
  | .SS_Realm =>
    (do
      sail_assert (el != EL3) "src/v8_base.sail:11357.26-11357.27"
      (AltPIdRealm el primaryPIdSpace))

