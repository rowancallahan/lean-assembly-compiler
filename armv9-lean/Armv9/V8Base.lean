/-- Type quantifiers: n : Int -/
def PMUCounterIsHyp (n : Int) : SailM Bool := do
  if ((n == INSTRUCTION_COUNTER_ID) : Bool)
  then (pure false)
  else
    (do
      if ((n == CYCLE_COUNTER_ID) : Bool)
      then (pure false)
      else
        (do
          let resvd_for_el2 ← (( do (undefined_bool ()) ) : SailM Bool )
          if ((HaveEL EL2) : Bool)
          then
            (do
              let hpmn_bits ← (( do
                if ((← (HaveAArch64 ())) : Bool)
                then (pure (_get_MDCR_EL2_Type_HPMN (← readReg MDCR_EL2)))
                else (pure (_get_HDCR_Type_HPMN (← (HDCR_read ())))) ) : SailM (BitVec 5) )
              let resvd_for_el2 : Bool := (n ≥b (BitVec.toNat hpmn_bits))
              if ((←((pure ((BitVec.toNat hpmn_bits) >b (← (GetNumEventCounters ())))) <||> (do
                   (pure ((! (← (HaveFeatHPMN0 ()))) && (IsZero hpmn_bits)))))) : Bool)
              then (do (ConstrainUnpredictableBool Unpredictable_CounterReservedForEL2))
              else (pure resvd_for_el2))
          else (pure false)))

/-- Type quantifiers: k_check_cnten : Bool, k_check_e : Bool, k_check_inten : Bool, k_exclude_cyc : Bool, k_exclude_sync : Bool, k_include_hi_name : Bool, k_include_lo_name : Bool -/
def PMUOverflowCondition (check_e : Bool) (check_cnten : Bool) (check_inten : Bool) (include_hi_name : Bool) (include_lo_name : Bool) (exclude_cyc : Bool) (exclude_sync : Bool) : SailM Bool := do
  let counters ← do (GetNumEventCounters ())
  let ovsf ← (( do (undefined_bitvector 64) ) : SailM (BitVec 64) )
  let ovsf ← (( do
    if ((← (HaveAArch64 ())) : Bool)
    then
      (do
        let ovsf ← readReg PMOVSCLR_EL0
        let ovsf : (BitVec 64) := (Sail.BitVec.updateSubrange ovsf 63 33 (Zeros (n := 31)))
        if ((! (← (HavePMUv3ICNTR ()))) : Bool)
        then (pure (BitVec.update ovsf INSTRUCTION_COUNTER_ID (Bit 0#1)))
        else (pure ovsf))
    else (do (pure (Sail.BitVec.zeroExtend (← (PMOVSR_read ())) 64))) ) : SailM (BitVec 64) )
  let ovsf ← (( do
    if ((counters <b 31) : Bool)
    then
      (do
        sail_assert ((0 ≤b counters) && (counters ≤b 30)) "src/v8_base.sail:4603.61-4603.62"
        (pure (Sail.BitVec.updateSubrange ovsf 30 counters (Zeros (n := (31 -i counters))))))
    else (pure ovsf) ) : SailM (BitVec 64) )
  let ovsf ← (( do
    let loop_idx_lower := 0
    let loop_idx_upper := (counters -i 1)
    let mut loop_vars := ovsf
    for idx in [loop_idx_lower:loop_idx_upper:1]i do
      let ovsf := loop_vars
      loop_vars ← do
        let E ← (( do (undefined_bitvector 1) ) : SailM (BitVec 1) )
        let is_hyp ← (( do (PMUCounterIsHyp idx) ) : SailM Bool )
        let E ← (( do
          if ((← (HaveAArch64 ())) : Bool)
          then
            (do
              if (is_hyp : Bool)
              then (pure (_get_MDCR_EL2_Type_HPME (← readReg MDCR_EL2)))
              else (pure (_get_PMCR_EL0_Type_E (← readReg PMCR_EL0))))
          else
            (do
              if (is_hyp : Bool)
              then (pure (_get_HDCR_Type_HPME (← (HDCR_read ()))))
              else (pure (_get_PMCR_Type_E (← (PMCR_read ()))))) ) : SailM (BitVec 1) )
        let ovsf ← (( do
          if (check_e : Bool)
          then
            (do
              sail_assert ((0 ≤b idx) && (idx <b 64)) "src/v8_base.sail:4615.64-4615.65"
              (pure (BitVec.update ovsf idx (Bit ((BitVec.join1 [(BitVec.access ovsf idx)]) &&& E)))))
          else (pure ovsf) ) : SailM (BitVec 64) )
        if ((((! is_hyp) && (! include_lo_name)) || (is_hyp && (! include_hi_name))) : Bool)
        then
          (do
            sail_assert ((0 ≤b idx) && (idx <b 64)) "src/v8_base.sail:4619.64-4619.65"
            (pure (BitVec.update ovsf idx (Bit 0#1))))
        else (pure ovsf)
    (pure loop_vars) ) : SailM (BitVec 64) )
  let ovsf : (BitVec 64) :=
    if ((exclude_cyc || (! include_lo_name)) : Bool)
    then (BitVec.update ovsf CYCLE_COUNTER_ID (Bit 0#1))
    else ovsf
  let ovsf ← (( do
    if (check_e : Bool)
    then (do (pure (BitVec.update ovsf CYCLE_COUNTER_ID (Bit ((BitVec.join1 [(BitVec.access ovsf CYCLE_COUNTER_ID)]) &&& (_get_PMCR_EL0_Type_E (← readReg PMCR_EL0)))))))
    else (pure ovsf) ) : SailM (BitVec 64) )
  let ovsf ← (( do
    if ((←((HaveAArch64 ()) <&&> (do
         (HavePMUv3ICNTR ())))) : Bool)
    then
      (do
        let ovsf : (BitVec 64) :=
          if ((! include_lo_name) : Bool)
          then (BitVec.update ovsf INSTRUCTION_COUNTER_ID (Bit 0#1))
          else ovsf
        if (check_e : Bool)
        then (do (pure (BitVec.update ovsf INSTRUCTION_COUNTER_ID (Bit ((BitVec.join1 [(BitVec.access ovsf INSTRUCTION_COUNTER_ID)]) &&& (_get_PMCR_EL0_Type_E (← readReg PMCR_EL0)))))))
        else (pure ovsf))
    else (pure ovsf) ) : SailM (BitVec 64) )
  let ovsf ← (( do
    if (check_cnten : Bool)
    then
      (do
        let cnten ← (( do
          if ((← (HaveAArch64 ())) : Bool)
          then readReg PMCNTENCLR_EL0
          else (pure (Sail.BitVec.zeroExtend (← (PMCNTENCLR_read ())) 64)) ) : SailM (BitVec 64) )
        (pure (ovsf &&& cnten)))
    else (pure ovsf) ) : SailM (BitVec 64) )
  let ovsf ← (( do
