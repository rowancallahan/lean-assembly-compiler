          else (pure PIdSpace)))
  else
    (do
      if ((questionMark == EL1) : Bool)
      then
        (do
          if ((! (← (UsePrimarySpaceEL10 ()))) : Bool)
          then (pure PIdSpace_NonSecure)
          else (pure PIdSpace))
      else
        (do
          if ((questionMark == EL2) : Bool)
          then
            (do
              if ((! (← (UsePrimarySpaceEL2 ()))) : Bool)
              then (pure PIdSpace_NonSecure)
              else (pure PIdSpace))
