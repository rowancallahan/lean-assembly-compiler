def getNumBreakpoints (_ : Unit) : SailM Int := do
  (__UNKNOWN_integer ())

def getNumCtxBreakpoints (_ : Unit) : SailM Int := do
  (__UNKNOWN_integer ())

def getNumWatchpoints (_ : Unit) : SailM Int := do
  (__UNKNOWN_integer ())

def ImpDefInt (x : String) : SailM Int := do
  if ((x == "Number of breakpoints") : Bool)
  then (getNumBreakpoints ())
  else
    (do
      if ((x == "Number of watchpoints") : Bool)
      then (getNumWatchpoints ())
      else
        (do
          if ((x == "Number of event counters") : Bool)
          then readReg NUM_PMU_COUNTERS
          else
            (do
              if ((x == "Number of context-aware breakpoints") : Bool)
              then (getNumCtxBreakpoints ())
              else
                (do
                  if ((x == "Max implemented VL") : Bool)
                  then readReg __max_implemented_sveveclen
                  else
                    (do
                      if ((x == "Maximum bytes used in a single block of a copy") : Bool)
                      then (pure 1)
                      else
                        (do
                          if ((x == "Number of BRB records") : Bool)
                          then readReg NUM_BRBE_RECORDS
                          else
                            (do
                              if ((x == "SPE Events packet payload size") : Bool)
                              then (pure 4)
                              else
                                (do
                                  if ((x == "SPE Data Source packet payload size") : Bool)
                                  then (pure 2)
                                  else
                                    (do
                                      if ((x == "Reserved Intermediate Physical Address size value") : Bool)
                                      then (pure 52)
                                      else
                                        (do
                                          if ((x == "Maximum Physical Address Size") : Bool)
                                          then readReg __supported_pa_size
                                          else
                                            (do
                                              if ((x == "Block BBM support level") : Bool)
                                              then readReg __block_bbm_implemented
                                              else
                                                (do
                                                  if ((x == "SVE Extended BFloat16 instructions are implemented") : Bool)
                                                  then readReg __has_sve_extended_bf16
                                                  else
                                                    (do
                                                      if ((x == "Max implemented SVL") : Bool)
                                                      then readReg __max_implemented_smeveclen
                                                      else
                                                        (do
                                                          if ((x == "Data Cache Invalidate Watchpoint Size") : Bool)
                                                          then (pure (4 *i (2 ^i (BitVec.toNat (_get_CTR_EL0_Type_DminLine (← readReg CTR_EL0))))))
                                                          else
                                                            (do
                                                              if ((x == "Instruction Cache Invalidate by VA Size") : Bool)
                                                              then (pure (4 *i (2 ^i (BitVec.toNat (_get_CTR_EL0_Type_DminLine (← readReg CTR_EL0))))))
                                                              else
                                                                (do
                                                                  if ((x == "Linesize for DC SW instructions") : Bool)
                                                                  then (pure (4 *i (2 ^i (BitVec.toNat (_get_CTR_EL0_Type_DminLine (← readReg CTR_EL0))))))
                                                                  else
                                                                    (do
                                                                      if ((x == "Associativity for DC SW instructions") : Bool)
                                                                      then (pure 2)
                                                                      else
                                                                        (do
                                                                          if ((x == "Numsets for DC SW instructions") : Bool)
                                                                          then (pure 2)
                                                                          else
                                                                            (do
                                                                              let _ : Unit := (print_endline (String.append x " is an unrecognized Implementation defined bit."))
                                                                              sail_assert false "src/impdefs.sail:746.20-746.21"
                                                                              throw Error.Exit)))))))))))))))))))

def __IMPDEF_integer (x : String) : SailM Int := do
  (ImpDefInt x)

def GetNumEventCounters (_ : Unit) : SailM Int := do
  (__IMPDEF_integer "Number of event counters")

def SecureOnlyImplementation (_ : Unit) : SailM Bool := do
  (__IMPDEF_boolean "Secure-only implementation")

def IsSecureEL2Enabled (_ : Unit) : SailM Bool := do
  if ((←((pure (HaveEL EL2)) <&&> (do
       (HaveSecureEL2Ext ())))) : Bool)
  then
    (do
      if ((HaveEL EL3) : Bool)
      then
        (do
          if ((←((pure (! (← (ELUsingAArch32 EL3)))) <&&> (do
               (pure ((_get_SCR_EL3_Type_EEL2 (← readReg SCR_EL3)) == 1#1))))) : Bool)
          then (pure true)
          else (pure false))
      else (SecureOnlyImplementation ()))
  else (pure false)

def EL2Enabled (_ : Unit) : SailM Bool := do
  (pure (HaveEL EL2)) <&&> (do
    (pure (! (HaveEL EL3))) <||> (do
      (pure ((_get_SCRType_NS (← (SCR_GEN_read ()))) == 1#1))) <||> (do
      (IsSecureEL2Enabled ())))

