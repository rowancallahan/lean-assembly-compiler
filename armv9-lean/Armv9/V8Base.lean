def DFSR_NS_write (value_name : (BitVec 32)) : SailM Unit := do
  let r : DFSR_Type := value_name
  writeReg ESR_EL1 (Sail.BitVec.updateSubrange (← readReg ESR_EL1) 31 0 (BitVec.slice r 0 32))
  writeReg _DFSR_NS r

def DFSR_write (value_name : (BitVec 32)) : SailM Unit := do
  let r : DFSR_Type := value_name
  if ((←((ELUsingAArch32 EL3) <&&> (do
       (pure (BEq.beq (← (CurrentSecurityState ())) SS_Secure))))) : Bool)
  then writeReg DFSR_S r
  else (DFSR_NS_write r)

