def EffectiveSCR_EL3_RW (_ : Unit) : SailM (BitVec 1) := SailME.run do
  if ((! (← (HaveAArch64 ()))) : Bool)
  then (pure 0#1)
  else
    (do
      if (((! (HaveAArch32EL EL2)) && (! (HaveAArch32EL EL1))) : Bool)
      then (pure 1#1)
      else
        (do
          if ((HaveAArch32EL EL1) : Bool)
          then
            (do
              if ((←((pure (! (HaveAArch32EL EL2))) <&&> (do
                   (pure ((_get_SCR_EL3_Type_NS (← readReg SCR_EL3)) == 1#1))))) : Bool)
              then SailME.throw (1#1 : (BitVec 1))
              else
                (do
                  if ((←((HaveSecureEL2Ext ()) <&&> (do
                       (pure ((_get_SCR_EL3_Type_EEL2 (← readReg SCR_EL3)) == 1#1))) <&&> (do
                       (pure ((_get_SCR_EL3_Type_NS (← readReg SCR_EL3)) == 0#1))))) : Bool)
                  then SailME.throw (1#1 : (BitVec 1))
                  else (pure ())))
          else (pure ())
          (pure (_get_SCR_EL3_Type_RW (← readReg SCR_EL3)))))

def PhysicalOffsetIsValid (_ : Unit) : SailM Bool := do
  if ((! (← (HaveAArch64 ()))) : Bool)
  then (pure false)
  else
    (do
      if ((←((pure (! (HaveEL EL2))) <||> (do
           (pure (! (← (HaveECVExt ()))))))) : Bool)
      then (pure false)
      else
        (do
          if ((←((pure (HaveEL EL3)) <&&> (do
               (pure ((_get_SCR_EL3_Type_NS (← readReg SCR_EL3)) == 1#1))) <&&> (do
               (pure ((← (EffectiveSCR_EL3_RW ())) == 0#1))))) : Bool)
          then (pure false)
          else
            (do
              if ((←((pure (HaveEL EL3)) <&&> (do
                   (pure ((_get_SCR_EL3_Type_ECVEn (← readReg SCR_EL3)) == 0#1))))) : Bool)
              then (pure false)
              else
                (do
                  if (((_get_CNTHCTL_EL2_Type_ECV (← readReg CNTHCTL_EL2)) == 0#1) : Bool)
                  then (pure false)
                  else (pure true)))))

/-- Type quantifiers: N : Nat, N ≥ 0 -/
def ImpDefBits (x : String) (N : Nat) : SailM (BitVec N) := do
  if ((x == "Coresight timestamp") : Bool)
  then
    (do
      sail_assert ((0 ≤b (N -i 1)) && ((N -i 1) <b 64)) "src/impdefs.sail:759.54-759.55"
      (pure (Sail.BitVec.extractLsb (← (PhysicalCountInt ())) (N -i 1) 0)))
  else
    (do
      if ((x == "Synchronous Error") : Bool)
      then
        (do
          sail_assert ((0 ≤b (N -i 1)) && ((N -i 1) <b 2)) "src/impdefs.sail:762.53-762.54"
          (pure (Sail.BitVec.extractLsb 0b00#2 (N -i 1) 0)))
      else
        (do
          if ((x == "Asynchronous Error") : Bool)
          then
            (do
              sail_assert ((0 ≤b (N -i 1)) && ((N -i 1) <b 2)) "src/impdefs.sail:765.53-765.54"
              (pure (Sail.BitVec.extractLsb 0b11#2 (N -i 1) 0)))
          else
            (do
              if ((x == "Virtual Asynchronous Abort ExT bit") : Bool)
              then (pure (Zeros (n := N)))
              else
                (do
                  if ((x == "FPEXC.EN value when TGE==1 and RW==0") : Bool)
                  then
                    (do
                      sail_assert (0 ≤b (N -i 1)) "src/impdefs.sail:770.38-770.39"
                      (pure (integer_subrange 1 (N -i 1) 0)))
                  else
                    (do
                      if ((x == "reset vector address") : Bool)
                      then
                        (do
                          sail_assert ((0 ≤b (N -i 1)) && ((N -i 1) <b 64)) "src/impdefs.sail:773.54-773.55"
                          (pure (Sail.BitVec.extractLsb (← readReg CFG_RVBAR) (N -i 1) 0)))
                      else
                        (do
                          if ((x == "TG0 encoded granule size") : Bool)
                          then
                            (do
                              sail_assert ((0 ≤b (N -i 1)) && ((N -i 1) <b 2)) "src/impdefs.sail:776.53-776.54"
                              (pure (Sail.BitVec.extractLsb (← readReg __impdef_TG0) (N -i 1) 0)))
                          else
                            (do
                              if ((x == "TG1 encoded granule size") : Bool)
                              then
                                (do
                                  sail_assert ((0 ≤b (N -i 1)) && ((N -i 1) <b 2)) "src/impdefs.sail:779.53-779.54"
                                  (pure (Sail.BitVec.extractLsb (← readReg __impdef_TG1) (N -i 1) 0)))
                              else
                                (do
                                  if ((x == "Reserved short descriptor AP encoding") : Bool)
                                  then
                                    (do
                                      sail_assert (0 ≤b (N -i 1)) "src/impdefs.sail:782.38-782.39"
                                      (pure (integer_subrange (BitVec.toNat 0b101#3) (N -i 1) 0)))
                                  else
                                    (do
                                      if ((x == "Non-Faulting PAR") : Bool)
                                      then
                                        (do
                                          sail_assert ((0 ≤b (N -i 1)) && ((N -i 1) <b 1)) "src/impdefs.sail:785.53-785.54"
                                          (pure (Sail.BitVec.extractLsb 0#1 (N -i 1) 0)))
                                      else
                                        (do
                                          if ((x == "Faulting PAR") : Bool)
                                          then (pure (Zeros (n := N)))
                                          else
                                            (do
                                              if ((x == "SPE mask 10:8,4,2") : Bool)
                                              then
                                                (do
