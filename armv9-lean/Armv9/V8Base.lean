def __IMPDEF_bits (N : Nat) (x : String) : SailM (BitVec N) := do
  (ImpDefBits x N)

def GetTimestamp (timeStampType : TimeStamp) : SailM (BitVec 64) := do
  match timeStampType with
  | .TimeStamp_Physical => (PhysicalCountInt ())
  | .TimeStamp_Virtual => (pure ((← (PhysicalCountInt ())) - (← readReg CNTVOFF_EL2)))
  | .TimeStamp_OffsetPhysical =>
    (do
      let physoff ← (( do
        if ((← (PhysicalOffsetIsValid ())) : Bool)
        then readReg CNTPOFF_EL2
        else (pure (Zeros (n := 64))) ) : SailM (BitVec 64) )
      (pure ((← (PhysicalCountInt ())) - physoff)))
  | .TimeStamp_None => (pure (Zeros (n := 64)))
  | .TimeStamp_CoreSight => (__IMPDEF_bits 64 "CoreSight timestamp")

def BRBEFreeze (_ : Unit) : SailM Unit := do
  writeReg BRBFCR_EL1 (Sail.BitVec.updateSubrange (← readReg BRBFCR_EL1) 7 7 1#1)
  writeReg BRBTS_EL1 (Mk_BRBTS_EL1_Type (← (GetTimestamp (← (BRBETimeStamp ())))))

