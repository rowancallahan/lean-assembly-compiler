def SecurityStateAtEL (EL : (BitVec 2)) : SailM SecurityState := SailME.run do
  let effective_nse_ns ← (( do (undefined_bitvector 2) ) : SailME SecurityState (BitVec 2) )
  if ((← (HaveRME ())) : Bool)
  then
    (do
      if ((EL == EL3) : Bool)
      then SailME.throw (SS_Root : SecurityState)
      else
        (do
          let effective_nse_ns ← (( do (pure ((_get_SCR_EL3_Type_NSE (← readReg SCR_EL3)) +++ (← (EffectiveSCR_EL3_NS ())))) ) : SailME SecurityState (BitVec 2) )
          match (effective_nse_ns : BitVec 2) with
          | 0b00 =>
            (do
              if ((← (HaveSecureEL2Ext ())) : Bool)
              then SailME.throw (SS_Secure : SecurityState)
              else (Unreachable ()))
          | 0b01 => SailME.throw (SS_NonSecure : SecurityState)
          | 0b11 => SailME.throw (SS_Realm : SecurityState)
          | _ => (Unreachable ())))
  else (pure ())
  if ((! (HaveEL EL3)) : Bool)
  then
    (do
      if ((← (SecureOnlyImplementation ())) : Bool)
      then (pure SS_Secure)
      else (pure SS_NonSecure))
  else
    (do
      if ((EL == EL3) : Bool)
      then (pure SS_Secure)
      else
        (do
          sail_assert (←((pure (EL != EL2)) <||> (do
            (EL2Enabled ())))) "src/v8_base.sail:4136.39-4136.40"
          if ((! (← (ELUsingAArch32 EL3))) : Bool)
          then
            (do
              if (((_get_SCR_EL3_Type_NS (← readReg SCR_EL3)) == 1#1) : Bool)
              then (pure SS_NonSecure)
              else (pure SS_Secure))
          else
            (do
              if (((_get_SCR_Type_NS (← readReg SCR)) == 1#1) : Bool)
              then (pure SS_NonSecure)
              else (pure SS_Secure))))

