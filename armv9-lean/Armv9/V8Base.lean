  then (AArch32_S1DisabledOutput fault regime va aligned accdesc)
  else
    (do
      let walkparams ← (( do (AArch32_GetS1TTWParams regime va) ) : SailM S1TTWParams )
      if ((← (AArch32_VAIsOutOfRange regime walkparams va)) : Bool)
      then
        (do
          let fault : FaultRecord := { fault with level := 1 }
          let fault : FaultRecord := { fault with statuscode := Fault_Translation }
          (pure (fault, (← (__UNKNOWN_AddressDescriptor ())))))
      else
        (do
          let walkstate ← (( do (undefined_TTWState ()) ) : SailM TTWState )
          let (fault, walkstate) ← (( do
            let (tup__0, tup__1) ← do (AArch32_S1WalkLD fault regime walkparams accdesc va)
            let fault : FaultRecord := tup__0
            let walkstate : TTWState := tup__1
            (pure (fault, walkstate)) ) : SailM (FaultRecord × TTWState) )
          if ((bne fault.statuscode Fault_None) : Bool)
          then (pure (fault, (← (__UNKNOWN_AddressDescriptor ()))))
          else
            (do
              (SetInGuardedPage false)
              let fault ← (( do
                if ((AArch32_S1HasAlignmentFault accdesc aligned walkparams.ntlsmd walkstate.memattrs) : Bool)
                then (pure { fault with statuscode := Fault_Alignment })
                else
                  (do
                    if ((← (AArch32_S1LDHasPermissionsFault regime walkparams walkstate.permissions walkstate.memattrs.memtype walkstate.baseaddress.paspace accdesc)) : Bool)
                    then (pure { fault with statuscode := Fault_Permission })
                    else (pure fault)) ) : SailM FaultRecord )
              if ((bne fault.statuscode Fault_None) : Bool)
              then (pure (fault, (← (__UNKNOWN_AddressDescriptor ()))))
              else
                (do
                  let memattrs ← (( do (undefined_MemoryAttributes ()) ) : SailM MemoryAttributes )
                  let memattrs ← (( do
                    if ((←((pure (BEq.beq accdesc.acctype AccessType_IFETCH)) <&&> (do
                         (pure (BEq.beq walkstate.memattrs.memtype MemType_Device)) <||> (do
                           (pure (! (← (AArch32_S1ICacheEnabled regime)))))) <||> (do
                         (pure ((bne accdesc.acctype AccessType_IFETCH) && (BEq.beq walkstate.memattrs.memtype MemType_Normal))) <&&> (do
                           (pure (! (← (AArch32_S1DCacheEnabled regime)))))))) : Bool)
                    then
                      (do
                        let memattrs ← (NormalNCMemAttr ())
                        (pure { memattrs with xs := walkstate.memattrs.xs }))
                    else (pure walkstate.memattrs) ) : SailM MemoryAttributes )
                  let memattrs ← (( do
                    if ((←((pure (BEq.beq regime Regime_EL10)) <&&> (do
                         (AArch32_EL2Enabled accdesc.ss)) <&&> (do
                         (pure ((← (do
                               if ((← (ELStateUsingAArch32 EL2 (BEq.beq accdesc.ss SS_Secure))) : Bool)
                               then (pure (_get_HCR_Type_VM (← (HCR_read ()))))
                               else (pure (_get_HCR_EL2_Type_VM (← readReg HCR_EL2))))) == 1#1))) <&&> (do
                         (pure (! (← (__IMPDEF_boolean "Apply effective shareability at stage 1"))))))) : Bool)
                    then (pure { memattrs with shareability := walkstate.memattrs.shareability })
                    else (pure { memattrs with shareability := (EffectiveShareability memattrs) }) ) : SailM MemoryAttributes )
                  let oa ← (( do (StageOA (Sail.BitVec.zeroExtend va 64) walkparams.d128 walkparams.tgx walkstate) ) : SailM FullAddress )
                  let ipa ← (( do (CreateAddressDescriptor (Sail.BitVec.zeroExtend va 64) oa memattrs) ) : SailM AddressDescriptor )
                  (pure (fault, ipa))))))

