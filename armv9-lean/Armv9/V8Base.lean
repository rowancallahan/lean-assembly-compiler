              else (pure PIdSpace)))
      else
        (do
          if ((←((pure ((_get_MPAM3_EL3_Type_ALTSP_HEN (← (MPAM3_EL3_read ()))) == 0#1)) <&&> (do
               (pure ((_get_MPAM3_EL3_Type_ALTSP_HFC (← (MPAM3_EL3_read ()))) == 1#1))))) : Bool)
          then (pure PIdSpace_NonSecure)
          else (pure PIdSpace)))
  else
    (do
      if ((questionMark == EL1) : Bool)
      then
        (do
          if (el2en : Bool)
          then
            (do
              if ((! (← (UsePrimarySpaceEL10 ()))) : Bool)
              then (pure PIdSpace_NonSecure)
              else (pure PIdSpace))
          else
            (do
              if ((←((pure ((_get_MPAM3_EL3_Type_ALTSP_HEN (← (MPAM3_EL3_read ()))) == 0#1)) <&&> (do
                   (pure ((_get_MPAM3_EL3_Type_ALTSP_HFC (← (MPAM3_EL3_read ()))) == 1#1))))) : Bool)
