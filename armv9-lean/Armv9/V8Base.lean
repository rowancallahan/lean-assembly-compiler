          (do
            let InSM ← (HaveSME ()) <&&> (do (pure ((← readReg PSTATE).SM == 1#1))) <&&> (do (__IMPDEF_boolean "Shared SMCU") <||> (do (__IMPDEF_boolean "MPAMSM_EL1 label precedence")))
            (pure (InD, InSM)))
        | _ =>
          (let InD : Bool := false
          (pure (InD, InSM))) ) : SailME MPAMinfo (Bool × Bool) )
      if ((! validEL_name) : Bool)
      then (DefaultMPAMinfo pspace)
      else
        (do
          let pspace ← (( do
            if ((←((HaveRME ()) <&&> (do
                 (pure ((_get_MPAMIDR_EL1_Type_HAS_ALTSP (← readReg MPAMIDR_EL1)) == 1#1))))) : Bool)
            then (do (AltPARTIDspace mpamEL security pspace))
            else (pure pspace) ) : SailME MPAMinfo PARTIDspaceType )
          let pspace ← (( do
            if ((←((HaveMPAMv0p1Ext ()) <&&> (do
                 (pure ((_get_MPAMIDR_EL1_Type_HAS_FORCE_NS (← readReg MPAMIDR_EL1)) == 1#1))))) : Bool)
            then
              (do
                if ((((_get_MPAM3_EL3_Type_FORCE_NS (← (MPAM3_EL3_read ()))) == 1#1) && (BEq.beq security SS_Secure)) : Bool)
                then (pure PIdSpace_NonSecure)
                else (pure pspace))
            else (pure pspace) ) : SailME MPAMinfo PARTIDspaceType )
          if ((←((HaveMPAMv0p1Ext ()) <||> (do
               (HaveMPAMv1p1Ext ())) <&&> (do
               (pure ((_get_MPAMIDR_EL1_Type_HAS_SDEFLT (← readReg MPAMIDR_EL1)) == 1#1))))) : Bool)
          then
            (do
              if ((((_get_MPAM3_EL3_Type_SDEFLT (← (MPAM3_EL3_read ()))) == 1#1) && (BEq.beq security SS_Secure)) : Bool)
              then SailME.throw (← (do (DefaultMPAMinfo pspace)))
              else (pure ()))
          else (pure ())
          if ((! (← (MPAMisEnabled ()))) : Bool)
          then (DefaultMPAMinfo pspace)
          else (genMPAM mpamEL InD InSM pspace)))

