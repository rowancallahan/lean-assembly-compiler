/-- Type quantifiers: vpartid : Int -/
def mapvpmw (vpartid : Int) : SailM (BitVec 16) := do
  let vpmw ← (( do (undefined_bitvector 64) ) : SailM (BitVec 64) )
  let wd := (fdiv_int vpartid 4)
  let vpmw ← (( do
    match wd with
    | 0 => (do readReg MPAMVPM0_EL2)
    | 1 => (do readReg MPAMVPM1_EL2)
    | 2 => (do readReg MPAMVPM2_EL2)
    | 3 => (do readReg MPAMVPM3_EL2)
    | 4 => (do readReg MPAMVPM4_EL2)
    | 5 => (do readReg MPAMVPM5_EL2)
    | 6 => (do readReg MPAMVPM6_EL2)
    | 7 => (do readReg MPAMVPM7_EL2)
    | _ => (pure (Zeros (n := 64))) ) : SailM (BitVec 64) )
  let vpmw := vpmw
  let vpme_lsb := ((fmod_int vpartid 4) *i 16)
  (pure (BitVec.slice vpmw vpme_lsb 16))

def MAP_vPARTID (vpartid : (BitVec 16)) : SailM ((BitVec 16) × Bool) := do
